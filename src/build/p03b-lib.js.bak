/* ===== Thư viện mục tiêu: 8 lĩnh vực, tiêu đề và mục tiêu cụ thể (chuẩn hóa từ dữ liệu của Trung tâm) ===== */
const LDOM=[{"id":"nh","n":"Ngôn ngữ hiểu","s":"Hiểu","d":"Bé hiểu lời nói và làm theo chỉ dẫn"},{"id":"nd","n":"Ngôn ngữ diễn đạt","s":"Diễn đạt","d":"Bé dùng lời, cử chỉ hoặc tranh để nói điều mình muốn"},{"id":"cy","n":"Chú ý, bắt chước và nề nếp","s":"Chú ý","d":"Bé tập trung, hợp tác, bắt chước và theo nề nếp lớp học"},{"id":"xh","n":"Chơi và tương tác xã hội","s":"Xã hội","d":"Bé chơi, giao tiếp và kết bạn với người khác"},{"id":"nt","n":"Nhận thức và học tập","s":"Nhận thức","d":"Bé nhận biết, so sánh, đếm, đọc và viết"},{"id":"vt","n":"Vận động tinh","s":"Vận động tinh","d":"Đôi tay khéo léo: cầm, nắm, cài, tô, vẽ"},{"id":"vth","n":"Vận động thô và thăng bằng","s":"Vận động thô","d":"Bé đi, chạy, nhảy, leo trèo và giữ thăng bằng"},{"id":"tl","n":"Tự lập, giác quan và hành vi","s":"Tự lập","d":"Bé tự ăn, mặc, vệ sinh; điều hòa cảm giác và hành vi"}];
const LSRC={ab:{n:'ABLLS-R',d:'Đánh giá kỹ năng ngôn ngữ và học tập cơ bản'},ed:{n:'ESDM / Denver',d:'Chương trình Denver theo 4 cấp độ phát triển'},mn:{n:'Mầm non',d:'Mốc phát triển trẻ mầm non'},ot:{n:'Hoạt động OT',d:'Gợi ý hoạt động vận động và giác quan'},cu:{n:'Trung tâm tự thêm',d:'Mục tiêu do Trung tâm bổ sung'}};
const LHEAD=[["ab","Hợp tác và khen thưởng"],["ab","Khả năng quan sát"],["ab","Ngôn ngữ tiếp nhận"],["ab","Bắt chước"],["ab","Nhại lời / Nói theo"],["ab","Yêu cầu"],["ab","Gọi tên"],["ab","Hội thoại liên tưởng"],["ab","Ngôn ngữ tự phát"],["ab","Cú pháp và ngữ pháp"],["ab","Vui chơi và giải trí"],["ab","Tương tác xã hội"],["ab","Học nhóm"],["ab","Tuân theo nề nếp"],["ab","Khái quát tổng hợp"],["ab","Đọc"],["ab","Toán"],["ab","Viết"],["ab","Ghép vần"],["ab","Mặc quần áo"],["ab","Ăn"],["ab","Tự chăm sóc"],["ab","Vận động thô"],["ab","Vận động tinh"],["ab","Đi vệ sinh"],["ed","Giao tiếp tiếp nhận"],["ed","Giao tiếp diễn đạt"],["ed","Kỹ năng xã hội"],["ed","Bắt chước"],["ed","Nhận thức"],["ed","Chơi"],["ed","Vận động tinh"],["ed","Vận động thô"],["ed","Hành vi"],["ed","Tự lập – Ăn"],["ed","Tự lập – Mặc"],["ed","Tự lập – Chuẩn bị"],["ed","Tự lập – Việc vặt"],["ed","Chú ý chung"],["ed","Kỹ năng xã hội – Người lớn hoặc bạn cùng lứa"],["ed","Chơi – Trình bày"],["ed","Chơi – Chơi độc lập"],["ed","Tự lập – Vệ sinh"],["ed","Tự lập – Việc khác"],["ed","Kỹ năng xã hội – Người lớn và các bạn cùng lứa"],["ed","Tự lập"],["ed","Tự lập – Vệ sinh"],["ed","Tự lập – Việc khác"],["mn","Trước khi biết đi"],["mn","Làm quen với bóng"],["mn","Đi, chạy"],["mn","Nhún bật"],["mn","Chơi bóng"],["mn","Bò, trườn, trèo"],["mn","Bật- nhảy"],["mn","Đi và chạy"],["mn","Bật, nhảy"],["mn","Bò, trườn, treo"],["mn","Vận động tinh"],["mn","Xé giấy"],["mn","Viết/vẽ"],["mn","Cắt/ cài"],["mn","Chơi đất nặn"],["mn","Vẽ"],["mn","Chú ý"],["mn","Nghe và chú ý"],["mn","Khám phá"],["mn","Nhìn và chú ý"],["mn","Nhận thức"],["mn","Bộ phận cơ thể"],["mn","Đồ dùng, đồ chơi"],["mn","Bản thân, người gần gũi"],["mn","Phương tiện giao thông"],["mn","Con vật, hoa quả"],["mn","Màu sắc/ hình dạng/kích thước"],["mn","Màu sắc/ hình dạng/ kích thước/ không gian/số lượng"],["mn","Khám phá khoa học"],["mn","Dinh dưỡng"],["mn","Đếm và số"],["mn","Quy tắc sắp xếp"],["mn","So sánh hai đối tượng"],["mn","Nhận biết vị trí trong không gian"],["mn","Nhận biết nghề nghiệp"],["mn","Nhận biết, thể hiện cảm xúc tình cảm"],["mn","Nhận biết bản thân"],["mn","Nhận biết thể hiện cảm xúc tình cảm"],["mn","Nhận biết cảm xúc- tình cảm"],["mn","Ngôn ngữ hiểu"],["mn","Ngôn ngữ diễn đạt"],["mn","Làm quen với sách"],["mn","Làm quen đọc, viết"],["mn","Xã hội và hành vi"],["mn","Chơi"],["mn","Hành vi văn hoá- ứng xử"],["mn","Giao tiếp xã hội"],["ot","Gợi ý hoạt động về trương lực cơ"],["ot","Các hoạt động giúp cải thiện ổn đinh vai"],["ot","Giữ thăng bằng"],["ot","Qua đường giữa"],["ot","Các hoạt động giúp trẻ với tay"],["ot","Các hoạt động tăng lực bàn tay và ngón tay"],["ot","Các hoạt động giúp tách ngón tay"],["ot","Các hoạt động hai tay làm hai động tác"],["ot","Các hoạt động giúp làm rõ và xác lập tay thuận"],["ot","Các hoạt động phối hợp tay mắt"],["ot","Cầm ngón tay cái và ngón trỏ"],["ot","Các biện pháp hiệu quả để giúp phát triển hệ thính giác"],["ot","Các hoạt động giúp phát triển thị giác"],["ot","Hệ thống xúc giác"],["ot","Các hoạt động giúp hòa hợp tiền đình"],["ot","Hoạt động giúp tăng cường hoạt động cảm nhận cơ thể"],["ot","Các hoạt động môi miệng"]];
const LAGE=[["Cấp độ 1 · 12–18 tháng",1],["Cấp độ 2 · 18–24 tháng",1],["Cấp độ 3 · 24–36 tháng",2],["Cấp độ 4 · 36–48 tháng",3],["3–6 tháng",0],["6–12 tháng",0],["12–18 tháng",1],["18–24 tháng",1],["24–36 tháng",2],["3–4 tuổi",3],["4–5 tuổi",4],["5–6 tuổi",4],["2–3 tuổi",2],["1–2 tuổi",1],["12–24 tháng",1]];
const LRAW={"ab":[["A1",2,0,"Cầm vật yêu thích khi được cho","Khi được cho vật yêu thích, hay được rủ làm 1 hành động yêu thích, HS sẽ nhận/dùng vật đó hay làm hành động đó","Nhận kẹo M&M và ăn",-1,[["2","lúc nào cũng nhận rất nhanh"],["1","không phải lúc nào cũng nhận hoặc đôi lúc phản ứng chậm"]]],["A2",2,0,"Chọn vật yêu thích khi vật đó được đưa ra cùng một vật trung tính khác","Khi được cho 1 vật yêu thích/rủ làm 1 hành động yêu thích cùng với 1 vật và hành động trung tính khác, HS sẽ chọn vật/hành động yêu thích","Đưa kẹo M&M và giày, HS sẽ lấy kẹo M&M",-1,[["2","luôn nhận trong vòng 3 giây"],["1","không phải lúc nào cũng nhận hoặc phản ứng sau 3 giây"]]],["A3",2,0,"Nhìn vào vật trung tính","HS sẽ nhìn theo một vật trung tính mà GV đưa ra, kể cả khi thay đổi vị trí của vật","Khi đưa ra một đôi giày và yêu cầu HS nhìn giày, HS sẽ nhìn theo và theo dõi ta di chuyển giày đến các vị trí khác nhau ở trước mặt HS (VD lên, xuống, trái, phải)",-1,[["4","sẽ theo dõi vật di chuyển đến 6 vị trí khác nhau trong vòng 10 giây"],["3","sẽ theo dõi vật di chuyển đến 4 vị trí khác nhau trong vòng 10 giây"],["2","tìm ra vật ở bất kỳ vị trí nào (lên/xuống/trái/phải) trong vòng 3 giây"],["1","sẽ nhìn vật nhưng phải nhắc hoặc phản ứng sau 3 giây"]]],["A4",2,0,"Cầm 1 vật quen thuộc khi được cho","Khi được cho 1 vật quen thuộc, HS sẽ nhận.","Khi đưa ra 1 đôi giày HS sẽ nhận",-1,[["2","luôn nhận trong vòng 3 giây"],["1","không phải lúc nào cũng nhận hoặc phản ứng sau 3 giây"]]],["A5",2,0,"Lại gần khi được yêu cầu hồi đáp để được thưởng vật yêu thích","Khi cho bé thấy một vật yêu thích và ra yêu cầu HS phải làm một việc, HS sẽ lại gần GV và thực hiện yêu cầu (VD HS biết có vật yêu thích nhưng phải lại gần GV và làm một bài tập đơn giản thì mới được vật đó)","GV có nho khô là món HS thích (và HS lại đang đói), HS sẽ đi từ cuối phòng đến và bắt chước một hành động của GV để được ăn nho khô",-1,[["4","sẽ lại gần và ngồi vào bàn, rồi thực hiện một số yêu cầu để được vật yêu thích (mỗi lần thực hiện được 1 lần thưởng)"],["3","sẽ lại gần và thực hiện một số yêu cầu (mỗi lần thực hiện được 1 lần thưởng)"],["2","sẵn sàng lại gần thậm chí nhiều lần và thực hiện nhiều mệnh lệnh đơn đã học"],["1","thỉnh thoảng lại gần và thực hiện ít nhất một yêu cầu để được vật yêu thích"]]],["A6",2,0,"Hồi đáp với vật/ hành động yêu thích mà GV đang cầm/kiểm soát","HS sẽ chịu làm theo yêu cầu khi GV đang cầm/kiểm soát vật yêu thích","Khi đưa 3 mảnh ráp hình, mỗi lần 1 mảnh, HS sẽ ghép mảnh ráp vào khung để được 1 quả nho (vật HS thích) cho mỗi lần ghép",-1,[["4","thực hiện 5 bài tập/hồi đáp mới sau ít nhất 5 lần đưa ra vật yêu thích"],["3","2 bài tập/hồi đáp mới và 3 bài tập/hồi đáp đã học sau ít nhất 5 lần đưa ra vật yêu thích"],["2","5 bài tập/hồi đáp đã học sau 5 lần đưa ra vật yêu thích"],["1","3 bài tập/hồi đáp đã học sau 3 lần đưa ra vật yêu thích"]]],["A7",2,0,"Hợp tác/hồi đáp với nhiều GV","HS thể hiện và sử dụng những kỹ năng đã học từ 1 GV khi làm việc với các GV khác","HS được 1 GV dạy bắt chước vỗ tay và sờ mũi, và sẽ làm những hành động này theo yêu cầu của GV khác",-1,[["2","sẵn sàng hợp tác với ít nhất 3 GV VÀ với các GV mới mà vẫn hồi đáp với tốc độ và chất lượng như với GV cũ"],["1","sẵn sàng hợp tác với ít nhất 3 GV mà vẫn hồi đáp với tốc độ và chất lượng như với GV cũ"]]],["A8",2,0,"Đợi trong giờ học mà không sờ vào vật kích thích","Trong giờ học (trên bàn, chơi dưới sàn nhà, gần giáo cụ), HS sẽ bình tĩnh đợi và vẫn tập trung nghe hướng dẫn của GV và giáo cụ mà không sờ vào chúng nếu GV chưa có chỉ dẫn","Ngồi yên để tay trên bàn mà không với lấy dụng cụ học tập, đợi GV ra bài tập, không phải để GV nhắc nhiều lần \"ngồi yên\", \"bỏ tay ra\", v.v…",-1,[["2","Khi để giáo cụ trước mặt, HS luôn nhìn giáo cụ và bình tĩnh đợi mà không cần nhắc không được sờ vào giáo cụ"],["1","chỉ phải nhắc 1 lần ngồi/đứng yên hoặc không được lấy giáo cụ"]]],["A9",2,0,"Nhìn GV đợi chỉ dẫn","Khi đang thực hiện các bài tập, HS sẽ nhìn bao quát các giáo cụ và nhìn GV đợi chỉ dẫn cho bài tập tiếp theo","Sau khi nhìn bao quát các tranh bài tập trên bàn, HS nhìn GV đợi chỉ dẫn tiếp theo mà không cần nhắc \"Nhìn\"",-1,[["2","sau khi nhìn bao quát các giáo cụ, HS luôn nhìn GV đợi chỉ dẫn tiếp theo"],["1","sau khi nhìn bao quát các giáo cụ, chỉ cần nhắc 1 lần phải tập trung đợi chỉ dẫn của GV"]]],["A10",2,0,"Nhìn bao quát chuỗi các vật trước khi hồi đáp","Khi GV ra bài tập có dùng giáo cụ, HS sẽ chú ý nghe chỉ dẫn sau đó nhìn bao quát các giáo cụ trước khi trả lời","Khi yêu cầu HS \"đưa cho cô đôi giầy\", HS sẽ nhìn bao quát các vật quanh chỗ mình ngồi xem có giầy không",-1,[["2","luôn nhìn bao quát ít nhất 6 vật liên quan đến bài tập trong vòng 3 giây (trước khi trả lời)"],["1","có thể nhìn bao quát 3 vật liên quan đến bài tập trong vòng 3 giây (trước khi trả lời)"]]],["A11",2,0,"Hồi đáp ngay sau khi GV ra yêu cầu","Khi đang học, HS sẽ hồi đáp ngay sau khi GV ra yêu cầu","Khi được yêu cầu chỉ tranh con chim, HS sẽ lập tức với lấy tranh con chim và chỉ vào con chim",-1,[["2","luôn hồi đáp trong vòng 3 giây sau khi ra yêu cầu"],["1","luôn hồi đáp trong vòng 5 giây sau khi ra yêu cầu"]]],["A12",2,0,"Thích nhiều vật (ngoài đồ ăn)","Có thể lấy nhiều vật và hoạt động làm vật củng cố/phần thưởng","Hành động: cù, nhặt đồ, đồ chơi quay vòng, các vật kích thích thính giác: nhạc; xúc giác: xoa và cù; giao lưu: vỗ tay, khen; một loại đồ chơi nào đó; trò chơi: ráp hình, vi tính",-1,[["2","có thể lấy ít nhất 10 vật/ hành động (được GV cầm/kiểm soát) để làm phần thưởng trong khi học"],["1","có thể lấy ít nhất 5 vật/hành động để làm phần thưởng"]]],["A13",2,0,"Thưởng không liên tục vật hữu hình","HS nghe lời khi không thưởng liên tục","HS chịu gọi tên các thẻ tranh nếu có lúc trả lời khoảng 4 lần mới được thưởng một quả nho khô",-1,[["4","làm 5 bài tập/hồi đáp mới để được một phần thưởng hữu hình hoặc ăn được"],["3","làm 2 bài tập/hồi đáp mới và 3 bài tập/hồi đáp đã học để được một phần thưởng hữu hình hoặc ăn được"],["2","làm 4 bài tập/hồi đáp đã học để được một phần thưởng hữu hình hoặc ăn được"],["1","làm 2 bài tập/hồi đáp đã học để được một phần thưởng hữu hình hoặc ăn được"]]],["A14",2,0,"Phần thưởng là được giao lưu/chơi đùa với GV","HS sẽ nghe lời nếu phần thưởng là được giao lưu/chơi đùa với GV","HS chịu làm theo yêu cầu nếu được chơi trò \"Ring around the Rosie\" với GV",-1,[["4","làm 5 bài tập/hồi đáp mới để được chơi đùa với GV"],["3","làm 2 bài tập/hồi đáp mới và 3 bài tập/hồi đáp đã học để được chơi đùa với GV"],["2","làm 4 bài tập/hồi đáp đã học để được chơi đùa với GV"],["1","làm 2 bài tập/hồi đáp đã học để được chơi đùa với GV"]]],["A15",2,0,"Nhận ra thay đổi trong nét mặt và giọng nói của GV","Sau khi trả lời, HS sẽ nhìn GV và thăm dò sự thay đổi trong nét mặt giọng nói để phỏng đoán phản hồi của GV về độ chính xác của câu trả lời","Quan sát xem GV có cười không, theo dõi sự thay đổi trong giọng nói của cô khi khen",-1,[["2","nhìn GV để thăm dò phản hồi khi đã trả lời xong 7/10 lần"],["1","thỉnh thoảng nhìn GV để thăm dò phản hồi khi đã trả lời xong (nếu GV không thay đổi hành vi một cách rõ rệt để HS nhận ra)"]]],["A16",2,0,"Hưởng ứng với khen thưởng mang tính xã hội","HS sẽ nghe lời nếu được khen","",-1,[["4","chịu nghe lời trong 15 phút chỉ vì lời khen"],["3","chịu nghe lời trong 15 phút khi được khen kèm phần thưởng"],["2","chịu nghe lời trong 5 phút khi được khen kèm phần thưởng"],["1","chịu làm 3 bài tập/hồi đáp trước khi thưởng"]]],["A17",2,0,"Biết chờ nếu không được thưởng ngay","HS biết chờ nếu không được thưởng ngay khi làm xong bài tập","",-1,[["4","chờ 5 phút"],["3","1 phút"],["2","10 giây"],["1","5 giây"]]],["A18",2,0,"Chờ được khen thưởng khi làm xong việc","HS sẽ chờ được khen thưởng/ghi nhận vì đã làm xong việc","",-1,[["2","yêu cầu người khác để ý nhìn những việc mình đã làm"],["1","quan sát xem người khác có nhận ra mình đã làm được những gì không"]]],["A19",2,0,"Tự hài lòng khi mình làm xong một việc","Hoàn tất 1 việc chính là phần thưởng cho HS","",-1,[["2","tự làm trong 10 phút cho đến khi xong việc để được ghi nhận là đã hoàn thành 1 việc"],["1","tự làm trong 5 phút cho đến khi xong việc chỉ cần được khen"]]],["B1",4,1,"Chơi ghép hình loại 1 miếng ghép vào 1 hình","Khi được trao những miếng ghép đơn hình khác biệt rõ ràng về hình dáng trong cùng 1 bộ ghép hình, HS biết ghép những miếng ghép đó vào khung","",-1,[["4","ghép được cả 5 miếng ghép bằng cách nhìn và định vị"],["3","ghép được cả 3 miếng ghép bằng cách nhìn và định vị"],["2","ghép được 5 miếng được đưa riêng rẽ, bằng cách thử, nếu sai thì làm lại"],["1","ghép được 3 miếng được đưa riêng rẽ, bằng cách thử, nếu sai thì làm lại"]]],["B2",4,1,"Hộp hình dạng","Khi được đưa 1 hộp hình dạng hay hộp phân loại các hình dạng và miếng hình khối, học sinh có biết thả từng miếng hình khối vào lỗ tương ứng ở hộp","",-1,[["4","thả được 6 miếng bằng cách quan sát miếng hình khối rồi tìm lỗ tương ứng"],["3","4 miếng bằng cách quan sát miếng hình khối rồi tìm lỗ tương ứng"],["2","4 miếng bằng cách thử thả vào các lỗ, sai thì làm lại"],["1","2 miếng bằng cách thử thả vào các lỗ, sai thì làm lại"]]],["B3",4,1,"Tìm vật giống với vật mẫu","Khi được đưa 1 vật mẫu, học sinh sẽ tìm được vật giống vật mẫu trong số 3 vật bày ra","",-1,[["4","ghép được vật mẫu với một trong số 8 vật bày ra ít nhất 10 lần"],["3","ghép được vật mẫu với một trong số 4 vật bày ra ít nhất 5 lần"],["2","ghép được vật mẫu với một trong số 2 vật bày ra ít nhất 2 lần"],["1","ghép được vật mẫu với một trong số 2 vật bày ra 1 lần"]]],["B4",4,1,"Ghép vật với ảnh tương ứng","Khi được đưa 1 vật, học sinh sẽ ghép được với một trong số 3 ảnh","",-1,[["2","có thể ghép 3 vật liên tiếp"],["1","có thể ghép từng vật cho mỗi lần yêu cầu"]]],["B5",4,1,"Tìm ảnh giống ảnh mẫu","Khi được đưa 1 ảnh, học sinh sẽ ghép ảnh đó với ảnh giống nó trong số 3 ảnh bày ra","",-1,[["4","ít nhất 10 ảnh khi bày mỗi lần 8 ảnh"],["3","ít nhất 5 ảnh khi bày mỗi lần 4 ảnh"],["2","ít nhất 2 ảnh khi bày mỗi lần 2 ảnh"],["1","1 ảnh khi bày mỗi lần 2 ảnh"]]],["B6",4,1,"Ghép ảnh với vật","Khi đưa ảnh của 1 vật, học sinh sẽ ghép ảnh đó với một trong số 3 vật bày ra","",-1,[["2","có thể ghép 3 vật liên tiếp"],["1","có thể ghép từng vật cho mỗi lần yêu cầu"]]],["B7",4,1,"Ghép nhuần nhuyễn thành thạo","Khi cho xem 10 ảnh các vật, HS sẽ ghép liên tiếp từng ảnh với một ảnh giống nó trong số 10 ảnh bày ra","Khi đưa một chồng ảnh, HS có thể ghép liên tiếp từng ảnh với ảnh giống nó trong các loạt tranh bày ra không?",-1,[["2","có thể ghép ít nhất 10 thứ trong vòng 30 giây"],["1","có thể ghép 5 thứ riêng rẽ trong vòng 15 giây"]]],["B8",4,1,"Phân loại các vật không giống nhau","Khi được đưa 1 loạt vật hay ảnh không giống nhau thuộc 3 nhóm khác nhau, và đưa một loạt vật mẫu cho từng nhóm, HS sẽ phân loại những vật không giống nhau vào các nhóm thích hợp (VD: các ảnh về chó, các ảnh về cây, các ảnh người)","Đưa học sinh tập hợp nhiều ảnh chó và cây, rồi để ảnh mẫu của mỗi loại trên bàn. Học sinh phân loại các ảnh bằng cách đặt ảnh chó vào chồng chó và cây vào chồng cây",-1,[["4","đưa 20 vật (5 vật x 4 loại), phân loại được 10 vật thành 4 loại"],["3","đưa 12 vật (3 vật x 4 loại), phân loại được ít nhất 6 vật thành 4 loại"],["2","đưa 6 vật (2 vật x 3 loại), phân loại được ít nhất 4 vật thành 3 loại"],["1","đưa 4 vật (2 vật x 2 loại), phân loại được ít nhất 2 vật thành 2 loại"]]],["B9",4,1,"Sắp xếp khối hình trên thẻ tranh","Khi được đưa thẻ tranh vẽ các kiểu sắp xếp khối hình, HS sẽ xếp khối hình lên vị trị tương ứng trên thẻ tranh và không bị phân tán bởi những khối hình thừa không cần dùng đến","",-1,[["4","nhanh chóng xếp xong với 6 khối hình hoặc hơn (có khối hình thừa không dùng đến)"],["3","4 hay hơn (có khối hình thừa không dùng đến)"],["2","tối đa 4 (không có khối thừa)"],["1","xếp được tối đa 2 khối (không có khối thừa)"]]],["B10",4,1,"Ghép nhiều mảnh liên kết với nhau thành 1 hình lấp đầy khung hình","Khi đưa những mảnh ghép hình dáng đặc thù, liên kết với nhau, để lấp đầy một khung hình, học sinh sẽ ghép được.","",-1,[["4","4 khung hình loại 8 mảnh"],["3","4 khung hình loại 5 mảnh"],["2","2 khung hình loại 5 mảnh"],["1","1 khung hình loại 5 mảnh tối thiểu"]]],["B11",4,1,"Ghép hình loại khung hình có cạnh là góc vuông","Khi đưa ghép hình loại khung hình có cạnh là góc vuông, học sinh sẽ ghép được.","",-1,[["4","3 khung hình loại 5 mảnh"],["3","3 khung hình loại 4 mảnh"],["2","3 khung hình loại 3 mảnh"],["1","3 khung hình loại 2 mảnh tối thiểu"]]],["B12",4,1,"Sắp xếp khối hình giống trong ảnh","Khi đưa ảnh vẽ các kiểu sắp xếp khối hình, HS biết sắp xếp các khối hình giống trong ảnh","Để khối tam giác lên tấm bìa có vẽ hình tam giác",-1,[["4","nhanh chóng xếp xong ít nhất 6 khối hình (có khối thừa không dùng đến)"],["3","ít nhất 4 khối hình (có khối thừa không dùng đến)"],["2","tối đa 4 (không có khối thừa)"],["1","tối đa 2 (không có khối thừa)"]]],["B13",4,1,"Sắp xếp theo quy luật trình tự quan sát được","Khi cho xem 1 chuỗi trình tự các vật (VD các khối màu), học sinh sẽ sắp xếp các khối theo quy luật trình tự quan sát được","",-1,[["4","có thể xếp theo quy luật trình tự có 8 vật trong đó 4 vật khác nhau, có vật thừa không dùng đến"],["3","chuỗi 8 vật trong đó 4 vật khác nhau (không có vật thừa không dùng đến)"],["2","chuỗi 6 vật trong đó 3 vật khác nhau (không có vật thừa không dùng đến)"],["1","chuỗi 6 vật trong đó 2 vật khác nhau (không có vật thừa không dùng đến)"]]],["B14",4,1,"Tạo bức tranh bằng cách xếp nhiều mảnh rời cạnh nhau (chú thích của người dịch: không nối kết với nhau)","Khi được trao những mảnh ghép có hình dạng khác nhau, không nối kết với nhau, học sinh sẽ đặt các mảnh ghép cạnh nhau để tạo thành 1 bức tranh","",-1,[["4","ghép 4 tranh loại 5 mảnh"],["3","ghép 4 tranh loại 4 mảnh"],["2","ghép 2 tranh loại 3 mảnh"],["1","ghép 1 tranh loại tối thiểu 3 mảnh"]]],["B15",4,1,"Chơi ghép hình chuẩn","Khi đưa một bộ ghép hình chuẩn thông thường, (các mảnh ghép liên kết với nhau, không có khung hình), học sinh sẽ ghép được","",-1,[["4","ít nhất 4 bộ loại 12 mảnh"],["3","2 bộ loại 12 mảnh"],["2","2 bộ loại 8 mảnh"],["1","1 bộ loại tối thiểu 8 mảnh"]]],["B16",4,1,"Ghép các tranh có liên quan với nhau","Bày một loạt các vật hoặc ảnh, HS sẽ biết ghép một vật với vật có liên quan trong loạt đó (VD ghép que đánh bóng chày với quả bóng chày)","",-1,[["4","ghép được ít nhất 2 tranh liên quan trong số 20 tranh hay hơn"],["3","2 tranh trong số 10 tranh"],["2","1 tranh trong số 10 tranh"],["1","ít nhất 1 tranh trong số 5 tranh"]]],["B17",4,1,"Phân loại theo chức năng","Khi đưa ra 2 vật đại diện cho 2 chức năng khác nhau, và sếp mẫu một vật khác có cùng chức năng với vật mẫu vào cùng nhóm, HS sẽ biết phân loại các vật còn lại theo chức năng","Khi đưa một cái bút và một chai thổi bong bóng, sau đó đặt bút sáp vào cùng nhóm với bút, nến vào cùng nhóm với bong bóng, HS sẽ tiếp tục phân nhóm các vật còn lại theo tiêu chí vật để viết và vật để thổi thành từng chồng",-1,[["4","ít nhất 5 vật thuộc 4 chức năng"],["3","ít nhất 5 vật thuộc 3 chức năng"],["2","ít nhất 5 vật thuộc 2 chức năng"],["1","ít nhất 2 vật thuộc 2 chức năng"]]],["B18",4,1,"Phân loại theo đặc tính","Khi đưa 2 vật mẫu có các đặc tính/bộ phận khác nhau và ghép mẫu với một vật khác có cùng đặc tính/bộ phận, HS sẽ biết phân loại các vật tiếp theo có cùng đặc tính vào cùng nhóm với đúng vật mẫu tương ứng","Khi cho xem con khỉ và ôtô, rồi xếp chó cùng chồng với khỉ và xe đạp cùng chồng với ôtô, HS sẽ tiếp tục xếp các tranh khác theo nhóm những con có đuôi, và vật có bánh",-1,[["4","ít nhất 5 vật thuộc 4 đặc tính"],["3","ít nhất 5 vật thuộc 3 đặc tính"],["2","ít nhất 5 vật thuộc 2 đặc tính"],["1","ít nhất 2 vật thuộc 2 đặc tính"]]],["B19",4,1,"Phân loại theo chủng loại","Khi đưa ra 3 vật mẫu thuộc 3 chủng loại khác nhau, và ghép mẫu một vật khác vào từng chủng loại, HS sẽ biết phân loại các tranh còn lại vào cùng chủng loại với đúng vật mẫu","Khi cho xem con mèo và cái giày, rồi đặt con chó vào cùng nhóm với con mèo, cái áo vào cùng nhóm với cái giày, HS sẽ tiếp tục đặt các vật khác vào chồng con vật và chồng đồ để mặc",-1,[["4","ít nhất 5 vật thuộc 4 chủng loại"],["3","ít nhất 5 vật thuộc 3 chủng loại"],["2","ít nhất 5 vật thuộc 2 chủng loại"],["1","ít nhất 2 vật thuộc 2 chủng loại"]]],["B20",4,1,"Lặp lại 1 trình tự sau một thời gian","Cho học sinh xem vật mẫu xếp theo 1 trình tự nhất định, rồi xóa đi, học sinh sẽ có thể sắp xếp lại theo trình tự ban đầu","Sau khi cho xem 3 vật xếp theo một trình tự nào đó, rồi xóa đi, học sinh lặp lại trình tự ban đầu.",-1,[["4","ngay lập tức với 3 vật, sau 5 giây."],["3","3 vật sau 2 giây hoặc 2 vật sau 5 giây"],["2","2 vật sau 2 giây không nhắc"],["1","2 vật sau 2 giây có nhắc bằng lời hay cử chỉ"]]],["B21",4,1,"Từ một loạt vật đưa ra, tìm vật mẫu ban đầu sau một thời gian chờ","Khi đưa cho xem 1 vật nhất định, sau đó lấy đi, rồi cho xem 3 vật (trong đó có 1 vật học sinh đã thấy), HS có thể tìm ra vật đã đưa xem ban đầu","Sau khi cho học sinh xem ảnh con mèo, giấu ảnh đi, chờ vài giây, rồi đưa ra ảnh chó, mèo và chim rồi yêu cầu tìm ảnh HS được xem ban đầu",-1,[["4","sau 5 giây, tìm ra trong số 5 ảnh trong vòng 3 giây được 10 lần"],["3","sau 3 giây, tìm ra trong vòng 3 giây được 5 lần"],["2","sau 3 giây, tìm ra trong số 3 vật trong vòng 3 giây được 5 lần"],["1","sau 2 giây, tìm ra trong số 2 vật trong vòng 3 giây được 3 lần"]]],["B22",4,1,"Tiếp tục một chuỗi trình tự","Khi được cho xem 1 số vật mẫu xếp theo 1 trình tự nhất định (cả đồng nhất và không đồng nhất), học sinh có thể tiếp tục thêm vào những vật khác theo đúng quy luật trình tự đó (VD ABABAB, ABCABC, ABBABB, ÂBÂB, ABBCABBC)","Khi cho xem 1 số hình khối sắp xếp theo một quy luật trình tự nhất định (thí dụ: đỏ, xanh, đỏ, xanh), học sinh sẽ xếp tiếp 1 khối đỏ rồi đến 1 khối xanh",-1,[["4","tiếp tục xếp thêm 3 vật theo 1 quy luật không đồng nhất, khi để cả những vật thừa không thích hợp với quy luật trình tự đó"],["3","xếp thêm 3 vật theo quy luật đồng nhất, khi để cả những vật thừa không thích hợp với quy luật trình tự đó"],["2","xếp thêm 3 vật theo quy luật đồng nhất"],["1","2 vật theo quy luật trình tự xen kẽ"]]],["B23",4,1,"Lặp lại mô hình 3 chiều","Khi được đưa 1 bộ hình khối hay vật khác và mô hình 3 chiều đơn giản (VD: nhà hay xe), học sinh sẽ có thể sắp xếp các khối hình hay các vật khác đó theo cấu trúc mô hình đó","Sau khi xem mô hình mẫu, học sinh xếp các hình khối thành 1 ngôi nhà",-1,[["2","có thể xếp được 2 mô hình với ít nhất 6 khối hình hoặc những vật khác"],["1","có thể xếp được 2 mô hình với ít nhất 3 khối hình hoặc những vật khác"]]],["B24",4,1,"Xếp những vật tương ứng với nhau cạnh nhau","HS sẽ biết quan sát khi một người đặt các vật khác nhau lên bàn, thì HS sẽ đặt một vật thứ hai lên từng vật ngay sau khi mỗi loại vật ban đầu được đặt lên bàn","Hễ ta đặt giấy ăn lên bàn, HS sẽ lập tức đặt thìa lên giấy ăn, sau khi GV đặt khối hình màu trắng, HS sẽ xếp tiếp khối màu xanh, bày một hộp đựng nước hoa quả lên bàn, học sinh sẽ cắm một ống hút vào hộp",-1,[["2","lập tức đặt một vật lên vật tương ứng liên tiếp ít nhất 6 lần"],["1","lập tức đặt một vật lên vật tương ứng liên tiếp ít nhất 3 lần"]]],["B25",4,1,"Xếp theo sê ri","Khi được đưa 1 mô hình chuỗi tịnh tiến có đầu và cuối, học sinh sẽ có thể xếp tiếp theo thứ tự hợp lý về kích cỡ, số lượng, màu sắc và thứ tự","",-1,[["4","có thể xếp ít nhất 4 tập hợp các vật với 4 đặc tính"],["3","2 tập hợp các vật với 3 đặc tính"],["2","2 tập hợp với 2 đặc tính"],["1","2 tập hợp với 1 đặc tính"]]],["B26",4,1,"Xếp các ảnh theo trình tự","Học sinh sẽ có thể xếp 1 bộ ảnh theo trình tự hợp lý","Xếp 4 ảnh rửa tay theo trình tự : mở nước, sát xà phòng, rửa tay, lau tay bằng khăn",-1,[["4","có thể xếp thứ tự ít nhất 5 bộ ảnh 4 bước"],["3","5 bộ ảnh 3 bước"],["2","3 bộ ảnh 3 bước"],["1","2 bộ ảnh 3 bước"]]],["B27",4,1,"Mê cung","Học sinh có thể kẻ đường thẳng nối từ điểm đầu đến điểm cuối của 1 mê cung đơn giản","",-1,[["2","có thể vẽ đường thẳng nối từ điểm đầu đến điểm cuối 1 mê cung, có 3 lựa chọn để tìm ra phương án đúng"],["1","có thể vẽ đường thẳng nối từ điểm đầu đến điểm cuối 1 mê cung, chỉ có 1 lựa chọn để tìm ra phương án đúng"]]],["C1",0,2,"Có đáp lại khi nghe gọi tên mình","HS sẽ nhìn hoặc lại gần người gọi tên mình","",-1,[["2","nhìn hoặc lại gần ít nhất 80% số lần gọi"],["1","có đáp lại khi được nhắc đôi chút"]]],["C2",0,2,"Làm một việc yêu thích đúng ngữ cảnh theo yêu cầu","Khi yêu cầu HS làm một việc yêu thích đúng ngữ cảnh hiện tại, HS sẽ làm theo","nhún nhảy trên bạt lò xo, đu xích đu",-1,[["4","ít nhất 3 hoạt động không cần nhắc nhở"],["3","ít nhất 3 hoạt động có nhắc nhở bằng lời hay khi có người chỉ tay nhắc"],["2","ít nhất 3 hoạt động có làm mẫu và không cần nhắc"],["1","ít nhất 3 hoạt động có nhắc bằng cử chỉ"]]],["C3",0,2,"Nhìn vào vật củng cố theo yêu cầu","Học sinh sẽ nhìn vật củng cố giáo viên đang cầm khi yêu cầu","",-1,[["2","nhìn vào vật ở mọi vị trí (trái, phải, trên, dưới) trong vòng 3 giây"],["1","nhìn vào vật khi có nhắc nhở hoặc phản ứng sau 3 giây"]]],["C4",0,2,"Sờ vào vật củng cố đặt ở các vị trí theo yêu cầu","Học sinh sẽ chạm vào vật yêu thích đặt ở các vị trí khác nhau","khoai tây chiên để trên đầu, đưa qua trái, qua phải ....",-1,[["2","sẵn sàng chạm vào vật đặt ở mọi vị trí (trên/dưới/ trái/ phải) trong vòng 3 giây"],["1","chạm vào hoặc lấy vật trong vòng 3 giây nếu vật đó được để trước mặt học sinh"]]],["C5",0,2,"Chạm vào vật thông thường đặt ở nhiều vị trí khác nhau theo yêu cầu","Học sinh sẽ chạm vào một vật thông thường đặt ở nhiều vị trí khác nhau theo yêu cầu","Cây bút để trên đầu, qua trái, qua phải...",-1,[["2","sẵn sàng chạm vào vật đặt ở mọi vị trí (trên/dưới/ trái/ phải) trong vòng 3 giây"],["1","chạm vào hoặc lấy vật trong vòng 3 giây nếu để vật ở trước mặt học sinh"]]],["C6",0,2,"Theo lệnh làm 1 việc yêu thích không phù hợp với ngữ cảnh","Học sinh sẽ theo lệnh làm 1 việc yêu thích mặc dù việc đó không xảy ra tại thời điểm đó","Trong khi đang ngồi ở bàn, học sinh sẽ theo lệnh lên bạt lò xo nhảy v.v...",-1,[["4","ít nhất 3 hoạt động không có nhắc nhở"],["3","ít nhất 3 hoạt động có nhắc nhở bằng lời hay cử chỉ"],["2","ít nhất 3 hoạt động có làm mẫu và không nhở nhở bằng lời"],["1","ít nhất 3 hoạt động có nhắc nhở bằng cử chỉ"]]],["C7",0,2,"Theo lệnh trong những tình huống thường ngày","Học sinh sẽ theo lệnh làm 1 việc mà mình không thích khi đến giờ diễn ra hoạt động đó","Sau khi đi vệ sinh học sinh sẽ phải theo lệnh \"rửa tay\".",-1,[["4","ít nhất 3 việc không nhắc nhở"],["3","ít nhất 3 có nhắc nhở bằng lời hoặc bằng cử chỉ"],["2","ít nhất 3 có làm mẫu, không nhắc nhở bằng cử chỉ"],["1","ít nhất 3 hoạt động có nhắc nhở phần nào bằng cử chỉ"]]],["C8",0,2,"Theo lệnh đưa 1 vật học sinh không thích","Học sinh sẽ có thể theo lệnh đưa một vật HS không thích","Theo lệnh, học sinh sẽ cầm giày đưa cho giáo viên",-1,[["2","thường làm theo trong vòng 3 giây"],["1","thường phải nhắc thêm (không kể việc xỏe tay nhận vật)"]]],["C9",0,2,"Theo lệnh làm 1 động tác đơn giản","Học sinh sẽ theo lệnh làm 1 động tác đơn giản (VD: vỗ tay, quay tròn, giơ tay lên cao)","nhảy, ngồi xuống, giơ 2 tay lên cao, vỗ tay, thổi, gõ",-1,[["4","ít nhất 6 lệnh không cần nhắc nhở VÀ có thể làm theo ít nhất 4 động tác khác trong vòng 10 giây"],["3","ít nhất 6 lệnh không nhắc nhở"],["2","ít nhất 4 lệnh không nhắc nhở"],["1","ít nhất 2 lệnh không nhắc nhở"]]],["C10",0,2,"Theo lệnh chạm vào 1 vật thay vì 1 vật đánh lạc hướng chú ý","Khi được lệnh chạm vào 1 vật cầm ở 1 tay còn tay kia giơ ra nhưng không cầm gì để đánh lạc hướng chú ý (hay để vật đó ở trên bàn cạnh 1 vật trung tính như ống bọt xà phòng để đánh lạc hướng chú ý), học sinh sẽ chạm vào vật nêu tên","Khi 1 tay cầm cốc, 1 tay không cầm gì ở 1 tư thế khác, học sinh sẽ chọn cốc theo yêu cầu",-1,[["2","sẵn sàng tìm và chạm vào vật ở mọi vị trí trong vòng 3 giây"],["1","sẽ chạm vào vật nếu vật đó ở trước mặt học sinh"]]],["C11",0,2,"Theo lệnh chọn lấy vật yêu thích từ 2 vật bày ra","Khi được hỏi, học sinh sẽ chọn 1 vật mình thích mà GV nói tên từ 2 vật bày ra ở bất cứ vị trí nào trước mặt học sinh","Khi để 1 bên là chiếc giày, 1 bên là chai bọt xà phòng - vật yêu thích) học sinh sẽ chọn ống bọt xà phòng theo lệnh",-1,[["2","sẵn sàng tìm chọn vật đó ở mọi vị trí trong vòng 3 giây"],["1","tìm chọn vật đó nếu để trước mặt học sinh"]]],["C12",0,2,"Theo lệnh chọn 1 trong 2 vật yêu thích","Theo lệnh, học sinh sẽ chọn vật nêu tên từ 2 đồ vật yêu thích để ở bất kì vị trí nào trước mặt học sinh","Khi 1 hộp nho (vật yêu thích) và 1 chai bọt xà phòng (vật yêu thích) được đặt trước mặt học sinh, học sinh sẽ chọn chai bọt xà phòng theo yêu cầu",-1,[["2","sẵn sàng tìm ra và chọn lấy vật đó ở mọi vị trí trong vòng 3 giây"],["1","tìm lấy được vật yêu thích nếu vật ấy để trước mặt học sinh"]]],["C13",0,2,"Theo lệnh chọn lấy 1 trong 2 vật thông thường","Theo lệnh, học sinh sẽ chọn lấy một vật giáo viên nêu tên từ 2 vật thông thường bày trước mặt học sinh","Khi bày để cái cốc và 1 cái giày trước mặt học sinh, học sinh sẽ chọn giày khi GV yêu cầu lấy \"giầy\"",-1,[["4","lấy được 50 vật và biết vài ví dụ cho hầu hết những vật đó"],["3","25 vật khác nhau"],["2","10 vật"],["1","ít nhất 2 vật"]]],["C14",0,2,"Chọn lấy 1 trong 2 ảnh những vật thông thường","Theo lệnh, học sinh sẽ chọn lấy ảnh một vật giáo viên nêu tên từ 2 ảnh những vật thông thường bày trước mặt học sinh","Khi bày 1 ảnh con chó và ảnh 1 chiếc giày trước mặt học sinh, học sinh sẽ chọn giày khi GV yêu cầu lấy \"giầy\"",-1,[["4","lấy được ảnh của hơn 50 vật và biết vài ví dụ cho hầu hết những vật đó."],["3","25 tranh các vật khác nhau"],["2","10 vật"],["1","ít nhất 2 vật"]]],["C15",0,2,"Chạm vào các bộ phận trên cơ thể mình","Học sinh sẽ có thể theo lệnh chạm vào các bộ phận trên cơ thể mình","",-1,[["4","ít nhất 10 bộ phận"],["3","6 bộ phận"],["2","4 bộ phận"],["1","2 bộ phận"]]],["C16",0,2,"Tìm chọn 1 trong số ít nhất 6 vật trên bàn","Học sinh sẽ tìm chọn được ít nhất 100 vật thông thường khi bày mỗi lần ít nhất 6 vật trên bàn ở bất cứ vị trí nào trước mặt học sinh","có thể thực hiện kỹ năng này bằng bất cứ dạng hồi đáp nào (VD chỉ, nhặt lên, đưa, chạm vào, cho xem, ở đâu, tìm cái...)",-1,[["4","tìm chọn được ít nhất 100 vật và có thể chỉ ra được vài ví dụ (kể cả ví dụ mới) cho hầu hết các vật (khi bày mỗi lần ít nhất 6 vật)"],["3","50 vật, mỗi vật một ví dụ (khi bày mỗi lần ít nhất 3 vật)"],["2","10 vật (mỗi lần bày 3 vật)"],["1","5 vật (mỗi lần bày ít nhất 3 vật)"]]],["C17",0,2,"Tìm chọn 1 trong số ít nhất 6 ảnh trên bàn","Học sinh sẽ tìm chọn được ảnh về ít nhất 100 vật thông thường khi bày mỗi lần ít nhất 6 ảnh trên bàn ở bất cứ vị trí nào trước mặt học sinh","có thể thực hiện kỹ năng này bằng bất cứ dạng hồi đáp nào (VD chỉ, nhặt lên, đưa, chạm vào, cho xem, ở đâu, tìm cái...)",-1,[["4","tìm chọn được ít nhất 100 ảnh và có thể chỉ ra được vài ví dụ (kể cả ví dụ mới) cho hầu hết các vật (khi bày mỗi lần ít nhất 6 ảnh)"],["3","50 ảnh, mỗi vật một ví dụ (khi bày mỗi lần ít nhất 3 ảnh)"],["2","10 ảnh (mỗi lần bày 3 ảnh)"],["1","5 ảnh (mỗi lần bày ít nhất 3 ảnh)"]]],["C18",0,2,"Biết thêm nhiều kỹ năng tìm chọn mới mà không cần tập luyện nhiều","Học sinh sẽ học thêm các kĩ năng tìm chọn mới sau khi thực hiện lệnh tìm chọn không quá 5 lần","Học sinh tập tìm lấy được ảnh điện thoại sau không quá 5 lần hỏi",-1,[["2","sẵn sàng tìm lấy nhiều vật mới sau không quá 5 lần hỏi"],["1","sẵn sàng tìm lấy nhiều vật mới sau không quá 10 lần hỏi"]]],["C19",0,2,"Phân biệt nhận biết thành thạo","Học sinh sẽ có thể tìm chọn các vật đã biết từ nhiều vật theo các yêu cầu liên tiếp","yêu cầu \"hãy chỉ giầy\", học sinh làm theo, tiếp đến chỉ sách, táo liên tiếp",-1,[["2","có thể lần lượt chỉ hay chọn ít nhất 10 vật đã biết trong vòng 30 giây"],["1","có thể chỉ hay chọn 5 vật đã biết trong 15 giây"]]],["C20",0,2,"Hồi đáp với các lệnh tìm chọn khác nhau","Học sinh sẽ có thể tìm chọn vật và ảnh khi giáo viên ra các lệnh tìm chọn khác nhau (ví dụ: \"cho cô xem___\", \"cái.... đâu?\", \"con có thấy cái__ không?\", \"hãy chạm vào cái....\")","\"Cho cô xem__\" \"Cái__ ở đâu\" \"Con có thấy cái ___không?\" \"Em có nhìn thấy__\" \"Hãy tìm cái__\"",-1,[["2","tìm chọn được vật và ảnh khi nhận bất cứ 5 yêu cầu tìm chọn nào (hồi đáp bằng hình thức nào cũng được)"],["1","tìm chọn được vật và ảnh khi nhận bất cứ 2 yêu cầu tìm chọn nào (hồi đáp bằng hình thức nào cũng được)"]]],["C21",0,2,"Chỉ các bộ phận cơ thể của người khác hay trong ảnh","Học sinh sẽ có thể theo lệnh chỉ ra các bộ phận trên cơ thể người khác hay trên ảnh về các bộ phận cơ thể","",-1,[["4","ít nhất 10 bộ phận"],["3","6 bộ phận"],["2","4 bộ phận"],["1","3 bộ phận"]]],["C22",0,2,"Chạm vào các loại quần áo của chính mình","Học sinh có thể theo lệnh chạm vào loại quần áo đang mặc","",-1,[["2","ít nhất 4 loại"],["1","2 loại"]]],["C23",0,2,"Sờ từng bộ phận của một vật","Học sinh sẽ theo lệnh sờ 1 bộ phận của vật (VD: cửa sổ và cửa ra vào của một ngôi nhà, bánh xe và cửa xe)","Khi xem ảnh 1 căn nhà, học sinh có thể chỉ vào cửa sổ, cửa lớn, mái nhà",-1,[["4","ít nhất 3 bộ phận của 10 vật"],["3","3 bộ phận của 6 vật"],["2","2 bộ phận của 4 vật"],["1","ít nhất 2 bộ phận của 2 vật"]]],["C24",0,2,"Lấy theo tính chất","Học sinh sẽ có thể lấy ra 1 trong số 2 vật chỉ khác nhau ở 1 điểm (nghĩa là tính chất)","Khối đỏ với khối xanh, to với nhỏ; nóng/lạnh; cũ/ mới; gầy/béo; ướt/khô; nhanh/chậm; ngày/đêm; mềm/cứng…",-1,[["4","lấy vật có ít nhất 20 tính từ (gồm ít nhất 3 màu sắc, 2 hình dáng và 2 kích cỡ)"],["3","ít nhất 10 tính từ (ít nhất 5 trong số đó không phải là màu sắc)"],["2","ít nhất 5 tính từ (có thể tất cả đều là màu sắc)"],["1","lấy được vật có ít nhất 1 tính từ"]]],["C25",0,2,"Lấy vật nhờ quan sát ánh mắt của người khác","Học sinh có thể quan sát ánh mắt của người khác để lấy vật","Khi đặt 1 cái bút, 1 viên phấn và 1 chiếc bút chì màu ở các vị trí khác nhau trên bàn, học sinh sẽ chọn vật mà giáo viên đang nhìn",-1,[["2","có thể chọn 1 trong 3 vật đặt riêng lẻ trên bàn"],["1","có thể chọn 1 trong 2 vật được đặt riêng lẻ trên bàn"]]],["C26",0,2,"Làm theo khi được chỉ tay yêu cầu","HS có thể theo hiệu lệnh tay của 1 người lớn để đi đến, ngồi, đứng, đến 1 nơi, làm 1 hành động (VD: đứng lên hay vỗ tay khi GV chỉ tay yêu cầu)","Học sinh ra cửa khi giáo viên chỉ ra cửa, học sinh vỗ tay khi giáo viên chỉ (ngụ ý đến lượt học sinh đó), học sinh chọn cái tách to khi giáo viên chỉ vào cái to nhất trong số những cái tách ở trên bàn",-1,[["4","hồi đáp chuẩn xác với cả 5 kiểu lệnh chỉ tay"],["3","hồi đáp chuẩn xác với ít nhât 4 kiểu lệnh chỉ tay"],["2","hồi đáp chuẩn xác với ít nhât 3 kiểu lệnh chỉ tay"],["1","hồi đáp chuẩn xác với ít nhât 2 kiểu lệnh chỉ tay"]]],["C27",0,2,"Theo lệnh để đến bên 1 người nào đó","Học sinh sẽ có thể đi ngang qua phòng để lại chỗ 1 người được chỉ định","Học sinh sẽ đi qua phòng khi được yêu cầu \"Ra chỗ Tim đi\".",-1,[["2","có thể lại chỗ ít nhất 4 người theo lệnh"],["1","ít nhất 2 người theo lệnh"]]],["C28",0,2,"Theo lệnh đưa 1 vật cho 1 người nào đó hay đặt vật đó lên 1 vật khác","Học sinh sẽ có thể ngang qua phòng, để hay đưa 1 vật cho 1 người (VD: hãy đưa cái bút này cho Jim)","\"Hãy đưa cái bút này cho Jim\"",-1,[["4","có thể lại chỗ ít nhất 2 người và 2 nơi để đưa hay đặt vật"],["3","2 người hay 2 nơi không nhắc nhở"],["2","2 người hay 2 nơi có nhắc nhở bằng lời"],["1","1 người hay 1 nơi có nhắc nhở bằng lời."]]],["C29",0,2,"Theo lệnh đến chỗ 1 người nào đó và cầm 1 vật nhất định","Học sinh sẽ đi ngang qua phòng để đến 1 nơi hay chỗ 1 người nào đó và lấy vật được chỉ định","\"Đi lấy quyển sách ở bàn làm việc và mang lại đây cho cô\".",-1,[["4","có thể đến ít nhất 2 nơi và lại chỗ 2 người để lấy 1 vật được chỉ định"],["3","2 người hay 2 nơi không nhắc nhở"],["2","2 người hay 2 nơi có nhắc nhở bằng lời"],["1","1 người hay 1 nơi có nhắc nhở bằng lời"]]],["C30",0,2,"Theo lệnh đến chỗ 1 người nào đó và làm 1 hành động","Học sinh sẽ ra khỏi phòng để đến chỗ 1 người nào đó và làm 1 hành động yêu cầu (VD: Hãy ôm Jim)","\"Lại ôm Jim đi\"",-1,[["4","có thể lại chỗ của ít nhất 3 người và làm ít nhất 2 động tác"],["3","2 người và 2 động tác"],["2","2 người và 1 động tác"],["1","1 người và 1 động tác"]]],["C31",0,2,"Hồi đáp bằng các động tác với các bài tập nhận biết","Học sinh sẽ chọn vật và ảnh thông thường bằng một động tác tùy theo yêu cầu tìm chọn (sờ, chỉ, đưa, nhặt lên, lấy...)","\"Sờ vào cái tách\" \"Chỉ con chim\" \"Đưa cô chiếc giày\" \"Nhặt cái mũ lên\" \"Lấy cái đĩa này\" \"Khoác cho con khỉ\" \"Dấu cái thìa này đi\" \"Đẩy xe\"",-1,[["4","hồi đáp chuẩn xác với bất cứ 5 loại yêu cầu tìm chọn nào"],["3","4 yêu cầu tìm chọn"],["2","3 yêu cầu tìm chọn khác nhau"],["1","2 yêu cầu tìm chọn khác nhau"]]],["C32",0,2,"Sử dụng 1 vật trong số nhiều vật đưa ra để thực hiện một hành động","Học sinh sẽ theo lệnh làm 1 động tác đơn giản với 1 vật khi được trao nhiều vật khác nhau, trong đó chỉ có 1 vật đó là phù hợp","ngủ / viết / gõ / cắt / lăn cho cô xem nào\"",-1,[["2","ít nhất 5 hoạt động không nhắc nhở"],["1","ít nhất 2 có nhắc nhở bằng lời hay bằng cử chỉ"]]],["C33",0,2,"Làm nhiều hoạt động với 1 vật","Học sinh sẽ có thể làm 1 động tác nào đó với 1 vật khi có nhiều vật khác cũng phù hợp để làm hành động đó","đập bóng, lăn bóng, ném bóng, chải tóc, chải lông cho chó",-1,[["4","có thể làm ít nhất 4 hoạt động với ít nhất 4 vật"],["3","ít nhất 3 hoạt động với 4 vật"],["2","ít nhất 2 hoạt động với 4 vật"],["1","ít nhất 2 hoạt động với 2 vật"]]],["C34",0,2,"Giả vờ làm một hành động","Học sinh sẽ có thể theo lệnh làm 1 hoạt động giả vờ","Cười / khóc / ngáp / ngủ / viết / gõ /cắt / lăn cô xem",-1,[["2","ít nhất 5 hành động không cần nhắc"],["1","ít nhất 2 hoạt động có nhắc nhở bằng lời hay cử chỉ"]]],["C35",0,2,"Lấy 1 trong số 3 ảnh diễn tả hoạt động","Theo lệnh, học sinh sẽ lấy ảnh về 1 hoạt động nào đó từ chuỗi 3 ảnh bày trên bàn ở các vị trí khác nhau trước mặt học sinh","cho xem ảnh 1 cậu bé đang viết, đá và ăn và yêu cầu lấy tranh \"viết\", học sinh sẽ lấy ảnh cậu bé đang viết",-1,[["4","lấy ít nhất 20 ảnh về các hoạt động và có thể chỉ ra vài ví dụ khác nhau (gồm ví dụ mới) cho hầu hết các hoạt động đó"],["3","10 hoạt động"],["2","5 hoạt động"],["1","2 ảnh hoạt động"]]],["C36",0,2,"Lấy ra những ảnh có liên quan","đưa nhiều vật hay ảnh vật và hỏi \"Cái gì đi với cái này?\", học sinh sẽ có thể lấy vật đi đôi với vật giơ ra. (VD: lấy ảnh cái vợt khi giơ ảnh 1 quả bóng)","lưới và bóng, cốc và nước trái cây, tất và giày, dao/dĩa và thìa, áo và mũ",-1,[["4","có thể lấy ít nhất 2 ảnh có liên quan trong ít nhất 20 vật bày ra"],["3","2 ảnh liên quan trong số 10 vật"],["2","1 ảnh liên quan trong số 10 vật"],["1","1 ảnh liên quan trong số 5 vật"]]],["C37",0,2,"Lấy theo chức năng","Học sinh có thể lấy vật hay ảnh vật khi biết chức năng của nó","Khi xem ảnh về cái kéo, giày, ngựa và được hỏi: \"Em cắt bằng gì?\", học sinh sẽ trả lời kéo.",-1,[["4","có thể lấy ít nhất 25 đồ vật khi biết chức năng của chúng VÀ có thể lấy ít nhất 2 vật với 1 chức năng trong số ít nhất 6 vật bày ra"],["3","ít nhất 25 vật"],["2","ít nhất 5 vật"],["1","ít nhất 2 vật"]]],["C38",0,2,"Lấy theo đặc tính","Học sinh sẽ có thể lấy vật và ảnh vật khi biết về đặc tính hay các bộ phận của chúng","Khi xem ảnh về 1 cái kéo giày, và ngựa và được hỏi \"vật nào có đuôi?\" học sinh sẽ lấy ngựa",-1,[["4","lấy 25 vật với ít nhất 2 đặc tính hay bộ phận VÀ có thể lấy ít nhất 2 vật với 1 đặc tính hay bộ phận từ ít nhất 6 vật"],["3","lấy 25 vật với ít nhất 2 đặc tính hay bộ phận"],["2","lấy 5 vật với ít nhất 1 đặc tính hay bộ phận"],["1","lấy 2 vật có ít nhất 1 đặc tính hay bộ phận"]]],["C39",0,2,"Lấy theo loại","Học sinh sẽ có thể lấy vật hoặc ảnh vật khi biết chủng loại của chúng","Khi xem ảnh, 1 cái kéo, 1 chiếc giày, và 1 con ngựa và được hỏi \"em mang gì?\" học sinh sẽ trả lời \"giày\".",-1,[["4","có thể lẩy ít nhất 5 vật thuộc 4 loại VÀ có thể lấy ít nhất 2 vật cùng loại từ ít nhất 6 vật bày ra"],["3","ít nhất 5 vật thuộc 4 loại"],["2","ít nhất 5 vật thuộc 2 loại"],["1","ít nhất 5 vật thuộc 1 loại"]]],["C40",0,2,"Lấy 2 vật từ 1 loạt nhiều đồ vật","Theo lệnh, học sinh sẽ lấy 2 vật hay 2 ảnh từ 1 loạt nhiều đồ vật ở trên bàn trước mặt học sinh theo chỉ định","Khi để 1 loạt nhiều đồ vật thường lên bàn và học sinh được lệnh lấy giày và cốc đưa cho giáo viên, học sinh sẽ nhặt giày và cốc",-1,[["2","có thể lấy 2 vật hay ảnh theo chỉ định trong 1 loạt từ 10 vật trở lên"],["1","có thể lấy 2 vật hay ảnh theo chỉ định trong 1 loạt từ 4 vật trở lên"]]],["C41",0,2,"Lấy 2 vật theo thứ tự từ 1 loạt nhiều đồ vật","Theo lệnh, học sinh sẽ lấy 2 vật hay ảnh nào đó theo thứ tự yêu cầu từ 1 loạt nhiều ảnh ở trên bàn trước mặt học sinh","Để 10 đồ vật hay ảnh về đồ vật thông thường trên bàn. Khi nghe lệnh đưa giày và cốc học sinh sẽ nhặt ảnh giày và cốc theo thứ tự đó",-1,[["2","có thể lấy 2 vật theo thứ tự chỉ định từ 1 loạt ít nhất 10 ảnh"],["1","có thể lấy 2 vật theo thứ tự chỉ định từ 1 loạt ít nhất 4 ảnh"]]],["C42",0,2,"Chọn ra nhân viên công ích / phục vụ cộng đồng","Học sinh sẽ có thể chọn lấy ra ảnh nhân viên công ích ở quanh mình","giáo viên, cảnh sát, lính cứu hỏa, bác sĩ, công nhân",-1,[["4","chọn ảnh của ít nhất 4 nhân viên công ích"],["3","3"],["2","2"],["1","1"]]],["C43",0,2,"Tìm ra đồ vật trong 1 ảnh lớn, nhiều chi tiết","Học sinh sẽ có thể tìm ra ảnh ảnh vật trong 1 ảnh lớn, nhiều chi tiết","Tìm tất cả những con cá trong 1 ảnh chụp dưới nước",-1,[["2","có thể tìm ra ít nhất 3 trong 4 vật có ít nhất 10 vật khác"],["1","có thể tìm ít nhất 2 trong 4 vật trong 1 ảnh có ít nhất 5 vật khác nhau"]]],["C44",0,2,"Tìm vật khi cho xem một phần của vật trong một ảnh lớn, nhiều chi tiết","Học sinh sẽ có thể tìm ra vật khi thấy 1 phần của vật đó trong 1 ảnh lớn và nhiều chi tiết","Tìm ra tất cả các con cá khi chỉ được xem 1 phần của con cá (VD: đầu hay đuôi cá) trong ảnh chụp dưới nước.",-1,[["2","có thể tìm ra ít nhất 3 trong 4 vật trong 1 ảnh lớn có ít nhất 10 vật khác"],["1","có thể tìm ra ít nhất 2 trong 4 vật trong 1 ảnh có ít nhất 5 vật khác nữa"]]],["C45",0,2,"Tìm ra âm thanh quen thuộc từ môi trường tự nhiên","Học sinh sẽ có thể chọn ra ảnh tương ứng với âm thanh của một vật","Dụng cụ, máy móc, cưa, khoan, báo động: còi xe, còi tàu, còi xe cứu thương, còi xe cảnh sát, động vật, sự kiện, hành động, tiệc sinh nhật, trận đấu bóng, tàu, máy bay",-1,[["4","ít nhất 8 âm thanh"],["3","ít nhất 6 âm thanh"],["2","ít nhất 4 âm thanh"],["1","ít nhất 2 âm thanh"]]],["C46",0,2,"Chọn tất cả các ví dụ của 1 vật","Học sinh sẽ theo lệnh chọn tất cả những ví dụ cho 1 vật nhất định khi được yêu cầu (VD: tất cả những con mèo)","\"Đưa cho cô tất cả những con chó\"",-1,[["4","6 vật giống nhau từ ít nhất 15 vật"],["3","3 vật từ ít nhất 10 đồ vật"],["2","3 vật từ ít nhất 6 vật"],["1","ít nhất 2 vật giống nhau từ ít nhất 4 vật"]]],["C47",0,2,"Lấy ra 1 vật có 2 đặc tính nhất định","Khi được đưa nhiều vật hay ảnh vật khác nhau, học sinh sẽ có thể chọn lấy ra 1 vật có 2 đặc tính nhất định theo yêu cầu (VD: quả bóng đỏ to, cốc lúa mạch nóng)","Quả bóng đỏ to, Bát lúa mạch nóng Đồ đi ở chân",-1,[["4","20 vật với 2 đặc tính"],["3","10 vật với 2 đặc tính"],["2","5 vật với 2 đặc tính"],["1","2 vật với 2 đặc tính"]]],["C48",0,2,"Chọn 1 nhóm vật có chung 1 đặc tính nào đó","Khi được đưa 1 nhóm các vật hay ảnh vật chỉ khác nhau ở 1 đặc tính, học sinh sẽ có thể chọn lấy ra những vật có chung 1 đặc tính (VD: tính từ như \"những cái màu đỏ\")","những thứ màu đỏ, những cái có lỗ, những cái nhăn/ phẳng; bẩn/sạch; những cái mới/cũ",-1,[["4","lấy được vật có chung ít nhất 20 tính từ (gồm ít nhất 3 màu sắc, 2 hình dáng, 2 kích cỡ)"],["3","ít nhất 10 tính từ (ít nhất 5 trong số đó không phải màu sắc)"],["2","ít nhất 5 tính từ (có thể tất cả đều là màu sắc)"],["1","ít nhất 1 tính từ"]]],["C49",0,2,"Chọn 1 nhóm vật có chung 2 đặc tính nào đó","Khi được đưa 1 nhóm vật / ảnh vật, học sinh có thể chọn tất cả các vật có 2 đặc tính chung (ví dụ: các tính từ, bộ phận, đặc tính, chức năng, chủng loại)","những vật to màu đỏ, những vật màu xanh có lỗ; những chiếc xe hơi to; những vật màu xanh nhỏ; những đồ ăn màu đỏ",-1,[["4","lấy được 20 lần các vật có 2 đặc tính chung"],["3","10 lần có 2 đặc tính chung"],["2","5 lần có 2 đặc tính chung"],["1","2 lần có 2 đặc tính chung"]]],["C50",0,2,"Thực hiện yêu cầu có trình tự nhiều bước","Học sinh sẽ có thể chọn lấy 3 vật theo thứ tự nhất định","\"Sờ giầy, rồi sờ tất\"",-1,[["2","chọn lấy đúng 3 vật theo thứ tự nhất định sau khi nói tên tất cả các vật đó"],["1","chọn lấy đúng 2 vật theo thứ tự nhất định sau khi nói tên tất cả các vật đó"]]],["C51",0,2,"Nhận ra các giới từ","Học sinh biết lựa chọn liên quan đến giới từ khi yêu cầu","lấy cho cô cái ở trên bàn - chỉ cho cô con chim ở dưới hiên nhà",-1,[["4","ít nhất 6 giới từ"],["3","ít nhất 5 giới từ"],["2","ít nhất 3 giới từ"],["1","ít nhất 2 giới từ"]]],["C52",0,2,"Nhận ra các đại từ","Học sinh biết lựa chọn liên quan đến đại từ khi yêu cầu","Chỉ cô mũ của mẹ - lấy cô tranh bà/ông/",-1,[["4","ít nhất 8 đại từ"],["3","ít nhất 4 đại từ"],["2","ít nhất 3 đại từ"],["1","ít nhất 2 đại từ"]]],["C53",0,2,"Chọn lấy ảnh về nơi chốn hay hoạt động ở một nơi","Học sinh có thể chọn lấy ảnh về phong cảnh hay sinh hoạt","Nhà đang cháy, xe cứu hỏa, kéo vòi nước, phun nước vào nhà, cảnh 1 bãi biển, 1 bữa tiệc sinh nhật, 1 buổi cắm trại, 1 trận đấu bóng, 1 cuộc diễu hành, 1 cửa hàng tạp hóa, 1 buổi biểu diễn xiếc",-1,[["2","chọn lấy được ít nhất 4 ảnh về nơi chốn hay sinh hoạt"],["1","chọn lấy được ít nhất 2 ảnh về nơi chốn hay sinh hoạt"]]],["C54",0,2,"Chọn lấy ảnh về cảm xúc","Học sinh có thể chọn lấy ảnh khuôn mặt biểu thị nhiều cảm xúc","vui sướng, buồn, ngạc nhiên, sợ hãi, giận, sợ sệt ...",-1,[["4","ít nhất 4 cảm xúc"],["3","ít nhất 3 cảm xúc"],["2","ít nhất 2 cảm xúc"],["1","ít nhất 1 cảm xúc"]]],["C55",0,2,"Lấy ra vật \"giống\" và \"khác\"","Khi bày ra 2 vật, sau đó đưa tiếp vật thứ 3 giống 1 trong 2 vật kia và yêu cầu \"tìm vật giống như vậy\" hay \"tìm vật khác vật này\", học sinh sẽ lấy được vật tương ứng trong số vật bày ra","",-1,[["2","có thể chon được cả vật giống và khác khi 2 vật bày ra chỉ khác nhau ở 1 điểm"],["1","có thể chon được cả vật giống và khác khi 2 vật bày ra khác nhau ở ít nhất 2 điểm"]]],["C56",0,2,"Lấy ra vật không cùng chủng loại","Học sinh có thể chỉ hay lấy ra vật không cùng loại với một nhóm vật (ví dụ: không phải thực phẩm, không phải màu vàng, không dùng để nấu, không có đuôi)","Khi đang xem sách và được yêu cầu chỉ vào cái không phải là thức ăn, học sinh sẽ chỉ vào ảnh chiếc xe hơi",-1,[["4","ít nhất 3 ví dụ thuộc 10 loại (liên quan đến chức năng, đặc tính, loại)"],["3","3 ví dụ thuộc ít nhất 5 loại"],["2","3 ví dụ thuộc ít nhất 3 loại"],["1","3 ví dụ thuộc ít nhất 2 loại"]]],["C57",0,2,"Chọn lấy ảnh về tình huống giao tiếp xã hội","Học sinh có thể chọn lấy ảnh về tình huống giao tiếp xã hội (ví dụ: đang chơi, đang cãi nhau)","ngượng, tranh cãi, đánh nhau, trò chuyện, trêu trọc, vui chơi, làm việc, thực hành, bận rộn, giận, thân thiện, căng thẳng, vui nhộn.",-1,[["4","chọn lấy ảnh về ít nhất 4 tình huống giao tiếp xã hội"],["3","chọn lấy ít nhất 3 tình huống giao tiếp xã hội"],["2","chọn lấy ít nhất 2 tình huống giao tiếp xã hội"],["1","chọn lấy ít nhất 1 tình huống giao tiếp xã hội"]]],["D1",2,3,"Bắt chước động tác với đồ vật","Theo lệnh, học sinh sẽ bắt chước 1 động tác với đồ vật","Làm bộ uống từ tách, đẩy xe dọc tay vịn cầu thang",-1,[["4","ít nhất 10 động tác với 2 động tác khác nhau mỗi vật"],["3","10 động tác"],["2","5 động tác"],["1","2 động tác"]]],["D2",2,3,"Bắt chước động tác cơ bắp với đồ vật có ý thức phân biệt","Theo lệnh , học sinh sẽ lặp lại 1 động tác cơ bắp yêu cầu có phân biệt đồ vật","HS có 1 cây bút và 1 cái thìa, cho cây bút vào cốc, HS sẽ bắt chước làm theo khi yêu cầu",-1,[["4","ít nhất 10 động tác và sẵn sàng bắt chước động tác mới"],["3","10 động tác"],["2","5 động tác"],["1","2 động tác"]]],["D3",2,3,"Bắt chước các vận động thô bằng cơ bắp khi nhắc bằng lời","Học sinh sẽ bắt chước vận động tác thô bằng cơ bắp khi được nhắc bằng lời","Nhảy lên, vỗ tay",-1,[["4","ít nhất 10 động tác và sẵn sàng bắt chước động tác mới"],["3","10 động tác"],["2","5 động tác"],["1","2 động tác"]]],["D4",2,3,"Bắt chước các động tác chân và đùi","Theo lệnh, học sinh sẽ lặp lại 1 động tác cơ bắp với chân và đùi","Dậm chân",-1,[["4","ít nhất 10 động tác và sẵn sàng bắt chước động tác mới"],["3","10 động tác"],["2","5 động tác"],["1","2 động tác"]]],["D5",2,3,"Bắt chước các động tác với bàn tay và cánh tay","Theo lệnh, HS sẽ bắt chước các động tác thô bằng cơ bắp với bàn tay và cánh tay","đưa tay lên và xuống dọc bên hông",-1,[["4","ít nhất 10 động tác và sẵn sàng bắt chước động tác mới"],["3","10 động tác"],["2","5 động tác"],["1","2 động tác"]]],["D6",2,3,"Bắt chước cả động tác cần di chuyển cơ thể và không cần di chuyển","Theo lệnh, HS sẽ lặp lại các động tác gần giống nhau đòi hỏi học sinh biết phân biệt đó là động tác cần di chuyển hay không cần","Đập tay xuống bàn và để tay trên bàn, vỗ tay và úp hai lòng bàn tay lại, đập chân xuống vòng tròn với đặt chân vào trong vòng tròn",-1,[["4","ít nhất 10 cặp động tác và sẵn sàng lặp lại nhiều động tác mới"],["3","10 cặp"],["2","2 cặp"],["1","2 cặp các động tác giống nhau, 1 động tác cần di chuyển, 1 không"]]],["D7",2,3,"Dùng các lệnh khác nhau yêu cầu học sinh bắt chước","Học sinh sẽ bắt chước các động tác dù ta có dùng các câu lệnh khác nhau yêu cầu bắt chước","Lặp lại theo mẫu khi được lệnh \"xem cô này, đến lượt con\"; \"làm như cô làm này\", \"làm theo cô\", \"Em thứ làm đi\", \"Đến lượt cô, và bây giờ con làm\" hay \"làm như thế này nhé\"",-1,[["2","làm theo các động tác khi dùng 1 trong 4 câu lệnh khác nhau yêu cầu HS bắt chước"],["1","làm theo các động tác khi dùng 1 trong ít nhất 2 câu lệnh khác nhau yêu cầu HS bắt chước"]]],["D8",2,3,"Bắt chước các động tác thô bằng cơ bắp được làm mẫu trong gương","Theo lệnh, học sinh sẽ lặp lại các động tác thô bằng cơ bắp đã quan sát thấy qua gương","học sinh đặt tay lên đầu, vỗ tay, xoa bụng ...",-1,[["4","ít nhất 10 động tác và sẵn sàng bắt chước động tác mới"],["3","10 động tác"],["2","5 động tác"],["1","2 động tác"]]],["D9",2,3,"Bắt chước các động tác đầu","Theo lệnh, học sinh sẽ lặp lại 1 động tác vận động thô với đầu","Lắc đầu qua lại",-1,[["2","lặp lại 3 động tác"],["1","1 động tác"]]],["D10",2,3,"Bắt chước các động tác với lưỡi, miệng","Theo lệnh, học sinh sẽ lặp lại 1 động tác với lưỡi và miệng","Thè lưỡi ra liếm",-1,[["2","lặp lại 4 động tác"],["1","lặp lại 2 động tác"]]],["D11",2,3,"Làm theo động tác với mặt/miệng làm mẫu trong gương","Theo lệnh, học sinh có lặp lại các động tác mặt, miệng khi xem mẫu trong gương","Há mồm, bặm môi vào nhau, thè lưỡi, đưa lưỡi qua lại, đặt môi ở vị trí thổi; phồng má, giương mày, chớp mắt",-1,[["4","ít nhất 6 động tác mặt, miệng (gồm cả động tác tĩnh và động)"],["3","6 động tác bất kỳ"],["2","4 động tác bất kỳ"],["1","2 động tác với miệng/mặt bất kỳ"]]],["D12",2,3,"Bắt chước động tác vận động tinh","Theo lệnh, học sinh sẽ lặp lại 1 đông tác vận động tinh","Chạm đầu 2 ngón trỏ vào nhau",-1,[["4","ít nhất 10 động tác và sẵn sàng lặp lại những động tác mới"],["3","10 động tác"],["2","5 động tác"],["1","2 động tác"]]],["D13",2,3,"Bắt chước chạm tay vào các đồ vật theo thứ tự","Theo lệnh, học sinh sẽ bắt chước chạm tay vào đồ vật theo thứ tự cùng lúc với người làm mẫu","Với loạt 4 vật, học sinh sẽ làm theo mẫu lần lượt chạm tay vào xe hơi, sau đó là giày, rồi đến tách và cuối cùng là ngựa",-1,[["2","có thể lặp lại động tác chạm tay vào 4 trong 6 đồ vật theo bất kì thứ tự nào"],["1","có thể chạm vào 2 trong 4 vật theo bất cứ thứ tự nào"]]],["D14",2,3,"Bắt chước thổi","Theo lệnh, học sinh sẽ lặp lại động tác thổi ngắn và dài theo mẫu","học sinh làm động tác thổi đơn giản và động tác thổi kéo dài 2 giây...",-1,[["2","bắt chước cả thổi ngắn và thổi dài trong ít nhất 2 giây"],["1","có thể bắt chước thổi ngắn hoặc thổi dài"]]],["D15",2,3,"Bắt chước một động tác đang diễn ra với cùng tốc độ","Theo lệnh, học sinh sẽ lặp lại 1 động tác đang diễn ra với 1 vật đúng tốc độ đang làm mẫu","Bắt chước vận tốc của người làm mẫu di chuyển 1 vật (ví dụ: lắc con lục lặc nhanh hay chậm cùng 1 lúc với người làm mẫu)",-1,[["2","sẵn sàng lặp lại động tác theo tốc độ của người làm mẫu"],["1","chỉ cần nhắc 1 lần"]]],["D16",2,3,"Bắt chước tốc độ của 1 động tác với đồ vật vừa làm mẫu xong","Theo lệnh, học sinh sẽ lặp lại 1 động tác với 1 vật đúng bằng tốc độ vừa làm mẫu xong","Ngay sau khi xem mẫu, học sinh sẽ lặp lại 1 động tác theo đúng tốc độ vừa làm mẫu xong để di chuyển 1 vật (ví dụ: lắc lục lạc nhanh hay chậm)",-1,[["2","sẵn sàng lặp lại các động tác theo tốc độ của người làm mẫu vừa làm"],["1","cần nhắc 1 lần để làm theo"]]],["D17",2,3,"Lặp lại tốc độ của 1 động tác","Theo lệnh, học sinh sẽ lặp lại một động tác cơ bắp để theo vận tốc của người làm mẫu","Đưa tay lên xuống dọc hông nhanh hay chậm",-1,[["2","Sẵn sàng lặp lại các động tác của người làm mẫu"],["1","Đòi hỏi có nhắc nhở bằng lời"]]],["D18",2,3,"Bắc chước chạm tay vào một chuỗi vật theo mẫu","Theo lệnh, học sinh sẽ bắt chước chạm tay vào chuỗi đồ vật theo mẫu","Khi đưa một loạt 4 đồ vật, học sinh sẽ chạm tay vào ô tô, giày, chén và sau đó là ngựa đúng theo trình tự làm mẫu",-1,[["2","Có thể bắt chước chạm vào 4 trong 6 vật theo bất kỳ thứ tự nào theo bất kỳ thứ tự nào ngay sau khi xem mẫu"],["1","Có thể bắt chước chạm tay vào 2 trong 4 vật theo bất kỳ thứ tự nào ngay sau khi xem mẫu"]]],["D19",2,3,"Bắt chước chuỗi động tác và chuyển động tác theo người làm mẫu","Theo lệnh \"làm thế này\", học sinh sẽ lặp lại chuỗi các hoạt động theo mẫu, ngay lập tức chuyển từ 1 hoạt động này sang 1 hoạt động khác theo lệnh của giáo viên","Vỗ tay, lắc tay, xoa tay, đập đùi, sau đó chuyển ngay từ động tác này sang động tác khác khi giáo viên thay đổi động tác",-1,[["2","Có thể lặp lại chuỗi 6 động tác khác nhau theo mẫu trong 10 giây"],["1","Có thể lặp lại 1 chuỗi 4 động tác theo mẫu trong 10 giây"]]],["D20",2,3,"Lặp lại 1 chuỗi các động tác","Theo lệnh, học sinh sẽ lặp lại 1 chuỗi các động tác","Vỗ tay, rồi đập đùi",-1,[["4","Ít nhất 10 chuỗi 2 động tác và sẵn sàng lặp lại nhiều chuỗi mới"],["3","10 chuỗi 2 động tác"],["2","5 chuỗi 2 động tác"],["1","2 chuỗi 2 động tác sau khi xem mẫu"]]],["D21",2,3,"Bắt chước cường độ của động tác","Theo lệnh, học sinh sẽ lặp lại một động tác cơ bắp theo đúng cường độ của ngưòi làm mẫu","Đập mạnh/nhẹ xuống bàn, vỗ tay mạnh/nhẹ. Lưu ý: vỗ tay mạnh/nhẹ có thể được coi là vỗ nhanh/chậm",-1,[["2","Sẵn sàng lặp lại các động tác theo cường độ của người làm mẫu"],["1","cần phải nhắc bằng lời"]]],["D22",2,3,"Lặp lại đúng số lần thực hiện một động tác","Theo lệnh, học sinh sẽ lặp lại một động tác đúng số lần của động tác mẫu","dùng dùi gõ trống 1 lần/3 lần",-1,[["2","lặp lại 3 lần một động tác mà không cần nhắc"],["1","lặp lại được 3 lần nhưng phải nhắc bằng lời hoặc cử chỉ"]]],["D23",2,3,"Bắt chước đồng thời 1 động tác đi kèm lời nói","Theo lệnh, học sinh sẽ lặp lại 1 động tác kèm lời nói","Vẫy tay trên cao, và nói \"vun vút,vun vút,vun vút\", làm động tác ru bé ngủ và nói \"à í à ơi\"",-1,[["2","lặp lại đến 3 lần lặp lại ít nhất 4 động tác kèm với lời nói không nhắc"],["1","lặp lại ít nhất 1 động tác kèm lời nói mà không cần nhắc"]]],["D24",2,3,"Bắt chước chuỗi các hoạt động cơ bắp với nhiều đồ vật","Theo lệnh, học sinh sẽ lặp lại 1 chuỗi các động tác với nhiều đồ vật","Khi đưa ra 1 xe tải đồ chơi, 1 hộp nhỏ, 1 khối hình màu đỏ, xanh, vàng và trắng, học sinh sẽ lặp lại động tác đặt khối xanh lên khối trắng, rồi đặt khối đỏ vào hộp và khối vàng phía sau xe tải",-1,[["2","Có thể lặp lại ít nhất 6 chuỗi gồm 3 động tác với 4 vật có vật mẫu trước mặt"],["1","Có thể lặp lại ít nhất 6 chuỗi gồm ít nhất 2 động tác với 4 đồ vật theo mẫu hiện diện"]]],["D25",2,3,"Bắt chước động tác cơ bắp mà không cần nhắc trực tiếp","Không cần ra lệnh lặp lại từng động tác, học sinh sẽ lặp lại những động tác dễ theo mẫu, chỉ để được khen vì đã biết lặp lại các động tác đó","Bắt chước một loạt các động tác đầu, mặt mà người khác đang làm",-1,[["4","ít nhất 10 động tác và sẵn sàng lặp lại những động tác mới"],["3","10 động tác"],["2","5 động tác"],["1","2 động tác"]]],["D26",2,3,"Tự động bắt chước các động tác của người khác","Học sinh có thể lặp lại ngay các động tác cơ bắp của người khác không đứng trước mặt mình","Quan sát và làm theo người khác. Ví dụ: tất cả cùng nhảy, vỗ tay, đứng, ngồi, tay chống hông",-1,[["4","Ít nhất 10 động tác và sẵn sàng lặp lại những động tác mới (không nhất thiết phải làm liền một mạch 10 động tác)"],["3","10 động tác"],["2","5 động tác"],["1","2 động tác"]]],["D27",2,3,"Bắt chước sau một thời gian ngắt quãng","Khi được yêu cầu, hoặc khi nói tên một hành động, HS sẽ thể hiện hành động đã quan sát được vài tiếng trước đó","\"Đây là những gì con sư tử làm\" hay \"cho cô xem nàng Bạch tuyết cọ sàn nhà như thế nào\"",-1,[["4","Gọi tên và lặp lại nhiều động tác đã thấy cách đó 4 tiếng"],["3","Gọi tên và lặp lại sau 1 tiếng"],["2","Gọi tên và lặp lại sau 10 phút"],["1","Theo lệnh, 1 hành động sau 5 phút"]]],["E1",1,4,"Lặp lại âm thanh theo lệnh","Học sinh có thể lặp lại 1 âm thanh khi nghe lệnh \"Nói..........\"","",-1,[["4","Sẵn sàng lặp lại chính xác hầu hết các âm"],["3","15 âm"],["2","5 âm"],["1","2 âm"]]],["E2",1,4,"Lặp lại chuỗi từng âm thanh, và chuyển âm theo người làm mẫu","Học sinh sẽ có thể lặp lại 1 chuỗi các âm, liên tiếp chuyển từ âm này sang âm khác","Học sinh lặp lại liên tiếp từ âm thanh sang âm thanh khác với tốc độ cao (Ví dụ: nói \"may\", \"moe\", \"me\", \"ah\", \"buh\", \"ee\", \"oh\")",-1,[["2","Có thể lặp lại ít nhất 10 âm riêng biệt trong 15 giây"],["1","Có thể lặp lại ít nhất 5 âm riêng biệt trong 10 giây"]]],["E3",1,4,"Lặp lại âm đầu của từ","Khi đọc mẫu 1 từ cho học sinh, học sinh sẽ có thể lặp lại âm đầu của từ đó","Với từ \"Bat\" nói là \"ba\", từ \"Shoe\" nói là \"Sh\", \"apple\" nói là \"ap\", từ \"up\" nói là \"ich\"",-1,[["4","Sẵn sàng lặp lại chính xác ít nhất âm đầu của hầu như tất cả các từ"],["3","15 âm"],["2","5 âm"],["1","2 âm"]]],["E4",1,4,"Bắt chước các cách kết hợp âm","Học sinh sẽ có thể bắt chước các cách kết hợp âm đòi hỏi học sinh phải chú ý đến cả 2 âm","Nói \"ma\" \"ma\", \"ma\" \"me\", \"ma\" \"moe\". Nói \"ee\" \"o\"; \"ee\" \"ee\" và \"ee\" \"ah\"",-1,[["2","Có thể nhắc lại ít nhất 4 cặp kết hợp âm với ít nhất 4 âm đầu"],["1","có thể nhắc lại ít nhất 3 cặp kết hợp âm với ít nhất 2 âm đầu"]]],["E5",1,4,"Bắt chước lặp lại các âm ngắn và bật hơi nhanh; kéo dài và giữ hơi lâu","Học sinh có thể lặp lại âm đúng tốc độ của âm đọc mẫu","Nói \"mm\" và \"mmmm\"",-1,[["2","Sẵn sàng lặp lại âm đúng tốc độ của người làm mẫu"],["1","cần nhắc bằng cử chỉ"]]],["E6",1,4,"Lặp lại 1 âm đúng số lần đọc mẫu","Theo lệnh, học sinh sẽ lặp lại 1 âm thanh đúng số lần đọc mẫu","Nói \"ah\" 1 lần và \"ah\" \"ah\" \"ah\"",-1,[["2","lặp lại được tối đa 3 lần theo đúng số lần đọc mẫu không cần nhắc"],["1","lặp lại khi được nhắc bằng cử chỉ"]]],["E7",1,4,"Bắt chước đọc kéo dài âm đầu nối tiếp sang âm thứ 2","Học sinh có thể lặp lại một tổ hợp âm, trong đó giáo viên yêu cầu học sinh phải giữ hay kéo dài âm đầu và đọc nối sang âm thứ 2 một cách trơn tru (chứ không đọc rời 2 âm)","Nói \"mmmeeee\" chuyển từ âm \"mm\" sang âm \"eee\" một cách trơn tru (chứ không đọc rời rạc thành 2 âm \"mm\"....\"eee\" \"aaaaammmm\" là \"am\" được đọc kéo dài",-1,[["2","Có thể đọc kéo dài từ ít nhất 4 âm đầu nối sang ít nhất 4 âm tiếp theo"],["1","Có thể đọc kéo dài từ ít nhất 2 âm đầu nối sang ít nhất 2 âm tiếp theo"]]],["E8",1,4,"Bắt chước các tổ hợp phụ âm - nguyên âm; nguyên âm - phụ âm","Học sinh có thể bắt chước các tổ hợp phụ âm - nguyên âm và nguyên âm-phụ âm (vd \"đi\", \"ma\" và \"ăn\", \"ao\" \"em\")","đi, ma, ăn, ao, em",-1,[["2","Có thể bắt chước 3 tổ hơp nguyên âm - phụ âm VÀ 3 tổ hợp phụ âm - nguyên âm mà không bị đứt quãng giữa các âm"],["1","Có thể bắt chước 3 tổ hơp nguyên âm - phụ âm HOẶC 3 tổ hợp phụ âm - nguyên âm mà không bị đứt quãng giữa các âm"]]],["E9",1,4,"Tổ hợp phụ âm-nguyên âm-phụ âm-nguyên âm","Học sinh có thể bắt chước các tổ hợp phụ âm - nguyên âm - phụ âm - nguyên âm (Ví dụ: \"mama\" \"dada\" \"peepee\" \"meme\")","mama, dada, peepee, meme, booboo, byebye",-1,[["2","Có thể nhắc lại ít nhất 6 tổ hợp kiểu này mà không bị ngắt quãng giữa các âm"],["1","Có thể nhắc lại ít nhất 3 tổ hợp kiểu này mà không bị ngắt quãng giữa các âm"]]],["E10",1,4,"Tổ hợp phụ âm - nguyên âm - phụ âm","Học sinh có thể nhắc lại các tổ hợp phụ âm-nguyên âm-phụ âm theo mẫu","nằm, canh, nhất, lớn",-1,[["2","Có thể nhắc lại ít nhất 12 tổ hợp kiểu này mà không bị ngắt quãng giữa các âm"],["1","Có thể nhắc lại ít nhất 3 tổ hợp kiểu này mà không bị ngắt quãng giữa các âm"]]],["E11",1,4,"Bắt chước các cặp phụ âm ghép","Học sinh có thể nhắc lại chính xác những từ có cặp phụ âm ghép theo mẫu hay không?","2 phụ âm ghép \"tr\" 3 phụ âm ghép \"ng\"",-1,[["4","Sẵn sàng lặp lại chính xác hầu hết các từ có phụ âm ghép"],["3","15 từ"],["2","5 từ"],["1","2 từ"]]],["E12",1,4,"Lặp lại các từ theo lệnh","Học sinh có thể lặp lại 1 từ khi giáo viên đưa lệnh \"Hãy nói..........\"","",-1,[["4","Sẵn sàng và lặp lại chính xác hầu hết các từ"],["3","gần chính xác 15 từ"],["2","gần chính xác 5 từ"],["1","gần chính xác 2 từ"]]],["E13",1,4,"Lặp lại cụm từ theo lệnh","Học sinh có thể lặp lại 1 cụm từ theo lệnh khi giáo viên yêu cầu \"Nói...........\"","",-1,[["4","Sẵn sàng lặp lại chính xác cụm từ gồm ít nhất 6 từ"],["3","Câu 4 từ"],["2","Câu 3 từ"],["1","Câu 2 từ"]]],["E14",1,4,"Lặp lại các chuỗi số theo lệnh","Học sinh có thể lặp lại các chuỗi số theo lệnh \"Nói.....\"","Nhắc lại số điện thoại",-1,[["4","Sẵn sàng và lặp lại chính xác chuẩn gồm ít nhất 7 số từ"],["3","4 số"],["2","3 số"],["1","2 số"]]],["E15",1,4,"Lặp lại các từ ngắn, nhanh >< kéo dài, chậm","Học sinh có thể lặp lại các từ theo tốc độ của người đọc mẫu","Hãy nói từ \"Movie\" ở mức vừa, chậm như: \"mooooveeee\" và nhanh",-1,[["2","Có thể nhắc lại các từ nhanh VÀ chậm hơn bình thường"],["1","Có thể nhắc lại nhanh HOẶC chậm hơn bình thường"]]],["E16",1,4,"Bắt chước nói to/nhỏ các từ/âm theo mẫu","Học sinh có thể lặp lại từ đúng âm lượng đọc mẫu","Nói to/nhỏ từ \"apple\"",-1,[["2","Sẵn sàng lặp lại từ đúng âm lượng của người đọc mẫu"],["1","cần nhắc nhở bằng cử chỉ"]]],["E17",1,4,"Lặp lại từ/âm ở cao độ khác nhau","Học sinh có thể lặp lại các từ đúng cao độ/âm điệu của người đọc mẫu","Nói \"apple\" với cao độ khác nhau",-1,[["2","Sẵn sàng lặp lại đúng cao độ/âm điệu đọc mẫu"],["1","cần nhắc nhở bằng cử chỉ"]]],["E18",1,4,"Nhắc lại lời nhắn ngắn cho 1 người khác","H/s sẽ có thể đi đến một người nào đó và nhắc lời nhắn ngắn của một người khác","Mẹ bảo con nói với bố \"Con muốn piza\" và con sẽ đi đến chỗ bố và nói \"Con muốn piza\"",-1,[["2","Có thể chuyển lời nhắn 3 từ đến một người đứng cách đó ít nhất 10 feet"],["1","Có thể chuyển lời nhắn 2 từ đến một người đứng cách đó ít nhất 5 feet"]]],["E19",1,4,"Tự động nói theo các từ","H/s có thể tự nói theo các từ","",-1,[["4","nói theo chính xác ít nhất 20 từ mỗi ngày"],["3","15 từ"],["2","5 từ"],["1","2 từ"]]],["E20",1,4,"Tự động nói theo các cụm từ","H/s có thể tự nói theo các cụm từ","",-1,[["4","Lặp lại chính xác cụm 6 từ hoặc hơn ít nhất 3 lần mỗi ngày"],["3","cụm 4 từ 3 lần mỗi ngày"],["2","cụm 3 từ 3 lần mỗi ngày"],["1","cụm 2 từ ít nhất 3 lần ngày"]]],["F1",1,5,"Yêu cầu bằng cách chỉ","Học sinh sẽ có thể chỉ những đồ vật hay hành động mình muốn bằng cách chỉ, kéo lại mình hay đứng kế bên vật mình muốn (mà không dùng từ hay ngôn ngữ ra hiệu)","",-1,[["2","ít nhất 5 yêu cầu một ngày về 3 vật hoặc hoạt động khác nhau"],["1","yêu cầu 1 vật hoặc hoạt động khác nhau"]]],["F2",1,5,"Ra các yêu cầu khi có người chi phối / điều khiển","Học sinh sẽ yêu cầu có điều mình muốn khi có vật yêu thích và được đưa một từ hoặc một ký hiệu","Để quả táo trước mặt HS, và hỏi \"Con muốn gì?..(nhắc) Táo\" HS sẽ ra dấu hoặc nói \"Táo\"",-1,[["4","ít nhất 10 vật hoặc hoạt động"],["3","6 vật hoặc hoạt động"],["2","4 vật hoặc hoạt động"],["1","1 vật hoặc hoạt động"]]],["F3",1,5,"Yêu cầu khi có vật yêu thích hiện hữu và khi được hỏi \"Con muốn gì?\"","Học sinh sẽ yêu cầu vật mình muốn bằng lời hay bằng cử chỉ khi vật đó hiện hữu","Để quả táo trước mặt HS, và hỏi \"Con muốn gì?\" HS sẽ ra dấu hoặc nói \"Táo\"",-1,[["4","ít nhất 10 vật hoặc hoạt động"],["3","6 vật hoặc hoạt động"],["2","4 vật hoặc hoạt động"],["1","1 vật hoặc hoạt động"]]],["F4",1,5,"Ra yêu cầu khi được hỏi \"Con muốn gì?","Học sinh sẽ yêu cầu ít nhất 10 vật mà mình muốn cả khi vật đó không hiện hữu","",-1,[["4","ít nhất 10 vật hoặc hoạt động"],["3","6 vật hoặc hoạt động"],["2","4 vật hoặc hoạt động"],["1","1 vật hoặc hoạt động"]]],["F5",1,5,"Tự động yêu cầu một vật hiện hữu (không cần nhắc)","Học sinh tự động xin ít nhất là 10 vật hiện hữu mà HS muốn bằng lời hay bằng cách ra dấu","HS tự động xin bánh khi nhìn thấy mà không cần phải nhắc là thích gì",-1,[["4","10 vật hay hoạt động khi thấy vật đó hoặc vật liên quan đến hoạt động đó"],["3","6 vật hoặc hoạt động"],["2","4 vật hoặc hoạt động"],["1","1 vật hoặc hoạt động"]]],["F6",1,5,"Tự giác yêu cầu những vật không hiện hữu (không cần nhắc)","HS sẽ tự giác yêu cầu ít nhất 10 đồ vật không hiện hữu mà HS thích bằng lời hoặc bằng ra dấu","HS tự động xin bánh kể cả khi không nhìn thấy mà không cần phải nhắc là thích gì",-1,[["4","10 vật hay hoạt động khi không thấy vật đó hoặc vật liên quan đến hoạt động đó"],["3","6 vật hoặc hoạt động"],["2","4 vật hoặc hoạt động"],["1","1 vật hoặc hoạt động"]]],["F7",1,5,"Yêu cầu bằng giao tiếp mắt","Hs sẽ giao tiếp mắt khi yêu cầu vật, hoạt động hoặc thông tin nào đó","",-1,[["2","giao tiếp mắt ít nhất 80% số lần HS yêu cầu"],["1","ít nhất 50%"]]],["F8",1,5,"Yêu cầu người khác làm một hành động","Học sinh có thể yêu cầu người khác làm một việc nhất định","Yêu cầu người khác \"đi với\" mình, \"hát\", \"đứng\", \"mở\", \"đẩy\", \"nhặt lên\". \"Hãy giúp tôi cất cái này\", \"hãy chỉ tôi cách làm sao..\"",-1,[["4","có thể yêu cầu ít nhất 10 hành động"],["3","6 hành động"],["2","3 hành động"],["1","1 hành động"]]],["F9",1,5,"Xin những vật cần cho một bài tập mà còn thiếu","Khi chỉ đưa HS 1 số vật dụng để làm 1 việc gì, học sinh sẽ biết hỏi xin vật còn thiếu","Khi được đưa 1 bát lúa mạch không có thìa, 1 tách không có nước",-1,[["4","10 hay hơn"],["3","ít nhất 6"],["2","ít nhất 3"],["1","biết yêu cầu 1 vật còn thiếu"]]],["F10",1,5,"Yêu cầu động tác đầu hay bằng cách nói Có/Không .","Học sinh sẽ có thể hỏi hay từ chối những vật/ hoạt động được cho/rủ bằng động tác đầu hay bằng cách nói Có/không","",-1,[["2","cả có và không"],["1","chỉ có hoặc không"]]],["F11",1,5,"Yêu cầu bằng câu","Học sinh sẽ đặt câu hỏi để xin đồ vật, hành động hay thông tin","tôi muốn uống nước, tôi cần bút chì, tôi xin bắp rang được không? đưa tôi xin quả chuối, tôi muốn đi nhờ xe, cho xin nước hoa quả",-1,[["2","thường dùng ít nhất 3 từ để xin vật hay hành động"],["1","có lúc dùng 3 từ hoặc hơn để yêu cầu đồ vật hay hành động"]]],["F12",1,5,"Yêu cầu được giúp đỡ","Học sinh sẽ xin được giúp đỡ khi cần","giúp, giúp con cái này, mở sách ra cho con xem, sửa áo cho con với v.v..",-1,[["2","xin được giúp trong nhiều tình huống"],["1","xin giúp trong 1 vài tình huống đặc biệt (buộc dây giầy, mở hộp)"]]],["F13",1,5,"Biết cách yêu cầu mà không cần luyện tập nhiều","Học sinh sẽ có thể biết hỏi nhiều cách để xin đồ vật mới, hành động mới hay để hỏi thông tin sau khi GV dạy HS yêu cầu chưa đến 5 lần","",-1,[["2","sẵn sàng học thêm cách yêu cầu mới mà không cần trực tiếp luyện tập"],["1","sẵn sàng học thêm cách yêu cầu các vật, hành động, hoặc thông tin khi GV dạy HS cách yêu cầu chưa đến 5 lần"]]],["F14",1,5,"Yêu cầu sự chú ý của người khác","Học sinh sẽ có thể yêu cầu người khác chú ý đến hành động của mình","Gọi tên 1 người để tạo chú ý, giơ tay và nói: \"Mẹ nhìn con này\", \"Xem này\", \"Xem con đã làm gì này\".",-1,[["4","ít nhất 10 yêu cầu 1 ngày"],["3","6 yêu cầu 1 ngày"],["2","4 yêu cầu 1 ngày"],["1","2 yêu cầu 1 ngày"]]],["F15",1,5,"Yêu cầu người khác dời đồ vật đi hay dừng 1 hành động","Học sinh sẽ có thể yêu cầu người khác lấy 1 vật đi hay ngừng 1 hành động","Yêu cầu người khác tắt nhạc, tắt quạt, dừng chạy. \"Thôi ta đi đi\".",-1,[["2","có thể tự động làm"],["1","chỉ làm khi trong những tình huống có dàn dựng"]]],["F16",1,5,"Yêu cầu dùng tính từ","Học sinh sẽ có thể yêu cầu nhiều thứ bằng cách dùng tính từ (thí dụ: con ngựa to)","Trong khi chơi với bộ đồ chơi về trang trại, học sinh yêu cầu có: \"con ngựa to\"",-1,[["2","tự động dùng ít nhất 4 tính từ kèm 1 danh từ khi yêu cầu 1 vật"],["1","dùng ít nhất 2 tính từ kèm / không kèm danh từ trong tính huống có dàn dựng"]]],["F17",1,5,"Yêu cầu dùng giới từ","Học sinh sẽ có thể yêu cầu nhiều vật dùng giới từ (thí dụ: trong hộp)","Khi chơi với búp bê, học sinh yêu cầu đặt con búp bê vào trong nôi",-1,[["2","tự động dùng ít nhất 4 giới từ khi yêu cầu 1 vật"],["1","dùng ít nhất 2 giới từ có hay không có danh từ trong tình huống có dàn dựng"]]],["F18",1,5,"Yêu cầu đồ vật hay sự kiện trong tương lai","Học sinh sẽ có thể hỏi xin những vật hay sự việc có thể có được trong tương lai","Buổi sáng, học sinh xin được xem băng video sau giờ ăn trưa",-1,[["2","tự động yêu cầu đồ vật hay sự việc trước 1 ngày hay hơn"],["1","tự động yêu cầu đồ vật hay được tham gia vào một hoạt động sau khi đã làm xong một việc hoặc sau đó cùng ngày"]]],["F19",1,5,"Hỏi thông tin bằng cách hỏi \"Cái gì?\"","Học sinh sẽ đặt câu hỏi để lấy thông tin","HS nhìn thấy 1 vật lạ, liền hỏi \"Cái gì đấy?\", \"Cái đó để làm gì?\"",-1,[["2","tự động hỏi câu hỏi \"Cái gì?\" khi thấy vật lạ ngoài giờ học"],["1","hỏi trong giờ học hoặc khi được nhắc"]]],["F20",1,5,"Hỏi thông tin bằng câu hỏi \"Ở đâu?\"","Học sinh sẽ đặt câu hỏi để lấy thông tin","vd: bố mẹ nói \"chúng ta đi ăn thôi\" thì HS sẽ hỏi \"ăn ở đâu?\" - bố mẹ nói \"lấy giầy của con đi\" và HS sẽ hỏi \"Giầy của con ở đâu?\"",-1,[["2","tự hỏi cầu hỏi \"ở đâu\" trong giờ học với các vật hoặc tình huống mới"],["1","có thể hỏi \"ở đâu\" với các vật hoặc tình huống mới trong giờ hoặc khi được nhắc"]]],["F21",1,5,"Hỏi thông tin bằng câu hỏi \"Ai/của ai?\"","Học sinh sẽ đặt câu hỏi để lấy thông tin","Đến phiên ai? Giầy này của ai? Ai vậy?",-1,[["2","hỏi những câu hỏi có \"Ai/ của ai?\" ngoài giờ học với những vật lạ"],["1","có thể hỏi trong giờ học (hay khi được nhắc)"]]],["F22",1,5,"Yêu cầu dùng phó từ","Học sinh sẽ có thể yêu cầu những hành động dùng phó từ, (thí dụ: đẩy tôi nhanh lên, đi nhẹ chân thôi).","Trong khi ngồi trên xe đẩy, học sinh yêu cầu \"đẩy tôi nhanh lên\", \"chúng mình nói khẽ thôi\", \"hãy ném mạnh tay hơn\"",-1,[["2","tự động dùng ít nhất 4 phó từ kèm 1 danh từ khi yêu cầu 1 hành động"],["1","dùng ít nhất 2 phó từ có / không kèm hành động trong tình huống có dàn dựng"]]],["F23",1,5,"Yêu cầu dùng đại từ","Học sinh sẽ có thể yêu cầu nhiều đồ vật dùng đại từ (thí dụ: Tôi muốn nón của bạn)","Trong khi chơi trò chơi mặc quần áo, học sinh bảo \"tôi muốn nón của bạn\"",-1,[["2","tự động dùng ít nhất 4 đại từ kèm 1 danh từ khi yêu cầu 1 vật"],["1","dùng ít nhất 2 đại từ có / không kèm 1 danh từ trong tình huống có dàn dựng"]]],["F24",1,5,"Hỏi thông tin bằng câu hỏi \"Cái nào?\"","Học sinh sẽ đặt câu hỏi để lấy thông tin","",-1,[["2","hỏi câu hỏi \"Cái nào?\" ngoài giờ học với những vật lạ"],["1","có thể hỏi trong giờ học (hay khi được nhắc)"]]],["F25",1,5,"Hỏi thông tin bằng câu hỏi \"Khi nào?\"","Học sinh sẽ đặt câu hỏi để lấy thông tin","",-1,[["2","hỏi câu hỏi \"Khi nào?\" ngoài giờ học với những vật lạ"],["1","có thể hỏi trong giờ học (hay khi được nhắc)"]]],["F26",1,5,"Hỏi thông tin bằng câu hỏi \"Như thế nào?\"","Học sinh sẽ đặt câu hỏi để lấy thông tin","Hãy chỉ tôi cách bạn làm việc đó",-1,[["2","hỏi những câu hỏi \"Như thế nào?\" ngoài giờ học với những vật lạ"],["1","có thể hỏi trong giờ học (hay khi được nhắc)"]]],["F27",1,5,"Hỏi thông tin bằng câu hỏi \"….có thể…không?\", \"có phải…không?\", hoặc \"...sẽ….không?\"","Học sinh sẽ đặt câu hỏi để lấy thông tin","Tôi có thể mua giầy ở trạm xăng hay không?",-1,[["2","tự dùng ít nhất 2 dạng câu hỏi đảo \"có/không\""],["1","tự dùng ít nhất 1 dạng câu hỏi đảo \"có/không\""]]],["F28",1,5,"Hỏi thông tin bằng câu hỏi \"Tại sao\"","Học sinh sẽ đặt câu hỏi để lấy thông tin","",-1,[["2","tự hỏi \"Tại sao?\" ngoài giờ học với những vật lạ"],["1","Có thể hỏi trong giờ học (hay khi được nhắc)"]]],["F29",1,5,"Tự động yêu cầu","HS sẽ tự động yêu cầu các vật, hành động, hoặc thông tin suốt cả ngày","",-1,[["2","tự động yêu cầu vật, hành động, hoặc thông tin ít nhất 20 lần trong ngày"],["1","tự động yêu cầu vật, hành động, hoặc thông tin ít nhất 10 lần trong ngày"]]],["G1",1,6,"Gọi tên vật yêu thích","HS sẽ gọi tên những vật yêu thích","",-1,[["4","ít nhất 10 lần gọi tên vật"],["3","6 lần"],["2","4 lần"],["1","2 lần"]]],["G2",1,6,"Gọi tên đồ vật thông thường","HS sẽ gọi tên được ít nhất 100 đồ vật thường thấy quanh mình.","",-1,[["4","ít nhất 100 lần gọi tên vật, và biết vài ví dụ (bao gồm cả ví dụ mới) cho hầu hết các vật đó"],["3","50 lần gọi tên vật với ít nhất 1 ví dụ cho 1 vật"],["2","10 lần gọi tên vật"],["1","5 lần gọi tên vật"]]],["G3",1,6,"Gọi tên những người thường gặp (người chứ không phải nghề nghiệp)","HS sẽ gọi tên những người quanh mình","Mẹ, bố, anh chị (Rachel), các bạn (Jason, Emily)",-1,[["4","ít nhất 10 người"],["3","6 người"],["2","4 người"],["1","2 người"]]],["G4",1,6,"Gọi tên tranh ảnh về những đồ vật thông thường","HS sẽ gọi tên ít nhất 100 tranh ảnh về những đồ vật thông thường","",-1,[["4","ít nhất 100 lần gọi tên tranh vẽ vật và biết vài ví dụ (bao gồm cả ví dụ mới) cho hầu hết các vật đó"],["3","50 lần gọi tên với ít nhất 1 ví dụ cho một vật"],["2","10 lần gọi tên"],["1","5 lần gọi tên"]]],["G5",1,6,"Gọi tên các bộ phận cơ thể","HS sẽ gọi tên được các bộ phận thông thường trên cơ thể mình và người khác","mũi, mắt, tóc trên người mình, trên búp bê và trên cơ thể người khác hoặc trên ảnh 1 người nào đó",-1,[["4","Có thể gọi tên ít nhất 20 bộ phận cơ thể trên người mình hay người khác"],["3","10 bộ phận"],["2","5 bộ phận"],["1","Ít nhất 2 bộ phận cơ thể trên người mình hay người khác."]]],["G6",1,6,"Gọi tên các loại quần áo","HS biết kể tên các loại quần áo","",-1,[["2","Kể tên ít nhất 4 thứ quần áo"],["1","Kể tên 2 thứ quần áo"]]],["G7",1,6,"Gọi tên những hành động thông thường","Học sinh sẽ gọi tên những hành động thông thường","",-1,[["4","ít nhất 20 lần gọi tên hành động và có thể nói được vài thí dụ khác nhau (kể cả thí dụ mới) cho hầu hết các hành động"],["3","10 hành động"],["2","5 hành động"],["1","2 hành động"]]],["G8",1,6,"Gọi tên tranh ảnh miêu tả những hành động thông thường","Học sinh sẽ có thể gọi tên tranh ảnh miêu tả những hành động thông thường","",-1,[["4","20 lần kể tên các tranh miêu tả hành động và có nói được vài thí dụ khác nhau (kể cả thí dụ mới) cho hầu hết các hành động đó"],["3","10 hành động"],["2","5 hành động"],["1","2 hành động"]]],["G9",1,6,"Gọi tên đến thành thục","HS có thể liên tiếp gọi tên các vật quen thuộc","Khi yêu cầu HS kể tên các vật trong quyển sổ hoặc trong quyển sách, HS có thể nói tên liên tiếp giầy, cốc và táo, có thể kể tên các màu, số, chữ, v.v…",-1,[["2","có thể gọi tên liên tiếp 10 vật quen thuộc trong vòng 15 giây"],["1","có thể gọi tên 5 vật quen thuộc trong vòng 10 giây"]]],["G10",1,6,"Gọi tên thứ mới không cần luyện tập nhiều","Học sinh sẽ có thể gọi tên nhiều vật hay hình ảnh vật mới sau khi nghe người khác gọi tên vật đó không quá 5 lần (không được dạy trực tiếp)","",-1,[["2","sẵn sàng học tên nhiều vật mới khi nghe người khác gọi tên của những đồ vật này (không được dạy trực tiếp)"],["1","sẵn sàng học tên những vật thông thường khi được dạy không quá 5 lần"]]],["G11",1,6,"Gọi tên các vật dùng cụm từ kết nối thành câu","Học sinh có thể dùng các cụm từ kết nối thành câu khi gọi tên vật và sẽ thường xuyên dùng những cụm từ đó không cần nhắc","\"Đây là chiếc máy bay\", \"Nhìn kìa, 1 chiếc máy bay!\", \"Một chiếc máy bay đang bay trên kia kìa\"",-1,[["2","khi tự động gọi tên các vật, học sinh sẽ dùng ít nhất 2 cụm từ kết nối khác nhau ít nhất 50% số lần gọi tên"],["1","Khi được nhắc, học sinh sẽ gọi tên đồ vật với ít nhất 2 cụm từ kết nối khác nhau"]]],["G12",1,6,"Gọi tên các bộ phận hoặc đặc tính của các vật.","Học sinh sẽ có thể gọi tên các bộ phận hay đặc tính của các vật","Khi nhìn ảnh một chiếc ô tô, học sinh kể ra cửa xe, bánh xe, và cửa sổ",-1,[["4","3 bộ phận hoặc đặc tính của ít nhất 10 vật"],["3","3 bộ phận hoặc đặc tính của 4 vật"],["2","2 bộ phận hoặc đặc tính của 4 vật"],["1","2 bộ phận hoặc đặc tính của 2 vật"]]],["G13",1,6,"Gọi tên tính từ","Học sinh sẽ có thể dùng tính từ để mô tả các vật","Xe tải màu đỏ, chiếc giầy này… to/nhỏ, nước này…. nóng/lạnh",-1,[["4","gọi tên dùng ít nhất 20 tính từ (gồm ít nhất 3 màu, 2 hình dáng và 2 kích thước)"],["3","ít nhất 10 tính từ (5 trong số đó không phải là màu)"],["2","ít nhất là 5 tính từ (tất cả là màu cũng được)"],["1","có thể dùng ít nhất 1 tính từ"]]],["G14",1,6,"Kể tên các tranh ảnh có liên quan","Khi bày ra 1 loạt các vật hoặc ảnh, sau đó lại đưa thêm 1 vật hay ảnh khác và hỏi HS \"Cái này đi với cái nào?\", HS sẽ gọi được tên một trong những đồ vật có liên quan đến những vật được bày ra (VD nói \"ghế\" khi đưa ra ảnh 1 cái bàn và 1 loạt các ảnh gồm ghế, giày và chùm chìa khóa)","vợt và bóng; cốc và nước hoa quả; tất và giày, gối và giường",-1,[["4","Có thể gọi tên được ít nhất 2 hình ảnh có liên quan trong số ít nhất 20 vật"],["3","2 ảnh có liên quan trong số 10 vật"],["2","1 ảnh có liên quan trong số 10 vật"],["1","Ít nhất 1 ảnh có liên quan trong số 5 vật"]]],["G15",1,6,"Nói tên vật khi biết chức năng của vật","HS sẽ có thể nói tên vật khi biết mỗi chức năng của vật","Khi đưa xem ảnh cái kéo, giày và một con ngựa rồi hỏi: \"Em cắt bằng gì?\", HS sẽ nói \"kéo\"",-1,[["4","Gọi tên được ít nhất 25 vật, gồm ít nhất 4 ví dụ cho ít nhất 6 chức năng"],["3","Ít nhất 10 vật"],["2","Ít nhất 5 vật"],["1","2 vật"]]],["G16",1,6,"Nói tên vật khi biết một trong những đặc điểm của vật","HS sẽ có thể nói tên vật khi biết mỗi đặc điểm của vật đó","Khi được đưa xem ảnh về cái kéo, giày, 1 con ngựa và giáo viên bảo: \"nó có chân\" hay \"nó có đuôi\", HS sẽ nói \"ngựa\"",-1,[["4","Gọi tên được ít nhất 25 vật, gồm ít nhất 2 ví dụ cho ít nhất 6 đặc điểm"],["3","Ít nhất 10 vật"],["2","Ít nhất 5 vật"],["1","2 vật"]]],["G17",1,6,"Nói tên vật khi biết chủng loại của vật","HS sẽ có thể nói tên vật khi biết mỗi chủng loại của vật đó","Khi được đưa xem ảnh về cái kéo, áo sơ mi và ngựa và giáo viên hỏi: \"Cái nào là đồ để mặc?\" HS sẽ nói \"áo sơ mi\"",-1,[["4","Ít nhất 5 vật thuộc 4 chủng loại"],["3","Ít nhất 5 vật thuộc 3 chủng loại"],["2","Ít nhất 5 vật thuộc 2 chủng loại"],["1","Ít nhất 5 vật thuộc 1 chủng loại"]]],["G18",1,6,"Kể tên 2 vật (danh từ)","HS sẽ có thể kể tên 1 loạt vật được đưa xem","Khi đưa xem 2 ảnh con vật và hỏi: \"Đây là những con gì?\", HS sẽ nói \"Chó và mèo\"",-1,[["4","Ít nhất 20 cặp các vật"],["3","Ít nhất 10 cặp các vật"],["2","Ít nhất 5 cặp các vật"],["1","ít nhất 2 cặp các vật"]]],["G19",1,6,"Kể tên 2 vật (danh từ) trong ảnh","HS sẽ có thể kể tên nhiều hơn 1 vật trong ảnh","Khi đưa xem 1 ảnh sân chơi, HS sẽ nói \"xích đu, cầu trượt\" (không cần dùng từ \"và\")",-1,[["4","Ít nhất 20 cặp đồ vật"],["3","Ít nhất 10 cặp đồ vật"],["2","Ít nhất 5 cặp đồ vật"],["1","Ít nhất 2 cặp đồ vật"]]],["G20",1,6,"Kể tên 2 vật dùng cụm từ kết nối.","H/s có thể sử dụng 1 cụm từ kết nối khi gọi tên nhiều vật, và thường xuyên sử dụng những cụm từ kết nối đó mà không cần nhắc","\"Đây là máy bay và trực thăng\", \"Xem này, 1 chiếc máy bay và một chiếc trực thăng\", \"Tôi nhìn thấy một chiếc máy bay và 1 chiếc trực thăng\", \"Có 1 chiếc máy bay và 1 chiếc phản lực\"",-1,[["2","khi tự động gọi tên vật, HS sẽ dùng cụm từ kết nối 50% số lần với ít nhất 2 loại cụm từ kết nối khác nhau"],["1","Khi được nhắc, HS có thể gọi tên các vật có sử dụng ít nhất 2 cụm từ kết nối khác nhau"]]],["G21",1,6,"Gọi tên sử dụng danh từ-động từ","HS gọi tên vật kết hợp danh từ với động từ","Khi đang lăn bóng, HS có thể nói \"lăn bóng\" - Khi xem ảnh một cô gái đang đạp xe trong công viên, HS nói \"đạp xe\".",-1,[["4","sử dụng Ít nhất 10 động từ kết hợp với nhiều danh từ"],["3","sử dụng Ít nhất 5 động từ kết hợp với nhiều danh từ"],["2","sử dụng ít nhất 5 cặp danh từ - động từ"],["1","Ít nhất 2 cặp danh từ - động từ"]]],["G22",1,6,"Gọi tên sử dụng danh từ-tính từ","HS gọi tên vật kết hợp danh từ với tính từ","khi đưa cho xem một quả bóng đỏ, HS sẽ nói \"bóng đỏ\"",-1,[["4","Dùng ít nhất 10 tính từ kết hợp với nhiều danh từ"],["3","Ít nhất 5 tính từ kết hợp với nhiều danh từ"],["2","ít nhất 5 cặp danh từ - tính từ"],["1","ít nhất 2 cặp danh từ - tính từ"]]],["G23",1,6,"Gọi tên bằng cách xác nhận có/không","HS có thể trả lời có/không hay gật/lắc đầu để xác nhận tên một vật hay vật / hành động có đúng với tiêu chí nào đó không","khi xem ảnh 1 con mèo và hỏi \"Đây có phải con chó đây không?\", HS sẽ lắc đầu để trả lời \"không\"",-1,[["2","xác nhận đặc tính của các vật hiện hữu bằng cách nói có/không"],["1","xác nhận tên gọi của vật hiện hữu bằng cách nói có/không"]]],["G24",1,6,"Gọi tên chức năng của vật","HS có thể nói chức năng của vật khi được hỏi \"Em làm gì với cái này?\"","Khi cho xem ảnh về 1 cái cốc và hỏi \"Con dùng chén để làm gì?\", HS sẽ trả lời \"uống\"",-1,[["4","nói được ít nhất 25 chức năng gồm ít nhất 4 ví dụ cho ít nhất 6 chức năng"],["3","Ít nhất 10"],["2","Ít nhất 5"],["1","Ít nhất 2"]]],["G25",1,6,"Gọi tên chủng loại của vật","HS sẽ có thể nói được chủng loại của 1 vật nào đó","Khi cho xem ảnh 1 chiếc áo và hỏi \"Áo sơ mi là gì?\", HS sẽ nói \"quần áo\"",-1,[["4","5 vật thuộc 10 chủng loại"],["3","3 vật thuộc 5 chủng loại"],["2","2 vật thuộc 5 chủng loại"],["1","2 vật thuộc 2 chủng loại"]]],["G26",1,6,"Phân biệt các câu hỏi nêu các khía cạnh của vật","HS sẽ có thể phân biệt được câu hỏi về tên, chức năng, màu sắc, hay sở hữu của 1 vật","Khi xem 1 quả bóng màu đỏ, HS sẽ trả lời \"ném bóng\" khi được hỏi \"Con làm gì với quả bóng này?\", trả lời \"Của Tyler\" khi được hỏi \"Quả bóng này của ai?\", trả lời \"màu đỏ\" khi được hỏi \"Bóng màu gì?\", trả lời \"quả bóng\" khi được hỏi \"Cái gì đây?\", chứ không đơn thuần trả lời \"ném bóng\", \"bóng đỏ\"; \"bóng của Tyler\" hay \"ném quả bóng đỏ của Tyler\"",-1,[["2","có thể nói được ít nhất 3 khía cạnh của 1 vật khi được hỏi 1 câu nhất định về vật đó"],["1","Có thể gọi tên ít nhất 2 khía cạnh (tên chức năng, màu sắc, chủ sở hữu) của 1 vật khi được hỏi 1 câu về vật đó"]]],["G27",1,6,"Nói được chủng loại của 1 nhóm vật.","HS có thể nhìn tranh một nhóm vật hay vật thật và nói được chủng loại của những vật đó","Khi xem 1 chiếc vòng, 1 chiếc nhẫn và hoa tai, HS sẽ nói đồ trang sức",-1,[["4","5 vật thuộc 10 chủng loại"],["3","3 vật thuộc 5 chủng loại"],["2","2 vật thuộc 5 chủng loại"],["1","2 vật thuộc 2 chủng loại"]]],["G28",1,6,"Chỉ ra đặc tính của vật còn thiếu hay điểm bất hợp lý","HS sẽ có thể chỉ ra những bộ phận còn thiếu hay điểm bất hợp lý của 1 vật trong tranh (VD: ô tô không bánh)","Khi được hỏi \"Có gì sai?\", HS sẽ nói \"rắn lại có tai thỏ\" và khi được hỏi \"thiếu cái gì?\", HS sẽ nói \"con voi thiếu tai\".",-1,[["2","chỉ ra được ít nhất 5 ví dụ trong đó vật trong tranh bị thiếu các bộ phận VÀ 5 ví dụ trong đó có nhiều điểm bất hợp lý"],["1","chỉ ra được ít nhất 5 bộ phận còn thiếu của vật trong ảnh hay những điểm bất hợp lý"]]],["G29",1,6,"Chỉ ra vật không cùng loại với các vật còn lại","Khi xem một loạt các đồ vật trong đó chỉ có 1 đồ vật là không cùng loại (có thể dựa vào chức năng, đặc tính, chủng loại), HS có thể nói được tên vật không cùng loại với những vật còn lại","VD khi cho xem 4 đồ ăn và 1 chiếc ô tô,và hỏi \"Cái gì không cùng nhóm này?\", HS sẽ trả lời \"ôtô\" - Khi xem một quyển sách có tranh các vật, giáo viên yêu cầu HS nêu tên cái không phải là con vật, HS sẽ trả lời \"ôtô\" (khi có ảnh ôtô ở đó)",-1,[["4","Ít nhất 3 ví dụ thuộc 10 loại (có thể liên quan đến chức năng, đặc tính, chủng loại của vật)"],["3","3 ví dụ thuộc ít nhất 5 loại"],["2","3 ví dụ thuộc ít nhất 3 loại"],["1","3 ví dụ thuộc ít nhất 2 loại (có thể liên quan đến chức năng, đặc tính, chủng loại)"]]],["G30",1,6,"Chỉ ra các sự cố/bất ổn dễ thấy/rõ rệt","HS có thể chỉ ra một sự cố hiển hiện hay tình trạng khẩn cấp dễ thấy","1 căn nhà đang cháy, 1 vụ tai nạn ôtô, lũ lụt v.v...",-1,[["2","có thể chỉ ra được ít nhất 3 sự cố dễ thấy khác nhau"],["1","có thể chỉ ra được ít nhất 1 sự cố dễ thấy"]]],["G31",1,6,"Gọi tên những người nhân viên công ích","HS có thể gọi tên những nhân viên công ích thông thường qua ảnh","giáo viên, cảnh sát, lính cứu hỏa, nhà vật lý học, nhân viên...",-1,[["4","được ít nhất 4 lần gọi tên"],["3","được ít nhất 3 lần gọi tên"],["2","được ít nhất 2 lần gọi tên"],["1","được ít nhất 1 lần gọi tên"]]],["G32",1,6,"Gọi tên những vật ở đằng xa khi có người chỉ","HS có thể gọi tên đồ vật ở xa khi có người chỉ","Giáo viên chỉ vào 1 chiếc máy bay trên trời và nói \"Xem cô nhìn thấy cái gì này\", HS sẽ trả lời \"máy bay\", \"mây\" \"trăng\" v.v... \"1 chiếc xe cứu hỏa\", \"1 quán ăn nhanh hay đến\"",-1,[["2","có thể gọi tên hầu hết các vật quan trọng cách xa hơn 100 feet"],["1","Có thể gọi tên những đồ vật quan trọng cách xa ít nhất 10 feet"]]],["G33",1,6,"Gọi tên các âm thanh quen thuộc quanh mình","HS sẽ gọi tên các âm thanh quen thuộc quanh mình","Dụng cụ/máy móc: cưa, đục v.v... tiếng báo động: còi xe, còi xe lửa, cứu thương, còi công an, tiếng các con vật, các hoạt động: tiệc sinh nhật, trận bóng, tiếng xe, ô tô, tàu hỏa, máy bay v.v…",-1,[["4","Ít nhất 8 âm thanh"],["3","Ít nhất 6 âm thanh"],["2","Ít nhất 4 âm thanh"],["1","Ít nhất 2 âm thanh"]]],["G34",1,6,"Dùng những cụm từ kết nối khi gọi tên danh từ kèm động từ hoặc tính từ","HS sẽ dùng các cụm từ kết nói khi dùng danh từ kèm động từ hay tính từ và sẽ thường xuyên dùng những cụm từ kết nối đó mà không cần nhắc nhở","Khi được đưa 1 quả bóng, học sinh sẽ nói \"Đây là quả bóng màu đỏ\", \"Có 1 quả bóng to\", \"Đây là quả bóng cũ\", \"Xem kìa, 1 quả bóng nhỏ\" v.v...",-1,[["2","khi tự động gọi tên vật, HS sẽ dùng ít nhất 2 loại cụm từ kết nối 50% số lần"],["1","Khi được nhắc nhở, HS có thể dùng ít nhất 2 loại cụm từ kết nối để gọi tên vật"]]],["G35",1,6,"Gọi tên giới từ","HS có thể nói được vị trí của vật so với những vật khác","Khi cho xem 1 quả bóng trong cốc và hỏi \"Quả bóng ở đâu?\", HS sẽ trả lời \"trong cốc\"",-1,[["4","Ít nhất 10 giới từ"],["3","Ít nhất 6 giới từ"],["2","Ít nhất 4 giới từ"],["1","2 giới từ"]]],["G36",1,6,"Dùng cụm từ kết nối có giới từ","HS có thể sử dụng 1 cụm từ kết nối có giới từ và sẽ dùng những cụm từ này thường xuyên mà không cần nhắc nhở","Khi được hỏi \"cái cốc đâu?\", HS sẽ trả lời \"Nó ở trên bàn\"",-1,[["2","HS sẽ dùng ít nhất 2 loại cụm từ kết nối 50% số lần"],["1","Khi được nhắc nhở, HS có thể dùng ít nhất 2 loại cụm từ kết nối để chỉ ra vị trí của vật"]]],["G37",1,6,"Gọi tên đại từ","HS sẽ có thể gọi tên các đại từ","Khi được hỏi \"Ai đang nhảy?\", HS sẽ trả lời \"Cô\"",-1,[["4","Ít nhất 8 đại từ"],["3","Ít nhất 5 đại từ"],["2","Ít nhất 3 đại từ"],["1","Ít nhất 1 đại từ"]]],["G38",1,6,"Dùng cụm từ kết nối với đại từ","HS sẽ có thể dùng cụm từ kết nối có đại từ và sẽ thường xuyên dùng những loại cụm từ này mà không cần nhắc nhở","Khi được hỏi \"Ai đang nhảy\"?\", h/s sẽ trả lời \"Cô đang nhảy\"",-1,[["2","HS sẽ dùng ít nhất 2 loại cụm từ kết nối 50% số lần tự động gọi tên với đại từ"],["1","Khi được nhắc nhở, HS có thể dùng ít nhất 2 loại cụm từ kết nối để gọi tên vật với đại từ"]]],["G39",1,6,"Liệt kê và mô tả các sự kiện hoặc sự vật có trong tranh","Khi cho xem một bức tranh phong cảnh hoặc hoạt động và hỏi \"Hãy nói về bức tranh này\", HS sẽ liệt kê và miêu tả các sự kiện, sự vật, và các hoạt động diễn ra trong tranh","Khi xem cảnh một ngôi nhà đang cháy, HS sẽ nói: \"Có lửa trong nhà, xe cứu hỏa, kéo vòi dập lửa, phun nước vào nhà\". \"Ăn tối\" \"Đi tiệc\", \"Đó là một lần đi dã ngoại\"",-1,[["2","Có thể miêu tả 4 khía cạnh của 1 bức tranh gồm ít nhất 1 hành động hay miêu tả bối cảnh chung của bức tranh"],["1","Có thể mô tả ít nhất 1 hoạt động trong tranh hay miêu tả bối cảnh chung của bức tranh"]]],["G40",1,6,"Kể về một góc tranh cụ thể","Khi cho biết thông tin về một góc tranh nào đó, HS sẽ kể về góc tranh đó","khi cho xem ảnh một khu rừng và hỏi \"Con gì đang đậu trên cành?\", học sinh sẽ trả lời \"Con cú\"",-1,[["2","có thể nói tên vật khi biết chủng loại VÀ 1 chi tiết miêu tả khác (hành động, màu sắc, kích cỡ, vị trí v.v...)"],["1","có thể nói tên đồ vật khi biết chủng loại HOẶC chi tiết miêu tả khác (hành động, vị trí, màu sắc, kích cỡ v.v...)"]]],["G41",1,6,"Sử dụng phó từ","HS có thể dùng phó từ để mô tả","Trong khi quan sát một con rùa bò và hỏi \"Con rùa bò thế nào?\", HS trả lời \"chầm chậm\"",-1,[["4","Ít nhất 10 phó từ"],["3","Ít nhất 6"],["2","Ít nhất 4"],["1","2 phó từ"]]],["G42",1,6,"Nói được trạng thái cảm xúc của những người khác","HS có thể kể tên các cảm xúc biểu hiện bằng nét mặt và hành vi và tranh những gương mặt diễn tả các cảm xúc khác nhau","khi thấy một trẻ khác đang khóc vì bóng bị nổ và hỏi HS cảm giác của trẻ đó, HS sẽ trả lời \"Buồn ạ\"",-1,[["4","ít nhất 4 cảm xúc (qua ví dụ có thật và qua ảnh)"],["3","ít nhất 3 cảm xúc (qua ví dụ có thật và qua ảnh)"],["2","ít nhất 2 cảm xúc"],["1","ít nhất 1 cảm xúc (qua ví dụ có thật và qua ảnh)"]]],["G43",1,6,"Diễn biến cảm xúc nội tâm","HS có thể nói ra những cảm xúc và diễn biến nội tâm của mình mà người ngoài thể thấy được bằng trực quan","chỗ đau, vết thương nhỏ, chỗ ngứa, vui sướng, buồn, ngạc nhiên, sợ hãi, cáu, sợ sệt, lo lắng, mệt mỏi, buồn ngủ, bình tâm, cô đơn, v.v…",-1,[["4","Có thể nói ra tình thái cơ thể và cảm xúc, mà người khác không cảm nhận được bằng thị giác/thính giác/xúc giác/khứu giác"],["3","3 trạng thái bất kỳ"],["2","2 trạng thái bất kỳ"],["1","1 trạng thái bất kỳ"]]],["G44",1,6,"Kể ra 3 yếu tố về một vật","HS có thể kể ra 3 yếu tố về một vật","cho xem tranh và hỏi 'con nhìn thấy gì?', HS sẽ trả lời \"xe tải màu đỏ của bố\".",-1,[["4","Ít nhất 6 từ với 4 thành phần ngôn ngữ khác nhau"],["3","Ít nhất 5 từ với 3 thành phần ngôn ngữ khác nhau"],["2","Ít nhất 4 từ với 3 thành phần ngôn ngữ khác nhau"],["1","Ít nhất 3 từ với 3 thành phần ngôn ngữ khác nhau (danh từ, động từ, tính từ, đại từ, trạng từ, mạo từ)"]]],["G45",1,6,"Kể ra 3 yếu tố về một vật dùng cụm từ kết nối","HS có thể dùng cụm từ kết nối khi kể ra ít nhất 3 yếu tố riêng biệt và sẽ thường xuyên dùng những cụm từ kết nối đó mà không cần nhắc","cho xem một bức tranh và hỏi \"Con nhìn thấy gì?\", HS sẽ trả lời \"Em nhìn thấy chiếc xe tải to đang đi nhanh\".",-1,[["2","khi tự động kể về vật, HS sẽ dùng ít nhất 2 loại cụm từ kết nối 50% số lần"],["1","khi được nhắc, HS sẽ có thể gọi tên đồ vật dùng ít nhất 2 cụm từ kết nối"]]],["G46",1,6,"Gọi tên những hành vi giao tiếp xã hội.","HS sẽ có thể nói được bản chất của những loại giao tiếp xã hội (VD: chơi đùa, tranh cãi).","\"Cô ấy ngượng\", tranh cãi, đánh nhau, trò chuyện, trêu trọc, vui chơi, làm việc, thực hành, bận rộn, giận, thân thiện, căng thẳng, vui nhộn.",-1,[["4","10 lần kể tên"],["3","6 lần kể tên"],["2","4 lần kể tên"],["1","2 lần kể tên"]]],["G47",1,6,"Tự giác gọi tên","HS sẽ tự giác gọi tên các đồ vật, sự kiện suốt trong ngày","",-1,[["2","tự giác gọi tên đồ vật hay hành động ít nhất 20 lần/1 ngày"],["1","tự giác gọi tên đồ vật hay hành động ít nhất 10 lần/1 ngày"]]],["H1",1,7,"Hát theo vài từ trong lời bài hát","Khi có người hát 1 bài hát, h/s sẽ có thể hát vài từ và vài đoạn trong lời bài hát","Con cò bé…..",-1,[["4","Ít nhất 3 đoạn trong 6 bài hát"],["3","3 từ trong 3 bài hát"],["2","2 từ trong 2 bài hát"],["1","1 từ trong 2 bài hát"]]],["H2",1,7,"Điền từ vào chỗ trống trong những chuyện và những trò chơi vui nhộn","H/s có thể hoàn tất 1 câu bỏ lửng bằng cách điền thêm những từ thiếu liên quan đến những chuyện, những sinh hoạt vui","\"Nào cùng đi lên đi (xuống)\", Winnie chú____",-1,[["4","điền được ít nhất 10 câu"],["3","5 câu"],["2","2 câu"],["1","1 câu"]]],["H3",1,7,"Ra dấu (từ tiếng anh) (dành cho HS sử dụng ngôn ngữ ra hiệu kiểu Mỹ - ASL)","H/s biết ra dấu sử dụng ASL để thể hiện một từ tiếng anh","Khi ai đó nói \"hãy ra dấu trái táo\" h/s sẽ ra dấu theo ASL để thể hiện từ \"trái táo\"",-1,[["4","25 ký hiệu"],["3","15 ký hiệu"],["2","5 ký hiệu"],["1","2 ký hiệu"],["Không áp dụng","Nếu HS có thể nói được trên 50 từ và/hoặc không sử dụng ASL"]]],["H4",1,7,"Tiếng kêu của các con vật","H/s sẽ có thể nói tên của con vật khi nghe tiếng kêu của nó hay ngược lại","Khi có người nói \"Con chó kêu..., h/s sẽ nói \"gâu, gâu\"",-1,[["4","làm tiếng kêu của 8 con vật khi biết tên con vật và nói tên 8 con vật khi nghe tiếng kêu của con vật đó"],["3","6 tiếng kêu hay tên của con vật"],["2","4 tiếng kêu hay tên của con vật"],["1","2 tiếng kêu hay tên của con vật"]]],["H5",1,7,"Trả lời câu hỏi về thông tin cá nhân","H/s sẽ có thể trả lời những câu hỏi về thông tin cá nhân","Khi được hỏi \"Tên em là gì?\", h/s sẽ nói tên của mình",-1,[["4","ít nhất 4 thông tin về bản thân (VD: tên, tuổi, điện thoại, tên anh em, tên bố mẹ, v.v...)"],["3","3 thông tin về bản thân"],["2","2 thông tin về bản thân"],["1","1 thông tin về bản thân"]]],["H6",1,7,"Điền vào chỗ trống những từ mô tả các hoạt động thông thường","H/s sẽ có thể điền từ còn thiếu trong cụm từ mô tả 1 hành động đang xảy ra","Khi giáo viên dẫn h/s đến chậu nước và nói \"Đến lúc phải đi rửa ..........\", h/s sẽ nói \"tay\"",-1,[["4","Điền được ít nhất 10 từ"],["3","Điền được ít nhất 5 từ"],["2","Điền được ít nhất 2 từ"],["1","Điền được ít nhất 1 từ"]]],["H7",1,7,"Hỏi đáp về các cặp liên hệ","Khi được hỏi \"Cái gì đi với (...)?\" h/s sẽ có thể kể 1 vài đồ vật có liên quan đến vật được nhắc đến (VD sẽ nói \"giường\" khi được hỏi \"Cái gì đi với \"cái gối?\")","\"Cái gì đi với tất? \"giầy\",\"vợt - bóng\", \"chén- nước hoa quả\", \"gối - giường\"",-1,[["4","có thể nói được ít nhất 2 vật liên quan đến ít nhất 20 vật kể tên"],["3","2 vật liên quan đến từng vật trong số 10 hoặc hơn các vật kể tên"],["2","1 vật liên quan đến ít nhất 10 vật kể tên"],["1","ít nhất 1 vật liên quan đến một trong số 5 vật kể tên"]]],["H8",1,7,"Điền tên vật khi biết chức năng của vật đó","H/s sẽ có thể điền nốt tên vật trong một đoạn câu có liên quan đến chức năng của vật đó","Khi h/s nghe câu: \"Con đi xe___, h/s sẽ nói \"xe hơi\"",-1,[["4","điền ít nhất 20 chỗ với 2 lượt hồi đáp"],["3","ít nhất 10 chỗ với 2 lượt hồi đáp"],["2","ít nhất 5 chỗ với 2 lượt hồi đáp"],["1","ít nhất 2 chỗ với 2 lượt hồi đáp"]]],["H9",1,7,"Điền chức năng khi biết tên vật","H/s sẽ có thể điền từ còn thiếu trong một đoạn câu nêu chức năng của vật","\"Con dùng kéo để ...... cắt\", \"Con dùng thìa để...... ăn\"",-1,[["4","Điền ít nhất 20 chỗ với 2 lượt hồi đáp"],["3","10 chỗ với 2 lượt hồi đáp"],["2","5 chỗ với 2 lượt hồi đáp"],["1","2 chỗ với 2 lượt hồi đáp"]]],["H10",1,7,"Trả lời câu hỏi \"Cái gì?\" liên quan đến những đồ vật trong nhà","H/s sẽ có thể trả lời những câu hỏi \"Cái gì?\" liên quan đến những vật trong nhà","Khi được hỏi \"Em có thể tìm thấy gì trong nhà tắm?\" h/s trả lời \"toilet, khăn mặt, bồn tắm\", \"Em thấy gì trong tủ lạnh?\" h/s sẽ trả lời \"sữa, trứng, nước hoa quả\"",-1,[["4","Trả lời được ít nhất 30 câu hỏi gồm ít nhất 3 lượt hồi đáp liên quan đến ít nhất 5 vị trí (VD: phòng ngủ, tủ lạnh, bếp, nhà vệ sinh, phòng khách)"],["3","15 câu hỏi"],["2","10 câu hỏi"],["1","ít nhất 5 câu hỏi"]]],["H11",1,7,"Trả lời câu hỏi \"Cái gì?\" liên quan đến chức năng","H/s có thể trả lời câu hỏi \"Cái gì?\" liên quan đến chức năng của đồ vật","Khi được hỏi \"con dùng cái gì để cắt giấy?\", h/s sẽ trả lời \"kéo\". \"con dùng cái gì để viết?\" h/s trả lời \"bút\"",-1,[["4","Trả lời được ít nhất 50 câu hỏi"],["3","25 câu hỏi"],["2","10 câu hỏi"],["1","Trả lời được ít nhất 5 câu hỏi"]]],["H12",1,7,"Trả lời câu hỏi \"Ở đâu?\" liên quan đến đồ vật ở lớp hoặc ở nhà","H/s sẽ có thể trả lời câu hỏi \"Ở đâu?\" liên quan đến đồ vật ở lớp hoặc ở nhà","Khi được hỏi: \"Con thấy sữa ở đâu?\", h/s sẽ trả lời \"Trong tủ lạnh\", \"Con thấy toilet ở đâu?\", h/s trả lời \"trong nhà tắm\"",-1,[["4","Trả lời ít nhất 30 câu hỏi"],["3","15 câu hỏi"],["2","10 câu hỏi"],["1","Trả lời ít nhất 5 câu hỏi"]]],["H13",1,7,"Trả lời câu hỏi \"Ở đâu?\" liên quan đến các hoạt động ở nhà hoặc ở trường","H/s sẽ có thể trả lời câu hỏi \"Ở đâu?\" liên quan đến các hoạt động ở nhà hoặc ở trường","Khi được hỏi \"em ngủ ở đâu?\" h/s sẽ trả lời \"phòng ngủ\"",-1,[["4","Trả lời hơn 30 câu hỏi"],["3","15 câu hỏi"],["2","10 câu hỏi"],["1","Ít nhất 5 câu hỏi"]]],["H14",1,7,"Điền tên vật khi biết chủng loại","H/s sẽ có thể điền từ còn thiếu trong một đoạn câu nêu tên vật/ví dụ cho một chủng loại các vật nhất định","\"Một loại động vật là là... chó, mèo\", \"con đi bằng... xe hơi, thuyền, máy bay\"",-1,[["4","ít nhất 20 lần điền trong 4 lượt hồi đáp"],["3","10 lần điền trong 3 lượt hồi đáp"],["2","5 lần điền trong 2 lượt hồi đáp"],["1","2 lần điền trong 2 lượt hồi đáp"]]],["H15",1,7,"Cho nhiều phương án trả lời khi biết chủng loại","H/s có thể kể ra rất nhiều vật trong cùng chủng loại","Khi được hỏi \"Hãy kể tên một số con vật\", h/s nói: \"ngựa, chó, bò\". \"Đồ ăn bao gồm:\", h/s trả lời \"táo, bột ngũ cốc, bánh kẹp thịt, bánh piza\"",-1,[["4","20 chủng loại trong 4 lượt hồi đáp"],["3","10 chủng loại trong 3 lượt hồi đáp"],["2","5 chủng loại trong 2 lượt hồi đáp"],["1","2 chủng loại trong 2 lượt hồi đáp"]]],["H16",1,7,"Điền đặc tính khi biết tên vật","Khi nghe tên vật, h/s có thể điền từ còn thiếu trong một đoạn câu nêu đặc tính của vật","Xe hơi có ... \"bánh xe\" \"còi\", \"cửa xe\"",-1,[["4","Điền được ít nhất 20 chỗ với 2 câu trả lời"],["3","10 chỗ với 2 câu trả lời"],["2","5 chỗ với 2 câu trả lời"],["1","2 chỗ với 2 câu trả lời"]]],["H17",1,7,"Điền tên vật khi biết đặc tính của vật","Khi được biết đặc tính của 1 vật, h/s sẽ có thể điền từ còn thiếu trong một đoạn câu nêu tên vật","Con vật có đuôi là…con chó - Cái có bánh xe là... Ôtô",-1,[["4","Điền được ít nhất 20 chỗ với 2 câu trả lời"],["3","10 chỗ với 2 câu trả lời"],["2","5 chỗ với 2 câu trả lời"],["1","2 chỗ với 2 câu trả lời"]]],["H18",1,7,"Điền tên chủng loại khi biết tên vật","H/s sẽ có thể điền từ còn thiếu trong một đoạn câu nêu tên chủng loại của một đồ vật nào đó","Xe hơi là vật ta ...đi, táo là 1 loại....... Quả, mèo là 1 loài....... động vật",-1,[["4","Điền được ít nhất 20 chỗ với 2 câu trả lời"],["3","10 chỗ với 2 câu trả lời"],["2","5 chỗ với 2 câu trả lời"],["1","2 chỗ với 2 câu trả lời"]]],["H19",1,7,"Kể tên những đồ vật sau khi quan sát","H/s có thể kể tên những đồ vật mà chúng đã quan sát trước đó","Ra ngoài quan sát 1 chiếc xe cứu hỏa, sau đó quay lại lớp và kể tên những thứ đã quan sát được ở ngoài",-1,[["4","kể lại hơn 2 vật 1 giờ sau khi đi quan sát về"],["3","1 vật sau 10 phút đi quan sát về"],["2","1 vật sau 5 phút đi quan sát về"],["1","1 vật ngay sau khi đi quan sát về"]]],["H20",1,7,"Kể tên những hoạt động được quan sát trước đó","H/s có thể kể tên 1 hoạt động mà mình vừa quan sát","Ra ngoài và quan sát mọi người chơi bóng rổ, trở về và gọi tên hoạt động mà h/s quan sát khi ra ngoài. Thấy anh đọc sách trong phòng khách, đi vào bếp và nói lại anh đang làm gì",-1,[["4","kể lại hoạt động đó 1 tiếng sau khi quan sát thấy"],["3","10 phút sau khi quan sát thấy"],["2","5 phút sau khi quan sát thấy"],["1","ngay sau khi quan sát thấy"]]],["H21",1,7,"Gọi tên người nhìn thấy trước đó","H/s có thể gọi tên người mà mình trông thấy trước đó","Ra ngoài và cùng chơi với h/s khác trong hộp cát, về lớp và kể tên những h/s cùng chơi trong hộp cát",-1,[["4","Gọi tên được ít nhất 2 người 1 tiếng sau khi quan sát thấy"],["3","1 người 10 phút sau khi quan sát thấy"],["2","1 người 5 phút sau khi quan sát thấy"],["1","1 người ngay sau khi quan sát thấy"]]],["H22",1,7,"Phát ngôn liên quan đến vật cho xem (không tính tên vật)","H/s sẽ có thể đưa ra một số câu nhận xét có liên quan đến ảnh và vật hay hoạt động (không tính tên vật)","Khi xem ảnh mọi người đi cắm trại mang theo lò nướng (nhưng không thấy thức ăn trong ảnh) và nói với HS \"Họ đang cắm trại\", HS sẽ nhận xét chẳng hạn như: \"Họ đang nướng xúc xích và bánh kẹp thịt\" hay \"Đừng sờ vào, nóng đấy\"",-1,[["4","có nhận xét/bình luận về 20 bức ảnh"],["3","có nhận xét/bình luận về 10 bức ảnh"],["2","có nhận xét/bình luận về 5 bức ảnh"],["1","có nhận xét/bình luận về 1bức ảnh"]]],["H23",1,7,"Trả lời câu hỏi \"Cái gì\" liên quan đến những đồ vật hay thấy ở chỗ công cộng","H/s sẽ có thể trả lời một lượt những câu hỏi liên quan về những thứ đã từng nhìn thấy ở những nơi công cộng","Khi được hỏi \"Con thấy gì ở công viên?\", h/s trả lời \"xích đu\"",-1,[["4","Trả lời ít nhất 20 câu hỏi"],["3","Trả lời được 10 câu hỏi"],["2","Trả lời được 5 câu hỏi"],["1","Trả lời được 2 câu hỏi"]]],["H24",1,7,"Trả lời những câu hỏi \"Cái gì\" liên quan đến những hoạt động mà h/s có thể ở nơi công cộng","H/s sẽ có thể trả lời một lượt những câu hỏi liên quan đến những gì mình có thể làm ở nơi công cộng","Khi được hỏi \"Con có thể làm gì khi ở quầy bán thức ăn\", h/s trả lời \"mua bánh\", \"Con có thể làm gì ở công viên?\" h/s sẽ trả lời \"trượt cầu trượt\"",-1,[["4","Trả lời ít nhất 20 câu hỏi"],["3","Trả lời ít nhất 10 câu hỏi"],["2","Trả lời ít nhất 5 câu hỏi"],["1","Trả lời 2 câu hỏi"]]],["H25",1,7,"Trả lời những câu hỏi \"Ở đâu\" liên quan đến những hoạt động, sự vật thường thấy ở nơi công cộng","H/s sẽ có thể trả lời những câu hỏi \"Ở đâu\" liên quan đến những hoạt động, sự kiện thường thấy ở nơi công cộng","Khi được hỏi \"Em mua sữa ở đâu?\" h/s sẽ trả lời \"Cửa hàng tạp hóa\", \"em chơi hộp cát ở đâu?, \"ở trường\"",-1,[["4","Trả lời ít nhất 30 câu hỏi"],["3","Trả lời ít nhất 15 câu hỏi"],["2","Trả lời ít nhất 10 câu hỏi"],["1","ít nhất 5 câu hỏi"]]],["H26",1,7,"Trả lời những câu hỏi có nhiều đáp án về cộng đồng quanh mình","H/s sẽ có thể trả lời những câu hỏi có nhiều đáp án về cộng đồng quanh mình","Khi được hỏi \"Hãy liệt kê những thứ mà em có thể mua ở quầy tạp hóa càng nhiều càng tốt\", h/s sẽ nói \"chuối, thịt, sữa, bánh mì, gạo\"",-1,[["4","20 chủng loại với 3 đáp án"],["3","10 chủng loại với 3 đáp án"],["2","5 chủng loại với 2 đáp án"],["1","2 chủng loại với 2 đáp án"]]],["H27",1,7,"Nói tên chủng loại khi biết tên nhiều vật thuộc chủng loại đó","H/s sẽ có thể xác định được chủng loại khi biết 2 vật thuộc chủng loại đó","Khi nghe \"táo, chuối, lê đều là..., h/s sẽ trả lời \"trái cây\", \"đồ ăn\" hay \"thứ ăn được\"",-1,[["4","20 chủng loại khi biết ít nhất 2 vật trong chủng loại đó"],["3","10 chủng loại"],["2","5 chủng loại"],["1","2 loại khi biết ít nhất 2 vật trong chủng loại đó"]]],["H28",1,7,"Trả lời những câu hỏi \"Ai/của ai\"","H/s sẽ có thể trả lời những câu hỏi \"Ai/của ai\"","\"Đến lượt ai?\" \"Giày này của ai?\" \"Khi ốm con sẽ đến gặp ai?\" \"Ai dập tắt lửa?\"",-1,[["4","Trả lời trên 50 câu hỏi"],["3","25 câu hỏi"],["2","10 câu hỏi"],["1","trả lời ít nhất 5 câu hỏi"]]],["H29",1,7,"Trả lời câu hỏi \"Khi nào\"","H/s sẽ có thể trả lời những câu hỏi \"khi nào\"","\"Con ngủ khi nào?\". \"Con ăn khi nào?\"",-1,[["4","Trả lời ít nhất 50 câu"],["3","25 câu"],["2","10 câu"],["1","Ít nhất 5 câu"]]],["H30",1,7,"Phân biệt câu hỏi về đồ vật với câu hỏi về hoạt động","Khi thảo luận về một vật hay 1 hoạt động, h/s biết phân biệt các dạng câu hỏi \"Cái gì\", \"Ở đâu\", \"Ai\" hay \"Khi nào\"","Con đi mua sữa ở đâu? Ai đưa con đến cửa hàng? Con có thể mua đồ ăn gì ở đó? Khi nào thì con đi? Quả táo màu gì? Mình lấy táo ở đâu? Chúng ta làm gì với táo?",-1,[["2","Có thể trả lời được ít nhất 4 loại câu hỏi theo bất cứ trình tự nào"],["1","Có thể trả lời được ít nhất 2 loại câu hỏi theo bất cứ trình tự nào"]]],["H31",1,7,"Trả lời những câu hỏi \"Cái nào\"","H/s sẽ có thể trả lời những câu hỏi \"cái nào\"","\"Đâu là con thú?\". \"Cái nào là giày?\". \"Con nào là con chó?\"",-1,[["4","Trả lời ít nhất 50 câu hỏi"],["3","25 câu hỏi"],["2","10 câu hỏi"],["1","Ít nhất 5 câu hỏi"]]],["H32",1,7,"Trả lời câu hỏi \"Như thế nào\"","H/s sẽ có thể trả lời câu hỏi \"Như thế nào\"","Con làm thế nào để đi đến trường?",-1,[["4","Trả lời ít nhất 50 câu hỏi"],["3","25 câu hỏi"],["2","10 câu hỏi"],["1","Ít nhất 5 câu hỏi"]]],["H33",1,7,"Trả lời những câu hỏi \"Tại sao\"","H/s có thể trả lời được những câu hỏi \"Tại sao\"","Tại sao em lại rửa tay?, Tại sao em ngủ?",-1,[["4","Trả lời ít nhất 50 câu hỏi"],["3","25 câu hỏi"],["2","10 câu hỏi"],["1","Ít nhất 5 câu hỏi"]]],["H34",1,7,"Mô tả các bước trong sinh hoạt thường ngày","H/s có thể mô tả các bước trong sinh hoạt hàng ngày","Khi được hỏi \"Em rửa tay như thế nào? H/s sẽ trả lời\" đi đến bồn, mở vòi nước, xát xà phòng vào tay...\"",-1,[["4","ít nhất 5 bước trong 2 hay hơn các chuỗi hành động"],["3","4 bước trong 1 chuỗi hành động"],["2","3 bước trong 1 chuỗi hành động"],["1","2 bước trong 1 chuỗi hành động"]]],["H35",1,7,"Nói tên hành động khi biết trình tự các bước","H/s có thể gọi tên hành động khi biết trình tự các bước","Khi được hỏi \"cô đang làm gì?\" và nghe tả \"Đến bồn nước, mở vòi nước, làm ướt tay, cầm xà phòng...\" h/s sẽ trả lời \"rửa tay\"",-1,[["4","Trả lời ít nhất 20 câu hỏi"],["3","Trả lời ít nhất 10 câu hỏi"],["2","Trả lời ít nhất 5 câu hỏi"],["1","Trả lời 2 câu hỏi"]]],["H36",1,7,"Nói tên đồ vật khi biết chức năng, đặc tính hay chủng loại (nhiều đặc tính)","H/s có thể nói tên đồ vật khi biết nhiều khía cạnh về vật đó (vd chức năng, đặc tính, chủng loại)","Khi nghe miêu tả \"Nó giòn, để ăn, mặn, ở trong túi...\", h/s sẽ trả lời \"khoai tây chiên\"",-1,[["4","Trả lời ít nhất 20 câu hỏi"],["3","Trả lời ít nhất 10 câu hỏi"],["2","Trả lời ít nhất 5 câu hỏi"],["1","Trả lời 2 câu hỏi"]]],["H37",1,7,"Hội thoại liên tưởng với dạng câu hỏi Có/Không :có thể, có phải, ...sẽ….phải không","H/s biết lắc/gật đầu hoặc nói \"có/không\" để trả lời các câu hỏi về một vật hay hoạt động không hiện hữu","Khi được hỏi \"tôi có thể mua ga ở tiệm giày không?\", H/s sẽ trả lời \"không\"",-1,[["4","Trả lời ít nhất 50 câu hỏi"],["3","25 câu hỏi"],["2","10 câu hỏi"],["1","Ít nhất 5 câu hỏi về những vật không hiện hữu"]]],["H38",1,7,"Trả lời câu hỏi có 2 tiêu chí quan trọng (câu hỏi phức hợp có nhiều đáp án)","H/s có thể có nhiều đáp án cho những câu hỏi có 2 thông số trọng yếu","Khi được hỏi kể tên 1 vài món ăn nóng, h/s sẽ nói \"bánh piza, spaghetti…\"",-1,[["4","4 đáp án với 5 câu hỏi khác nhau"],["3","3 đáp án cho 4 câu hỏi khác nhau"],["2","2 đáp án cho 3 câu hỏi khác nhau"],["1","2 đáp án cho 1 câu hỏi"]]],["H39",1,7,"Trả lời những câu hỏi có 3 tiêu chí quyết định (câu hỏi phức hợp với nhiều đáp án)","H/s có thể có nhiều đáp án cho những câu có 3 tiêu chí quyết định","Khi được yêu cầu kể tên con vật to lớn ở trang trại, HS nói \"ngựa, và bò\"",-1,[["4","4 đáp án cho 5 câu hỏi khác nhau"],["3","3 đáp án cho 4 câu hỏi khác nhau"],["2","2 đáp án cho 3 câu hỏi khác nhau"],["1","2 đáp án cho 1 câu hỏi khác nhau"]]],["H40",1,7,"Mô tả đồ vật","H/s sẽ có thể mô tả đồ vật bằng cách kể ra bạn có thể làm gì với vật đó, kể vài đặc tính và chủng loại của vật đó","Khi yêu cầu HS mô tả 1 chiếc xe hơi, h/s có thể nói \"cô dùng xe đi các nơi, nó có bánh xe, và cô đỗ nó ở gara\". \"Ngũ cốc là thứ ta ăn buổi sáng, cho vào bát và đổ sữa vào\"",-1,[["2","có thể mô tả ít nhất 20 đồ vật, kể được ít nhất 3 chi tiết liên quan đến đồ vật (không tính tên vật)"],["1","Có thể mô tả ít nhất 10 đồ vật, kể ra 2 chi tiết liên quan đến đồ vật (không tính tên vật)"]]],["H41",1,7,"Mô tả các bước theo trình tự trước sau trong sinh hoạt thường ngày","HS có thể kể bước nào xảy ra trước/sau bước nào theo trình tự trong sinh hoạt thường ngày","Khi được hỏi \"em làm gì trước khi ăn trưa?\" h/s sẽ nói \"rửa tay\", khi được hỏi \"Ăn trưa xong em làm gì\", h/s sẽ nói \"đổ rác\"",-1,[["4","Kể các bước trước và sau trong 10 hoạt động khác nhau"],["3","Kể các bước trước và sau trong 5 hoạt động khác nhau"],["2","Kể một bước trước và sau trong 2 hoạt động khác nhau"],["1","Kể một bước trước và sau trong 1 hoạt động"]]],["H42",1,7,"Trả lời những câu hỏi liên quan đến những sự kiện trong quá khứ và tương lai","H/s sẽ trả lời những câu hỏi đòi hỏi câu trả lời có liên quan đến những sự kiện trong quá khứ và tương lai","Khi đến trường... Em có thể nói em ăn sáng với gì không? Em có thể cho cô biết em sẽ làm gì cuối tuần này không?",-1,[["4","Trả lời 4 câu hỏi liên quan đến quá khứ hoặc tương lai cách đó 1 tháng"],["3","Trả lời 2 câu hỏi liên quan đến quá khứ hoặc tương lai cách đó 1 tháng"],["2","Trả lời 2 câu hỏi liên quan đến quá khứ hoặc tương lai cách đó 1 tuần"],["1","Trả lời 2 câu hỏi liên quan đến quá khứ hoặc tương lai trong ngày đó"]]],["H43",1,7,"Duy trì hội thoại với người lớn hoặc bạn","HS có thể duy trì hội thoại về một chủ đề trao qua đổi lại được ít nhất 5 lượt","5 lần trao đổi giữa học sinh này và một h/s khác về trận đấu bóng rổ",-1,[["2","5 lần trao đổi qua lại về ít nhất 10 chủ đề gồm cả việc h/s hỏi ít nhất 1 câu hỏi mới hay 1 nhận xét mới"],["1","3 lần trao đổi về ít nhất 5 chủ đề khác nhau"]]],["H44",1,7,"Trả lời những câu hỏi mới","H/s sẽ có thể trả lời những câu hỏi khác với câu được dạy","Lúc đầu khi được dạy trả lời câu hỏi \"Em làm gì với chiếc xe hơi\" (đi), h/s cũng có thể được hỏi tương tự như: \"Em cho cô biết xe hơi làm gì?\" hay \"xe hơi để làm gì?\"",-1,[["4","Ít nhất 20 câu hỏi mới"],["3","Ít nhất 10 câu hỏi mới"],["2","Ít nhất 5 câu hỏi mới"],["1","Ít nhất 2 câu hỏi mới"]]],["H45",1,7,"Trả lời những câu hỏi về tại những sự kiện hiện tại","H/s sẽ có thể trả lời những câu hỏi liên quan đến những sự kiện hiện tại","Khi được hỏi \"Em cho cô biết em sẽ làm gì vào 4 tháng 7 này?, h/s sẽ trả lời \"xem pháo hoa\"",-1,[["4","ít nhất 20 câu hỏi"],["3","ít nhất 10 câu hỏi"],["2","ít nhất 5 câu hỏi"],["1","ít nhất 2 câu hỏi"]]],["H46",1,7,"Trả lời câu hỏi có nhiều đáp án liên quan đến những sự kiện hiện tại","H/s sẽ có thể đưa ra nhiều đáp án cho những câu hỏi liên quan đến những sự kiện hiện tại","Khi được hỏi \"Em có thể cho cô biết em có thể làm gì vào 4 tháng 7 không? H/s sẽ trả lời \"xem pháo hoa, ăn tiệc\"",-1,[["4","20 loại với 3 đáp án"],["3","10 loại với 3 đáp án"],["2","5 loại với 2 đáp án"],["1","2 loại với 1 hay 2 đáp án"]]],["H47",1,7,"Trả lời câu hỏi có nhiều đáp án trong những buổi thảo luận nhóm","H/s sẽ có thể có nhiều đáp án cho những câu hỏi về nhiều chủ đề trong thảo luận nhóm","Khi được hỏi \"Sáng nay khi chúng tôi đi vào thì có chuyện gì xảy ra vậy? h/s sẽ nói \"Trời mưa\", Jack bước vào lớp, giầy của cậu ướt hết, khi được hỏi \"Hôm qua chúng ta làm gì?\" H/s sẽ trả lời \"làm bánh ạ\"",-1,[["2","Có ít nhất 2 nhận xét cho ít nhất 3 chủ đề trong 1 buổi thảo luận kéo dài 20 phút"],["1","Ít nhất 1 nhận xét cho ít nhất 2 chủ đề trong 1 buổi thảo luận kéo dài 10 phút"]]],["H48",1,7,"Kể lại/kể về trải nghiệm của mình","H/s sẽ có thể kể một câu truyện hay mô tả 1 sự kiện liên quan đến 1 chủ đề có ít nhất 5 phần","H/s có thể tả chuyện đi đến vườn thú gần đây nhất của mình (làm gì, ai ở đó?, nhìn thấy gì v.v...) h/s có thể kể 1 câu truyện với 3 chú lợn con\" v.v…",-1,[["2","miêu tả ít nhất 5 sự kiện / câu chuyện có ít nhất 5 phần"],["1","miêu tả ít nhất 1 sự kiện / câu chuyện có ít nhất 3 phần"]]],["H49",1,7,"Giao tiếp một cách tự nhiên","H/s có thể đưa ra những câu nhận xét phù hợp trong buổi thảo luận hay nói chuyện","",-1,[["2","Nhận xét 1 cách tự nhiên trong khi nói chuyện hay thảo luận ít nhất 10 lần mỗi ngày"],["1","Nhận xét 1 cách tự nhiên trong khi nói chuyện hay thảo luận ít nhất 10 lần một tuần (không cần nhắc)"]]],["I1",1,8,"Phát âm những tiếng rõ ràng","HS tự nói nhiều âm bao gồm cả từ có nghĩa","",-1,[["4","HS thường xuyên tự nói các từ hoặc âm có nghĩa tổng cộng ít nhất là 10 phút/giờ"],["3","tổng cộng 5 phút/giờ"],["2","tổng cộng 2 phút/giờ"],["1","âm có nghĩa tổng cộng ít nhất 10 phút/ngày"]]],["I2",1,8,"Tự động nói thành chữ hay nghe gần giống lời nói","Học sinh sẽ tự động nói nhiều chữ hay nhiều âm thanh giống lời nói","",-1,[["4","tự động khoảng 30 chữ 1 giờ (bao gồm ít nhất 5 chữ khác nhau)"],["3","trung bình ít nhất 10 chữ 1 giờ"],["2","trung bình ít nhất 1 chữ 1 giờ"],["1","ít nhất 5 chữ 1 ngày"]]],["I3",1,8,"Tự động nói thành câu","Học sinh sẽ tự động nói nhiều câu","",-1,[["4","Tự đông nói trung bình 30 nhóm từ 1 ngày (bao gồm ít nhất 5 từ khác nhau)"],["3","trung bình 10 nhóm từ 1 ngày"],["2","trung bình 5 nhóm từ 1 ngày"],["1","tự động nói trung bình 1 nhóm từ 1 ngày"]]],["I4",1,8,"Hát bài hát theo mẫu","Học sinh sẽ tự động hát theo những người đang hát khác","",-1,[["4","hát ít nhất 2 câu từ 5 bài hát"],["3","hát 1 câu từ 5 bài hát"],["2","hát 1 câu từ 2 bài hát"],["1","hát 1 câu từ 1 bài hát"]]],["I5",1,8,"Hát bài hát","Học sinh sẽ tự động hát mà không có ai hát trước","",-1,[["4","hát ít nhất 2 nhóm từ 5 bài hát"],["3","1 nhóm từ từ 5 bài hát"],["2","hát 1 nhóm từ từ 2 bài hát"],["1","1 từ từ 1 bài hát"]]],["I6",1,8,"Tự động lập lại tiếng nói","Học sinh sẽ tự động lập lại những từ do người khác nói","",-1,[["2","tự nhắc lại lời của người khác ít nhất 5 lần một ngày"],["1","tự nhắc lại lời của người khác ít nhất 5 lần một tuần"]]],["I7",1,8,"Tự động yêu cầu","Học sinh sẽ tự động yêu cầu đồ vạt, hành động hay 1 sinh hoạt nào đó","",-1,[["2","tự yêu cầu ít nhất 10 vật/hành động một ngày"],["1","tự yêu cầu ít nhất 10 vật/hành động một tuần"]]],["I8",1,8,"Tự động đặt tên","Học sinh sẽ tự động đặt tên cho đồ vật, hành động hay sự kiện","",-1,[["2","tự gọi tên sự vật, hành động, hay sự kiện ít nhất 10 vật/ngày"],["1","tự gọi tên sự vật, hành động, hay sự kiện ít nhất 10 vật/tuần"]]],["I9",1,8,"Trò chuyện tự nhiên","Học sinh sẽ tự động thêm vào những ý kiến có liên quan đến 1 mẩu đối thoại hay đàm thoại đang xảy ra","",-1,[["2","tự bình phẩm khi đang đối thoại hay tranh luận ít nhất 10 lần/ngày"],["1","tự bình phẩm khi đang đối thoại hay tranh luận ít nhất 10 lần/tuần"]]],["J1",1,9,"Số lượng trung bình các từ trong câu trả lời","HS có thể nói đoạn câu hoặc cả câu bao gồm tới 5 từ","Cậu bé đang về nhà",-1,[["4","cụm từ / câu gồm 5 từ hay hơn"],["3","4 từ"],["2","3 từ"],["1","2 từ"]]],["J2",1,9,"Cú pháp (trật tự các từ)","Học sinh biết kết hợp các từ thành cụm từ / câu theo đúng trật tự từ (td: danh từ + tính từ, động từ + trạng từ, danh từ + động từ)","danh từ + tính từ: Quả bóng đỏ, danh từ + động từ: cậu bé đang chạy, mạo từ: cậu bé đang chạy",-1,[["4","câu gồm ít nhất 4 từ đúng trật tự"],["3","thỉnh thoảng nói câu 4 từ đúng trật tự"],["2","thỉnh thoảng nói câu 3 từ đúng trật tự"],["1","thỉnh thoảng nói câu 2 từ đúng trật tự"]]],["J3",1,9,"Mạo từ","Học sinh sẽ có thể dùng mạo từ (td \"cái\" bàn) khi nói thành câu / cụm từ","một con chó, một quả táo, con lợn",-1,[["2","thường dùng mạo từ đúng chỗ"],["1","thỉnh thoảng dùng mạo từ đúng chỗ"]]],["J4",1,9,"Động từ - hiện tại tiếp diễn (ĐANG)","Học sinh biết diễn tả thì hiện tại tiếp diễn bằng cách thêm từ ĐANG vào trước động từ","đang ăn, đang ngủ, đang rửa mặt",-1,[["2","thường biết thêm từ ĐANG vào trước động từ đúng ngữ cảnh"],["1","có lúc biết thêm từ ĐANG vào trước động từ đúng ngữ cảnh"]]],["J5",1,9,"Số nhiều","Học sinh biết thêm từ CÁC, NHỮNG… vào trước danh từ để chỉ số nhiều","những cái nón, những con mèo",-1,[["2","luôn thêm từ NHỮNG/CÁC trước danh từ đúng ngữ cảnh"],["1","có lúc thêm từ NHỮNG/CÁC trước danh từ đúng ngữ cảnh"]]],["J6",1,9,"Động từ - thời quá khứ","HS biết dùng từ ĐÃ trước động từ để diễn tả thời quá khứ","bơi - đã bơi",-1,[["2","thường dùng từ ĐÃ trước động từ đúng ngữ cảnh"],["1","có lúc dùng từ ĐÃ trước động từ đúng ngữ cảnh"]]],["J7",1,9,"Nói tắt","HS biết dùng từ tắt trong câu / cụm từ khi nói (vd Bà ấy - Bả)","",-1,[["2","luôn dùng từ tắt đúng ngữ cảnh"],["1","có lúc dùng từ tắt đúng ngữ cảnh"]]],["J8",1,9,"Chia trợ động từ đúng ngôi","KHÔNG ÁP DỤNG VỚI TIẾNG VIỆT"],["J9",1,9,"Động từ - thì quá khứ thường","KHÔNG ÁP DỤNG VỚI TIẾNG VIỆT"],["J10",1,9,"Sở hữu cách","Học sinh biết dùng từ CỦA để diễn tả sở hữu cách","Xe của bố… đuôi của con mèo",-1,[["2","thường dùng từ CỦA để diễn tả sở hữu cách đúng ngữ cảnh"],["1","có lúc dùng từ CỦA để diễn tả sở hữu cách đúng ngữ cảnh"]]],["J11",1,9,"Thể phủ định","Học sinh biết dùng từ KHÔNG để nói phủ định trong câu / cụm từ","Không làm, sẽ không làm, không làm được",-1,[["2","thường dùng thể phủ định đúng ngữ cảnh"],["1","có lúc dùng thể phủ định đúng ngữ cảnh"]]],["J12",1,9,"Từ chỉ nơi chốn","Học sinh biết diễn đạt nơi chốn (ĐÂY, KIA) khi nói cả câu / cụm từ","ĐÂY - KIA",-1,[["2","thường dùng định từ đúng ngữ cảnh"],["1","có lúc dùng định từ đúng ngữ cảnh"]]],["J13",1,9,"Thì tương lai","Học sinh biết dùng từ SẼ để diễn đạt thì tương lai trong câu / cụm từ (vd tôi sẽ về)","Tôi sẽ về…",-1,[["2","thường dùng từ SẼ để chỉ thì tương lai đúng ngữ cảnh"],["1","có lúc dùng từ SẼ để chỉ thì tương lai đúng ngữ cảnh"]]],["J14",1,9,"Từ nối","Học sinh biết dùng từ nối để kết nối từ và câu (nhưng, nếu, vì, chỉ, khi, và, bởi vì, sau đó, chỉ khi, hoặc là, không mà cũng không…)","chó và mèo; mẹ hay bố; ấm nhưng không nóng",-1,[["2","thường dùng từ nối phần lớn thời gian đúng chỗ"],["1","có lúc dùng từ nối đúng chỗ"]]],["J15",1,9,"Số nhiều bất quy tắc","KHÔNG ÁP DỤNG VỚI TIẾNG VIỆT"],["J16",1,9,"Từ so sánh","Học sinh biết dùng các tiền tố/hậu tố HƠN/KÉM/NHẤT kèm với tính từ để thể hiện cấp so sánh","to hơn… to nhất.",-1,[["2","thường dùng các tiền tố/hậu tố này để thể hiện cấp so sánh đúng ngữ cảnh"],["1","có lúc dùng các tiền tố/hậu tố này để thể hiện cấp so sánh đúng ngữ cảnh"]]],["J17",1,9,"Định từ","HS biết dùng định từ (đây, kia, này, đó) để chỉ rõ các vật trong câu nói / cụm từ","",-1,[["2","thường dùng định từ để chỉ rõ các vật đúng ngữ cảnh"],["1","có lúc dùng định từ để chỉ rõ các vật đúng ngữ cảnh"]]],["J18",1,9,"Nêu mức độ chắc chắn của lời nói","HS biết dùng các từ/cụm từ để nêu mức độ chắc chắn của lời mình nói (vd tôi nghĩ là, đoán là, biết là, tin là…)","tôi nghĩ tôi đã vẽ xong.. tôi đoán là, tôi biết là, tôi tin là, có lẽ, có vẻ như là",-1,[["2","thường dùng các từ khẳng định mức độ chắc chắn của lời mình nói khi cần"],["1","có lúc dùng các từ khẳng định mức độ chắc chắn của lời mình nói"]]],["J19",1,9,"Dùng từ định lượng trong lời nói","HS biết dùng các từ/cụm từ định lượng trong lời nói (vd tất cả, một vài, thỉnh thoảng, không bao giờ, một, luôn luôn)","Tôi muốn tất cả xe tải, tất cả, thỉnh thoảng, không bao giờ, luôn luôn…",-1,[["2","thường dùng các từ chỉ định lượng khi cần"],["1","có lúc dùng các từ chỉ định lượng khi cần"]]],["J20",1,9,"Diễn tả thái độ trong lời nói","HS biết dùng từ/cụm từ để diễn tả thái độ trong lời nói (vd Tôi lấy làm tiếc phải báo cho anh biết là, Xin lỗi nhưng…, Tôi rất vui được nói là…)","tôi rất tiếc khi nghe tin anh bệnh, rất buồn là tôi không đến được, tôi mừng là anh đã đi cùng",-1,[["2","thường dùng từ để diễn tả thái độ trong lời nói khi cần"],["1","có lúc dùng từ để diễn tả thái độ trong lời nói khi cần"]]],["K1",3,10,"Khám phá đồ chơi quanh mình","Học sinh sẽ tích cực khám phá nhiều loại đồ chơi quanh mình","",-1,[["2","chơi 1 hay nhiều loại đồ chơi ít nhất 2 phút trong khoảng thời gian 10 phút"],["1","cầm và/hay chơi ít nhất 1 món đồ chơi trong vòng 10 phút"]]],["K2",3,10,"Cho phép người khác được sờ/chơi đồ chơi","HS chịu để người lớn và trẻ khác ngồi gần khi đang chơi đồ chơi và cho phép người khác thỉnh thoảng chơi đồ chơi trong khi tương tác","",-1,[["2","cho phép người lớn và các trẻ khác thỉnh thoảng được chơi đồ chơi khi HS đang chơi"],["1","cho phép trẻ khác được ngồi gần khi đang chơi đồ chơi"]]],["K3",3,10,"Các hoạt động độc lập bên ngoài","HS có thể tham gia vào các hoạt động độc lập phù hợp bên ngoài","Chơi bóng rổ, cầu trượt, xích đu, xe trẻ em, hộp cát, v.v…",-1,[["4","chọn và tham gia ít nhất 3 hoạt động trong vòng ít nhất 15 phút"],["3","3 hoạt động trong 10 phút"],["2","2 hoạt động trong 10 phút"],["1","2 hoạt động trong 5 phút"]]],["K4",3,10,"Tham gia các hoạt động vui chơi độc lập trong phòng","HS có thể tham gia vào các hoạt động độc lập phù hợp trong phòng","Xem sách hoặc video, nghe nhạc, giải đố xếp hình",-1,[["4","chọn và tham gia chơi ít nhất 3 trò trong ít nhất 15 phút"],["3","3 trò trong 10 phút"],["2","2 trò trong 10 phút"],["1","2 trò trong 5 phút"]]],["K5",3,10,"Biết chơi và sử dụng đồ chơi đúng tính năng","HS tích cực chơi đồ chơi đúng tính năng","",-1,[["2","chơi ít nhất 2 đồ chơi đúng tính năng mà không cần nhắc trong ít nhất 10 phút"],["1","chơi ít nhất 1 đồ chơi đúng tính năng trong ít nhất 10 phút đôi khi còn phải nhắc"]]],["K6",3,10,"Chơi độc lập với đồ chơi và có đối đáp bằng lời","Học sinh sẽ có thể nói chuyện khi chơi các trò chơi một mình","",-1,[["4","trong lúc chơi độc lập, có tham gia đối đáp bằng lời ít nhất 10 lần trong vòng 20 phút"],["3","5 lần đối đáp"],["2","2 lần đối đáp"],["1","1 lần trong 20 phút"]]],["K7",3,10,"Tương tác nhiều lần với đồ chơi theo 1 chủ đề","Học sinh sử dụng đồ chơi đúng chủ đề (VD đồ nhà bếp, búp bê, các nhân vật hành động)","Đẩy ôtô đồ chơi xuống dốc, giả vờ đổ xăng vào xe, cho xe vào nhà xe. Giả vờ tổ chức tiệc trà",-1,[["4","tự chơi ít nhất 5 trò với 5 loại đồ chơi"],["3","ít nhất 5 trò với 2 loại đồ chơi"],["2","ít nhất 5 trò với 1 loại đồ chơi"],["1","ít nhất 2 trò với 1 loại đồ chơi"]]],["K8",3,10,"Chơi tương tác với các bạn","Học sinh sẽ có thể tham gia các trò chơi tương tác cùng các bạn","",-1,[["4","tương tác với các bạn và đồ chơi trong vòng 10 phút (có biết yêu cầu)"],["3","tương tác với các bạn và đồ chơi trong vòng 5 phút (có biết yêu cầu)"],["2","cho bạn đồ chơi khi bạn xin và nhận đồ chơi khi bạn cho mình"],["1","nhận đồ chơi bạn cho"]]],["K9",3,10,"Chơi tương tác với nhiều bạn","HS tham gia chơi tương tác với nhiều bạn","",-1,[["4","chơi tương tác với ít nhất 8 bạn (với từng bạn hoặc trong cả nhóm)"],["3","chơi tương tác với ít nhất 6 bạn (với từng bạn hoặc trong cả nhóm)"],["2","chơi tương tác với ít nhất 4 bạn (với từng bạn hoặc trong cả nhóm)"],["1","chơi tương tác với ít nhất 2 bạn (với từng bạn hoặc trong cả nhóm)"]]],["K10",3,10,"Đóng giả các tình huống xã hội","HS chơi đóng vai các nhân vật hoặc các hoạt động","",-1,[["4","biết đóng giả ít nhất 10 nhân vật hoặc 10 hoạt động"],["3","ít nhất 5 nhân vật hoặc hoạt động"],["2","ít nhất 2 nhân vật hoặc hoạt động"],["1","ít nhất 1 nhân vật hoặc hoạt động"]]],["K11",3,10,"Vừa chơi đồ chơi vừa nói chuyện với bạn cùng lứa","Học sinh sẽ yêu cầu đồ vật hay hành động, gọi tên đồ vật và hành động, và có những bình luận khi chơi","",-1,[["4","trong khi chơi với bạn, đối đáp ít nhất 10 lần trong vòng 10 phút"],["3","5 lần đối đáp trong 10 phút"],["2","2 lần đối đáp trong 10 phút"],["1","1 lần đối đáp trong 10 phút"]]],["K12",3,10,"Chơi bóng trò đơn giản","HS biết tự chơi các trò lăn, ném, đá và đập bóng với một bạn được 5 lượt","lăn, ném, đá bóng cho bạn",-1,[["4","tự chơi bóng được ít nhất 3 trò với bạn trong 5 lượt (đợi bạn ném bóng cho, chờ xem bạn đã sẵn sàng bắt bóng chưa)"],["3","tự chơi bóng được ít nhất 2 trò trong ít nhất 3 lượt"],["2","1 trò nếu thỉnh thoảng ta nhắc bé quan sát xem bạn đã sẵn sàng bắt bóng chưa HOẶC để ý bạn sắp làm gì"],["1","1 trò nếu thỉnh thoảng ta nhắc bé quan sát xem bạn đã sẵn sàng bắt bóng chưa VÀ để ý bạn sắp làm gì"]]],["K13",3,10,"Chơi phối hợp với bạn","HS để bạn hướng dẫn chơi một hoạt động phối hợp (làm theo chỉ dẫn của bạn)","Lăn bóng nhanh hoặc chậm (tùy theo hành động hoặc theo yêu cầu của bạn chơi), cho dù bay lên và xuống theo hướng dẫn hoặc động tác của bạn chơi, làm \"trợ lý\" khi cùng bạn xây nhà bằng các khối, đu trên lốp theo cùng nhịp với bạn, chuyển từ ném bóng sang đập bóng cho bạn, đợi tín hiệu cho tàu chạy",-1,[["4","làm theo chỉ dẫn bạn nói cho và ám chỉ với ít nhất 4 trò"],["3","làm theo chỉ dẫn bạn nói cho và ám chỉ với ít nhất 3 trò"],["2","làm theo chỉ dẫn bạn nói cho và ám chỉ với ít nhất 1 trò"],["1","làm theo chỉ dẫn bạn nói ra trong ít nhất 1 trò mà không cần nhắc nhiều"]]],["K14",3,10,"Các trò chơi tương tác về vận động","HS chơi trò chơi tương tác đòi hỏi phải để ý hành động của người khác và điều chỉnh mức độ tham gia của mình tùy theo hành vi của bạn","Chơi trò đuổi bắt, chơi hội đồng tổng cốc, chơi chạy tiếp sức, đá bóng chày",-1,[["4","có thể chơi được ít nhất 3 trò tương tác không cần trợ giúp"],["3","có thể chơi được ít nhất 2 trò tương tác không cần trợ giúp"],["2","chỉ cần nhắc đôi chút để tập trung xem bao giờ đến lượt mình HOẶC hoàn thành hành động"],["1","có thể tham gia chơi nhưng cần phải nhắc để tập trung xem bao giờ đến lượt mình VÀ để hoàn thành những việc cần thực hiện khi chơi (không phải nhắc hoàn toàn)"]]],["K15",3,10,"Chơi cờ các loại","HS biết chơi cờ với bạn","Carryland, Uno, Go Fish, v.v…",-1,[["4","chơi được ít nhất 3 loại cờ không cần giúp"],["3","chơi được ít nhất 2 loại cờ không cần giúp"],["2","chỉ cần nhắc đôi chút để tập trung xem bao giờ đến lượt mình HOẶC hoàn thành hành động"],["1","có thể tham gia chơi nhưng cần phải nhắc để tập trung xem bao giờ đến lượt mình VÀ để hoàn thành những việc cần thực hiện khi chơi (không phải nhắc hoàn toàn)"]]],["L1",3,11,"Cư xử thích hợp khi gần bạn học hay anh chị","Học sinh sẽ có những hành động giao tiếp đúng đắn khi gần bạn học hay người thân","",-1,[["4","cư xử thích hợp trong ít nhất 30 phút"],["3","trong 15 phút"],["2","trong 5 phút chỉ cần nhắc 1 lần"],["1","trong ít nhất 5 phút nhưng phải nhắc nhở nhiều lần"]]],["L2",3,11,"Nhận vật người khác cho","Nhận vật yêu thích từ bạn và anh chị","",-1,[["2","luôn đi đến và nhận vật đó từ bạn và người lớn ở cách khoảng 2,5m"],["1","nhận vật đó từ bạn và người lớn ở cách khoảng 1 m"]]],["L3",3,11,"Chấp nhận/phản ứng đúng mực khi bạn và anh chị sờ vào người","HS sẽ phản ứng đúng mực (VD không khóc hoặc không tìm cách tránh xa) với những tiếp xúc thiện ý từ người khác (VD nắm và cầm tay, giúp ngồi lên xích đu)","nắm và cầm tay, giúp giải quyết rắc rối",-1,[["2","sẵn lòng để bạn/anh chị và người lớn sờ vào người một cách thiện chí và thường luôn hỗ trợ họ"],["1","cho phép người khác sờ vào một cách thiện chí và hỗ trợ họ nếu họ tiếp cận HS một cách thận trọng"]]],["L4",3,11,"Tỏ ra quan tâm đến thái độ của người khác","HS sẽ để ý hay quan tâm đến hành vi bằng lời hoặc hành động của bạn","Xem các bạn chơi đồ chơi hoặc giả vờ đóng vai một nhân vật yêu thích của trẻ em",-1,[["2","chú ý đến hành vi bằng lời hoặc hành động của bạn"],["1","chú ý đến hành động của bạn"]]],["L5",3,11,"Nhìn người khác để bắt chuyện","Học sinh sẽ nhìn người khác (người lớn và bạn học) để bắt chuyện","",-1,[["2","học sinh chủ động giao tiếp với người lớn và bạn học bằng cách nhìn họ"],["1","học sinh chỉ thỉnh thoảng nhìn để bắt chuyện"]]],["L6",3,11,"Lại gần người khác để giao lưu","Học sinh sẽ đến gần người khác và tìm cách dùng hành động để lôi cuốn người khác cùng giao lưu kể cả khi người đó không có vật hấp dẫn HS","",-1,[["2","thường xuyên lại gần và tìm cách dùng hành động để rủ người khác giao lưu"],["1","thỉnh thoảng lại gần và tìm cách dùng hành động để rủ người khác giao lưu"]]],["L7",3,11,"Nhìn người khác đợi họ làm xong một hành động yêu thích","HS sẽ nhìn người đối thoại (chờ đợi) khi người đó sắp sửa làm một hành động đem lại điều HS muốn","Chờ con búp bê trong hộp nhô ra khi bạn quay tay quay - chờ bạn xì hơi từ quả bóng để xác bóng lượn quanh phòng",-1,[["2","luôn nhìn một người đợi người đó lặp lại một hành động mong muốn"],["1","nếu được nhắc, HS sẽ nhìn một người đợi người đó lặp lại một hành động mong muốn"]]],["L8",3,11,"Nghe và đáp ứng","Học sinh sẽ có thể nghe và làm theo hướng dẫn đơn giản của 1 người khác","Lại đây, ngồi xuống, quay lại… đứng lên",-1,[["2","làm theo chỉ dẫn của người lớn và bạn học ít nhất 75% số lần"],["1","thường làm theo chỉ dẫn của người lớn ít nhất 75% số lần"]]],["L9",3,11,"Bắt chước bạn","Học sinh sẽ chú ý để lặp lại những hành động và lời nói của bạn học","Làm điệu bộ chân và tay khi hát hay nghe nhạc",-1,[["2","bắt chước các chuỗi động tác hay lời nói gồm nhiều bước của bạn học"],["1","bắt chước những động tác đơn giản, một bước của bạn học"]]],["L10",3,11,"Chào lại","Học sinh sẽ đáp lại lời chào của người khác","nhắc nhở gián tiếp: \"Phải nói thế nào?\"",-1,[["2","chào đáp lại bạn không cần nhắc"],["1","chào đáp lại bạn nhưng còn phải nhắc gián tiếp"]]],["L11",3,11,"Dùng hành động giục người khác làm 1 việc","Học sinh có đến gần và dùng hành động giục người khác làm việc gì đó","",-1,[["4","tự động giục nhiều lần"],["3","thỉnh thoảng tự động giục nhiều lần"],["2","tự động giục chỉ một lần"],["1","giục chỉ 1 lần nếu được nhắc"]]],["L12",3,11,"Hưởng ứng khi có bạn lại gần và tìm cách giao lưu","HS sẽ hồi đáp đúng mực khi có bạn lại gần và tìm cách giao lưu (VD chơi đồ chơi hay trò chơi, tham giao một hoạt động bên ngoài)","Bạn rủ tham gia chơi trò \"Hội đồng tổng cốc\" và HS sẽ ngồi tham gia cùng",-1,[["2","sẵn sàng tham gia các trò bạn rủ một cách vui vẻ"],["1","nếu bạn tiếp cận một cách thận trọng, sẽ tham gia một số trò bạn rủ"]]],["L13",3,11,"Cùng chơi - cho bạn khác đồ của mình","HS đồng ý để người khác dùng đồ vật HS đang dùng hoặc của HS","Để người khác lấy đồ của mình",-1,[["2","luôn đồng ý không cần nhắc"],["1","đồng ý khi được nhắc"]]],["L14",3,11,"Đi tìm người vắng mặt","HS sẽ đi tìm một người quan trọng với HS nếu HS không thấy người đó đâu","Khi bạn đang chơi với HS rồi đi sang một phòng khác, HS sẽ đi tìm bạn",-1,[["2","luôn đi tìm người vắng mặt sau khi đã tham gia vào một hoạt động vui nhộn với người lớn và bạn"],["1","luôn đi tìm người vắng mặt nếu người đó mang theo vật HS thích"]]],["L15",3,11,"Chủ động yêu cầu người khác chú ý đến","HS sẽ chủ động giao lưu với người khác và nhìn xem có ai để ý đến HS không","HS trèo lên cầu trượt, dậm chân và nói \"Con trượt xuống đây\" rồi nhìn xem có ai để ý đến mình không trước khi trượt xuống",-1,[["2","tham gia các hoạt động để thu hút sự chú ý của người khác và nhìn xem họ có chú ý xem HS làm gì không ít nhất 3 lần/ngày"],["1","tham gia các hoạt động để thu hút sự chú ý của người khác và nhìn xem họ có chú ý xem HS làm gì không ít nhất 6 lần/tuần (Không kể những hành động quậy phá để người khác chú ý)"]]],["L16",3,11,"Nói tên các vật cho người khác biết","Học sinh tự động nói tên các vật cho người lớn và các bạn biết","Khi bé nhìn thấy máy bay trên trời, bé sẽ chỉ và nói \"máy bay kìa\"",-1,[["4","nói tên nhiều đồ vật cho 3 bạn học và người lớn biết không cần nhắc"],["3","làm 1 lần cho 1 bạn và nhiều lần cho người lớn mà không cần nhắc"],["2","làm 1 lần cho 1 bạn không cần nhắc"],["1","1 lần cho người lớn không cần nhắc"]]],["L17",3,11,"Giao tiếp mắt","Học sinh biết giao tiếp mắt hợp lý khi giao tiếp với người khác","",-1,[["2","Khi lắng nghe và đối đáp với người lớn và bạn học"],["1","Khi lắng nghe và đối đáp với người lớn mà thôi"]]],["L18",3,11,"Hỏi xin bạn học (từng) đồ vật","Học sinh sẽ hỏi xin bạn từng vật một","Xin bạn 1 ô tô đồ chơi",-1,[["2","tự động và thường xuyên hỏi xin bạn đồ vật không cần nhắc"],["1","chỉ hỏi khi được nhắc"]]],["L19",3,11,"Chơi/dùng chung - xin được chơi/dùng chung đồ vật gì đó","Học sinh biết xin được dùng/chơi chung (nhiều) vật dụng","Cùng chơi chung đồ vật, và mỗi học sinh có phần riêng của mình",-1,[["2","thường không cần nhắc nhở"],["1","chỉ làm khi có nhắc nhở"]]],["L20",3,11,"Chia sẻ - cho người khác đồ vật của mình","Học sinh mời người khác chơi chung/dùng chung đồ vật của mình","",-1,[["4","thường tự cho nhiều lần"],["3","thỉnh thoảng tự cho nhiều lần"],["2","tự cho một lần"],["1","cho một lần khi được nhắc"]]],["L21",3,11,"Chủ động chào trước","Học sinh sẽ chủ động chào trước","VD nhắc nhở gián tiếp: \"Hãy nhìn xem ai đến kìa!\"",-1,[["2","học sinh chào bạn không cần nhắc"],["1","học sinh chào bạn khi nhắc nhở bằng lời"]]],["L22",3,11,"Tham gia cùng các bạn trong các hoạt động","HS biết tiếp cận và tham gia cùng các bạn vào một hoạt động","Khi các bạn chơi rồng rắn lên mây, HS sẽ tham gia cùng, các bạn chơi xếp khối hình, HS sẽ đến chỗ các bạn và giúp đỡ",-1,[["2","HS sẽ tham gia vào nhóm trẻ đang làm một hoạt động thích thú mà không cần người lớn gợi ý"],["1","HS sẽ tham gia vào nhóm trẻ đang làm một hoạt động thích thú chỉ khi người lớn gợi ý"]]],["L23",3,11,"Quan sát hướng chú ý của các bạn","HS biết quan sát xem các bạn đang chú ý đến vật gì hay sự kiện gì","Bọn trẻ thấy cô giáo mở lọ thổi bong bóng ra liền chạy về phía cô… HS thấy các bạn chạy về phía cô và cũng chạy đến xem có cái gì",-1,[["2","thường đến xem hoặc lại gần để tìm hiểu xem có cái gì hay sự kiện gì khi một vài bạn chuyển hướng chú ý sang vật đó hay sự kiện đó"],["1","thường đến xem hoặc lại gần để tìm hiểu xem có cái gì hay sự kiện gì khi nhiều bạn chỉ một vật hoặc di chuyển và tập trung chú ý vào một vật hay sự kiện"]]],["L24",3,11,"Tiếp thu lời nói của bạn","HS biết nghe bạn điều chỉnh hành vi để gần gũi với các bạn hơn","Đứng cách các bạn một khoảng vừa phải, ngồi trật tự, nói với giọng vừa phải, chịu đứng trong hàng, tay không nghịch ngợm",-1,[["2","thường nghe theo những gì bạn nói hoặc ngầm định trong nhiều bối cảnh"],["1","chịu nghe lời ít nhất một bạn để điều chỉnh hành vi trong ít nhất một hoàn cảnh"]]],["L25",3,11,"Điều chỉnh hành vi khi thấy bạn thay đổi hành động","Khi đang tham gia hoạt động lớp, HS biết để ý những thay đổi trong hành vi của bạn để điều chỉnh ứng xử của mình đáp lại bạn","Dừng lại khi thấy các bạn dừng (khi không nắm tay), cùng bạn bê một cái một mà không làm đổ các thứ trong hộp",-1,[["2","thường xuyên để ý và điều chỉnh theo hành vi của bạn"],["1","đôi lúc để ý và điều chỉnh theo hành vi của bạn"]]],["L26",3,11,"Giúp người khác cùng tham gia","Khi người khác cho thấy họ không thể lấy được một vật hoặc không thể quan sát hay nghe được cái gì, HS biết sắp xếp lại các thứ để bạn có thể cùng tham gia hoạt động đó","Bạn không nhìn thấy một bức tranh trong sách, HS sẽ dịch sang một bên để bạn cũng có thể nhìn thấy",-1,[["2","thường xuyên điều chỉnh để giúp bạn khi bạn gián tiếp cho biết mình có khó khăn (mình không nhìn thấy)"],["1","thường xuyên điều chỉnh để giúp bạn khi bạn yêu cầu HS làm một hành động (VD dịch sang)"]]],["L27",3,11,"Nói được người khác thích/không thích cái gì","HS có thể nói được người khác thích cái gì và hoạt động gì cũng như ai thích cái gì và hoạt động gì","Nói được Jake thích chuối còn Emily không thích. Khi hỏi ai thích ăn chuối, HS sẽ nói \"Jake\"",-1,[["2","biết ít nhất 2 vật mà ít nhất 4 người khác thích và không thích"],["1","biết ít nhất 2 vật mà ít nhất 2 người khác thích và không thích"]]],["L28",3,11,"Hướng sự chú ý của người khác đến thứ họ quan tâm","HS biết hoạt động gì, tin gì hay vật gì sẽ được người nào đó đặc biệt quan tâm và hướng sự chú ý của người đó đến những thứ đó","HS biết Jason thích bóng bầu dục, vì thế liền bảo Jason là Tyler mang bóng bầu dục đến trường hôm nay",-1,[["2","thường xuyên hướng sự chú ý của một vài bạn và người lớn đến những thứ họ quan tâm"],["1","có thể hướng sự chú ý của ít nhất 1 người đến những gì người đó quan tâm ít nhất 2 lần/tuần"]]],["L29",3,11,"Để ý phản ứng của người khác","HS biết để ý và đáp lại phản hồi của người khác cho thấy quan tâm của họ với một chủ đề hay hoạt động","HS nói về nhân vật phim mình thích nhưng để ý thấy bạn không hứng thú lắm, liền tìm một bạn khác quan tâm đến chủ đề này",-1,[["2","luôn nhận ra phản hồi trên nét mặt của bạn (VD cười và tỏ ra quan tâm, nhìn ra chỗ khác) chứng tỏ người đó có quan tâm đến thứ gì đó không"],["1","có phản ứng với mức độ quan tâm của bạn chỉ khi bạn nói thẳng ra chúng có hay không quan tâm"]]],["L30",3,11,"Truyền đạt một thông điệp","HS sẽ biết đi đến chỗ một người và nhắc lại một lời nhắn ngắn do người khác yêu cầu nói lại","Mẹ bảo bé \"bảo bố đến giúp mẹ\" và bé sẽ đi sang phòng khác và nói \"Mẹ cần bố giúp\"",-1,[["2","biết đi tìm một người, thu hút sự chú ý của họ và nói lại một lời nhắn bốn từ sau khi đi sang phòng kế bên"],["1","biết nói lại lời nhắn ba từ sau khi đến hết phòng"]]],["L31",3,11,"Đợi đến khi những người đối thoại dừng lời mới nói xen vào","HS biết đợi đến khi những người đang đối thoại dừng lời mới nói với một người trong số đó","Hai người đang nói chuyện, bé sẽ đợi (nhìn) cho đến khi một trong hai người đồng ý thì mới nói",-1,[["2","khi người khác đang nói chuyện, bé luôn đợi một người nhìn bé rồi mới nói hoặc tập trung sự chú ý của họ một cách đúng mực (xin lỗi)"],["1","sẽ đợi người đối thoại nói xong nếu một trong số họ ra hiệu bé hãy đợi"]]],["L32",3,11,"Trò chuyện với người khác","HS sẽ trò chuyện với các bạn và người lớn trao đổi qua lại 3 lượt","",-1,[["4","ít nhất 3 lần trao đổi với bạn và người lớn"],["3","2 lần trao đổi với bạn và người lớn"],["2","1 lần trao đổi với bạn và người lớn"],["1","1 lần trao đổi với người lớn"]]],["L33",3,11,"Hỏi thông tin","Học sinh tự động hỏi người lớn và bạn để biết thông tin","",-1,[["2","thường xuyên tự động hỏi người lớn và bạn thông tin"],["1","thỉnh thoảng tự động hỏi người khác thông tin"]]],["L34",3,11,"Giành lấy và duy trì sự chú ý của người khác","Học sinh sẽ có thể giành lấy và duy trì sự chú ý của người khác trước khi hướng dẫn người đó","gọi tên người đó, vỗ vào vai người đó, đi đến trước mặt người đó",-1,[["4","giành và duy trì được tương tác với bạn và người lớn"],["3","kiên trì tìm cách thu hút sự chú ý của người lớn và bạn"],["2","có thể giành sự chú ý của những người lớn và bạn học đang quan tâm đến bé"],["1","có thể giành sự chú ý của những người lớn đang quan tâm đến bé"]]],["M1",2,12,"Ngồi sinh hoạt theo nhóm nhỏ","HS sẽ ngồi yên không quấy phá trong 1 nhóm học tập nhỏ","",-1,[["4","nhóm 1 cô : 4 trò trong 15 phút"],["3","nhóm 1:3 trong 10 phút"],["2","nhóm 1:2 trong 10 phút"],["1","nhóm 1:2 trong 5 phút"]]],["M2",2,12,"Ngồi sinh hoạt theo nhóm lớn","HS sẽ ngồi yên không quấy phá trong 1 nhóm học tập","",-1,[["4","nhóm 1 cô : 16 trò trong 15 phút"],["3","nhóm 1:12 (hay 1:16)"],["2","nhóm 1:8"],["1","nhóm 1:6 trong 15 phút"]]],["M3",2,12,"Chú ý đến GV trong nhóm","HS sẽ chú ý đến lời của GV trong lúc học nhóm nhỏ","HS chú ý và làm theo lệnh của GV",-1,[["4","nhóm 1:4 75% thời gian"],["3","nhóm 1:3 75% thời gian"],["2","nhóm 1:2 75% thời gian"],["1","nhóm 1:2 50% thời gian"]]],["M4",2,12,"Chú ý đến HS khác trong nhóm","HS sẽ chú ý đến những câu trả lời của HS khác trong giờ học nhóm nhỏ","HS quay sang theo dõi những HS khác đang nói và trả lời",-1,[["4","nhóm 1:4 75% thời gian"],["3","nhóm 1:3 75% thời gian"],["2","nhóm 1:2 75% thời gian"],["1","nhóm 1:2 50% thời gian"]]],["M5",2,12,"Tuân theo chỉ dẫn nhóm - thống nhất cách hiểu và trả lời","HS sẽ tuân theo chỉ dẫn chung của nhóm","Mọi người hãy cho tay lên đầu",-1,[["4","trong nhóm 1:4, trả lời cùng lúc với các bạn với 75% các câu hỏi đã biết"],["3","nhóm 1:3 với 75% các câu hỏi đã biết"],["2","nhóm 1:2 với 75% các câu hỏi đã biết"],["1","nhóm 1:2 với 50% các câu hỏi đã biết"]]],["M6",2,12,"Làm theo chỉ dẫn chung trong nhóm có phân biệt đối tượng","HS sẽ làm theo chỉ dẫn của nhóm yêu cầu HS biết phân biệt","Ai mặc áo xanh thì đứng lên - Ai mặc áo đỏ thì xếp thành hàng",-1,[["4","nhóm 1: 4 với 75% các câu hỏi đã biết"],["3","nhóm 1:3 với 75% các câu hỏi đã biết"],["2","nhóm 1:2 với 75% các câu hỏi đã biết"],["1","nhóm 1:2 với 50% các câu hỏi đã biết"]]],["M7",2,12,"Giơ tay để thu hút sự chú ý của GV đến một hoạt động","HS sẽ giơ tay xin trả lời câu hỏi ai muốn làm một hoạt động trước một nhóm HS","Khi GV hỏi \"Ai muốn hát bài hát tiếp theo nào?\" HS sẽ giơ tay xin trả lời câu hỏi",-1,[["2","tự giơ tay nhận làm một hoạt động nào đó với 50% số lần được hỏi trong nhóm có ít nhất 8 HS"],["1","tự giơ tay nhận làm một hoạt động nào đó với 50% số lần được hỏi trong nhóm có ít nhất 4 HS"]]],["M8",2,12,"Giơ tay để trả lời câu hỏi","HS biết giơ tay để trả lời những câu hỏi đơn giản","Ai đến lớp bằng xe buýt thì giơ tay, ai thích bánh sô cô la thì giơ tay --- chủ yếu là hồi đáp có/không",-1,[["2","có thể tự trả lời các câu hỏi"],["1","chỉ cần nhắc bằng cử chỉ với tối đa 50% các câu hỏi đã biết"]]],["M9",2,12,"Giơ tay và nói tên đồ vật","Học sinh biết giơ tay và nói tên 1 vật bày trước lớp/nhóm","GV hỏi cả nhóm: \"Có ai biết cái này là cái gì không?\", HS giơ tay và trả lời khi được GV gọi",-1,[["2","có thể tự trả lời các câu hỏi đã biết"],["1","chỉ cần nhắc bằng cử chỉ phải giơ tay xin trả lời với tối đa 50% các câu hỏi đã biết"]]],["M10",2,12,"Giơ tay và trả lời câu hỏi","HS biết giơ tay xin trả lời những câu hỏi đơn giản","GV hỏi cả nhóm: \"Mọi người, ai biết ….chúng ta có thể ăn gì vào bữa sáng?\"",-1,[["2","có thể trả lời câu hỏi 1 cách độc lập"],["1","chỉ cần nhắc bằng cử chỉ phải giơ tay xin trả lời với tối đa 50% các câu hỏi đã biết"]]],["M11",2,12,"Đợi đến lượt trong giờ học nhóm","HS sẽ biết chờ đến lượt mình trong giờ sinh hoạt nhóm","",-1,[["2","điềm tĩnh chờ đến lượt và 75% thời gian không cần nhắc"],["1","75% thời gian có nhắc nhở"]]],["M12",2,12,"Học tập thêm nhiều kỹ năng mới trong giờ học nhóm","HS sẵn sàng tiếp thu thêm những kỹ năng học đường mới trong lúc học nhóm","",-1,[["2","sẵn sàng học thêm kỹ năng mới"],["1","học thêm kỹ năng mới sau nhiều lần dạy"]]],["N1",2,13,"Tuân theo lịch sinh hoạt thường ngày (soạn balô…)","HS biết tự động làm theo các nếp sinh hoạt thường ngày của lớp","",-1,[["2","tự động làm"],["1","làm theo 50% chỉ dẫn không cần lời nhắc"]]],["N2",2,13,"Độc lập trong những sinh hoạt ngoại khóa","HS độc lập trong những sinh hoạt ngoại khóa","ráp hình",-1,[["4","trong vòng 20 phút"],["3","15 phút"],["2","10 phút"],["1","5 phút"]]],["N3",2,13,"Ngồi đợi trật tự khi đang chuyển giờ","Khi đang chuyển giờ học, HS sẽ ngồi đợi trật tự để bắt đầu giờ học tiếp theo","",-1,[["2","biết tự chờ trong 2 phút"],["1","tự chờ trong vòng 30 giây"]]],["N4",2,13,"Di chuyển sang khu vực khác","HS sẽ trật tự di chuyển theo yêu cầu đến một khu vực khác trong lớp để thay đổi hoạt động chính khóa","",-1,[["2","tự làm"],["1","làm theo 50% chỉ dẫn không cần nhắc"]]],["N5",2,13,"Chờ đến phiên mình để làm gì đó (rửa tay…)","Học sinh sẽ chờ đến phiên mình trong các sinh hoạt của lớp học","",-1,[["2","tự làm trong 2 phút"],["1","tự làm trong 30 giây"]]],["N6",2,13,"Xếp hàng khi được yêu cầu","Học sinh sẽ đứng thành hàng theo yêu cầu và chịu đứng yên trong hàng","",-1,[["2","tự động làm"],["1","làm theo 50% chỉ dẫn không cần nhắc"]]],["N7",2,13,"Độc lập trong những hoạt động chính khóa","Học sinh sẽ làm việc độc lập trong học tập","lập bảng tính toán",-1,[["4","trong vòng 20 phút"],["3","15 phút"],["2","10 phút"],["1","5 phút"]]],["N8",2,13,"Lấy và trả học cụ","Học sinh sẽ theo hướng dẫn lấy và trả học cụ của mình","Học sinh cất sách vở của mình lên kệ khi được yêu cầu vào cuối giờ học",-1,[["2","tự động làm"],["1","làm theo 50% chỉ dẫn không cần nhắc"]]],["N9",2,13,"Hoàn thành bài tập, mang bài làm đến nộp giáo viên hoặc cất đồ dùng đi","HS sẽ theo yêu cầu hoàn thành bài tập và mang bài đến nộp cho giáo viên hoặc cất đồ dùng đi","Khi làm xong, HS cất vở bài tập đúng chỗ khi làm xong bài mà không cần nhắc",-1,[["2","tự động làm"],["1","làm theo 50% chỉ dẫn không cần nhắc"]]],["N10",2,13,"Đứng chờ chuyển giờ","HS sẽ đứng chờ trật tự khi chuyển giờ sang hoạt động khác","",-1,[["2","tự động trong vòng 3 phút"],["1","50% số lần không cần nhắc"]]],["P1",2,14,"Tổng hợp khái quát các yêu cầu/bài tập","Học sinh có thể vận dụng kỹ năng đã có với một vật để áp dụng vào một vật tương tự","Nếu học sinh đã biết gọi một chiếc cốc màu nâu là \"cốc\", học sinh cũng sẽ biết gọi những chiếc cốc màu xanh, màu vàng và kẻ sọc là \"cốc\"",-1,[["2","khi đã biết thực hiện yêu cầu gọi tên và nhận biết, sẽ lập tức biết vận dụng thực hiện nhiều yêu cầu cùng loại sau 2 lần dạy"],["1","tổng hợp khái quát giữa các vật tương tự sau 10 lần dạy"]]],["P2",2,14,"Tổng hợp khái quát kỹ năng học được từ các giáo viên","Học sinh có thể vận dụng các kỹ năng học từ giáo viên này để hồi đáp với các giáo viên khác","Nếu học sinh đã được giáo viên này dạy cách gọi tên cái \"cốc\", thì sẽ biết gọi tên cái cốc khi giáo viên khác yêu cầu",-1,[["2","sẵn sàng vận dụng các kỹ năng đã biết để hồi đáp với giáo viên mới"],["1","có thể học với ít nhất 4 giáo viên"]]],["P3",2,14,"Tổng hợp khái quát trong các môi trường","Học sinh có thể vận dụng các kỹ năng đã thu nhận từ môi trường này sang môi trường khác.","Nếu học sinh đã biết gọi tên cái \"cốc\" ở trường thì sẽ biết gọi tên cái \"cốc\" khi ở nhà",-1,[["2","dễ dàng vận dụng các kỹ năng đã học trong lớp ra môi trường ngoài lớp học mà không cần nhắc"],["1","vận dụng các kỹ năng đã học trong lớp ra môi trường ngoài lớp học với lời nhắc không đáng kể"]]],["P4",2,14,"Vận dụng các kỹ năng đã biết trong hoạt động nhóm","Học sinh có thể vận dụng các kỹ năng đã học trong tiết học cá nhân vào tiết học nhóm với các bạn","Nếu học sinh biết gọi tên cái cốc trong tiết học cá nhân thì cũng sẽ biết gọi tên cái cốc khi tham gia học trong nhóm nhỏ",-1,[["2","tự biết vận dụng các kỹ năng đã học trong khi học nhóm"],["1","biết vận dụng các kỹ năng đã học khi học nhóm nếu được nhắc đôi chút bằng lời"]]],["P5",2,14,"Tổng hợp khái quát các dạng hồi đáp","Khi đã biết một cách hồi đáp với một tình huống, học sinh sẽ biết xử lý tình huống đó bằng nhiều cách khác","Khi nhìn thấy con chó, học sinh có thể nói \"chó\", \"cún\", \"cẩu\", \"ki ki\"… Khi được hỏi về \"những thứ để ăn\" học sinh có thể nói \"táo, chuối, bánh mì\" hay \"bánh ngọt, bánh piza, táo\"",-1,[["2","Tự biết dùng nhiều và đa dạng các cách trả lời phù hợp chứ không chỉ một dạng"],["1","biết vài cách trả lời khác nhau khi được nhắc đôi chút bằng lời"]]],["P6",2,14,"Tổng hợp khái quát các kỹ năng ngôn ngữ","Học sinh có thể vận dụng những từ học được từ kỹ năng ngôn ngữ này sang các kỹ năng ngôn ngữ khác","Khi đã biết dùng từ \"cốc\" để gọi tên cái cốc, học sinh sẽ biết dùng từ \"cốc\" để xin cái cốc và phân biệt nhận biết cốc. Nếu học sinh đã nhận ra cái cốc khi cô nói \"con uống bằng vật này\", học sinh sẽ biết trả lời \"cốc\" với câu hỏi \"con uống bằng cái gì?\"",-1,[["2","Khi học sinh đã biết nhận ra một vật khi biết chức năng, học sinh sẽ biết gọi tên vật đó khi biết chức năng"],["1","Khi đã biết gọi tên một vật, học sinh sẽ biết yêu cầu và nhận ra vật đó"]]],["Q1",4,15,"Nhận mặt chữ","Học sinh sẽ nhận được mặt chữ hoa và chữ thường","Khi được cho xem 3 chữ, học sinh có thể chỉ ra đâu là chữ B",-1,[["4","Nhận dạng được 26 chữ cái"],["3","có thể nhận dạng ít nhất 15 chữ cái"],["2","nhận dạng ít nhất là 10 chữ cái"],["1","nhận dạng ít nhất 5 chữ cái"]]],["Q2",4,15,"Nói tên các chữ cái","Học sinh sẽ nói được tên của các chữ hoa và chữ thường","Khi cho xem chữ B hoa, học sinh sẽ nói được \"đây là chữ B\"",-1,[["4","có thể nói được tên của 26 chữ cái"],["3","có thể nói được tên của 15 chữ cái"],["2","có thể nói được tên của ít nhất 10 chữ cái"],["1","có thể nói được tên của ít nhất 5 chữ cái"]]],["Q3",4,15,"Nhận ra âm của các chữ cái","Học sinh sẽ có thể chỉ ra chữ nào vừa được phát âm","Đưa cô chữ đọc là \"ssss\"",-1,[["4","có thể nhận ra âm của ít nhất 20 chữ cái"],["3","nhận dạng âm của 10 chữ cái"],["2","nhận dạng âm của ít nhất 5 chữ cái"],["1","nhận dạng âm của ít nhất 2 chữ cái"]]],["Q4",4,15,"Đọc được chữ cái","Học sinh sẽ có thể đọc được các chữ cái","Chữ này đọc thế nào nhỉ? (giơ cho học sinh thấy chữ B)",-1,[["4","có thể nhận ra âm của ít nhất 20 chữ cái"],["3","nhận dạng âm của 10 chữ cái"],["2","nhận dạng âm của ít nhất 5 chữ cái"],["1","nhận dạng âm của ít nhất 2 chữ cái"]]],["Q5",4,15,"Ghép chữ với ảnh","Học sinh có thể ghép chữ với ảnh","Khi được đưa thẻ chữ \"mèo\" và 3 ảnh con mèo, chó, và chim, học sinh sẽ ghép đúng thẻ chữ với ảnh tương ứng là mèo",-1,[["4","có thể ghép ít nhất 20 từ với ảnh tương ứng"],["3","có thể ghép 10 từ với ảnh tương ứng"],["2","ghép 5 từ với ảnh tương ứng"],["1","ghép 2 từ với ảnh tương ứng"]]],["Q6",4,15,"Ghép từ với từ","Học sinh có thể ghép 1 thẻ chữ với thẻ chữ tương ứng nhưng khác phông khi đưa ra 3 thẻ chữ khác nhau để lựa chọn","Khi đưa cho HS thẻ chữ \"con dơi\" và 3 thẻ chữ khác kiểu chữ (con dơi, mèo, và cái mũ), HS sẽ ghép đúng với thẻ chữ tương ứng",-1,[["4","khác phông có 1 chữ khác trong từ không định để ghép"],["3","cùng phông, chỉ 1 chữ khác"],["2","cùng phông, 2 chữ khác ở thẻ chữ không định để ghép"],["1","cùng phông, 3 chữ khác không phải ở thẻ chữ tương ứng"]]],["Q7",4,15,"Đọc từng chữ trong một từ từ trái sang phải","Học sinh sẽ có thể đọc từng chữ trong một từ từ trái sang phải","Khi cho xem chữ \"ma\", học sinh sẽ nói m-a",-1,[["2","có thể chỉ và đọc chữ trong từ 5 chữ (từ trái sang phải mà không cần nhắc)"],["1","có thể chỉ và đọc chữ trong từ 3 chữ (từ trái sang phải mà chỉ cần nhắc 1 lần cho 1 chữ)"]]],["Q8",4,15,"Ghép từng chữ rời thành từ trong thẻ chữ","Học sinh có thể ghép từng chữ rời thành từ trên thẻ 5 chữ","Khi có bảng chữ có từ \"tàu\", học sinh sẽ có thể tìm, những chữ cái thích hợp để ghép thành chữ \"tàu\"",-1,[["2","có thể ghép chữ rời thành từ có tới 5 chữ khi đưa cho cả những chữ không cần dùng đến (td: từ \"mai\" thì đưa cả chữ m-a-i- và e-a)"],["1","có thể ghép chữ rời thành từ có tới 3 chữ khi không đưa chữ thừa nào và kiểu chữ không giống nhau (td: từ \"ma\" thì chỉ đưa chữ m-a)"]]],["Q9",4,15,"Điền chữ / từ thiếu","Khi đưa ảnh của 1 vật và 2 - 3 chữ… học sinh biết lấy thêm 1 chữ điền vào cho đủ thành từ có nghĩa tương ứng với ảnh","Khi có ảnh con chó và có 2 chữ c-ó, học sinh sẽ lấy thêm chữ h để ghép thành từ \"chó\"",-1,[["2","có thể điền chữ ở bất cứ vị trí nào với 10 từ"],["1","có thể điền chữ ở ít nhất 1 vị trí với ít nhất 5 từ"]]],["Q10",4,15,"Đọc những từ đơn giản","Học sinh có thể đọc được các từ","",-1,[["4","có thể đọc ít nhất 50 từ"],["3","có thể đọc ít nhất 10 từ"],["2","có thể đọc ít nhất 10 từ"],["1","có thể đọc ít nhất 5 từ"]]],["Q11",4,15,"Tự luận ra/giải mã từ mới","Học sinh sẽ có thể tự luận ra/giải mã từ mới","",-1,[["2","có thể tự luận ra cách đọc của 20 từ mới (chưa biết mặt hoặc cách đọc) gồm ít nhất 4 chữ"],["1","có thể tự luận ra/giải mã bất cứ từ nào có phụ âm-nguyên âm-phụ âm dựa trên những âm vị đã biết"]]],["Q12",4,15,"Đọc tập hợp một số từ từ trái sang phải","Học sinh có thể đọc được các cụm từ","",-1,[["4","có thể đọc bất kỳ cụm từ nào có những từ đã biết"],["3","có thể đọc 10 cụm 3 từ"],["2","có thể đọc 5 cụm 3 từ"],["1","có thể đọc 2 cụm 3 từ"]]],["Q13",4,15,"Đọc câu đơn giản gồm 3 đến 6 từ","Học sinh sẽ có thể đọc cả câu","",-1,[["4","có thể đọc bất cứ câu nào có từ quen thuộc"],["3","có thể đọc 10 câu gồm 4 đến 6 từ"],["2","đọc 5 câu gồm 4 đến 6 từ"],["1","đọc 2 câu gồm 4 đến 6 từ"]]],["Q14",4,15,"Điền từ thiếu","Học sinh sẽ có thể chọn 1 trong số nhiều từ để điền cho chọn vẹn 1 câu không hoàn chỉnh","",-1,[["2","có thể chọn từ thích hợp trong số 3 từ khác nhau 50% mặt chữ"],["1","có thể chọn từ thích hợp trong số 2 từ khác hơn 50% mặt chữ"]]],["Q15",4,15,"Đọc và làm theo những chỉ dẫn đơn giản","HS biết đọc và làm theo những chỉ dẫn đơn giản","Lại lấy cốc, đặt búp bê lên giường, ôm búp bê, để cốc lên bệ rửa, đưa cho Jason cái bút chì, cho giày vào hộp, đội mũ của bố lên",-1,[["2","có thể đọc được ít nhất 20 câu và làm được ít nhất 6 hành động đơn giản"],["1","có thể đọc được ít nhất 10 câu và làm được ít nhất 3 hành động đơn giản (vd đưa, lấy, đặt, mặc vào, cho vào)"]]],["Q16",4,15,"Đọc và làm theo những chỉ dẫn đơn giản trên tờ giao việc","HS biết đọc và làm theo những chỉ dẫn đơn giản trên tờ giao việc","Vẽ một đường thẳng nối con khỉ với quả chuối, gạch chân chữ A và đánh dẫu X vào hình tròn, tô hình vuông màu đỏ, vẽ một hình khối quanh cái cây, viết số 3 trong hình tam giác",-1,[["2","có thể đọc được ít nhất 20 câu và làm được ít nhất 6 chỉ dẫn khác nhau"],["1","có thể đọc được ít nhất 10 câu và làm được ít nhất 3 chỉ dẫn khác nhau (vd khoanh tròn, gạch chân, tô màu)"]]],["Q17",4,15,"Đọc đoạn văn và trả lời câu hỏi về nội dung đoạn văn","Học sinh có thể đọc các câu và trả lời những câu hỏi đọc hiểu về các câu đó","",-1,[["2","có thể đọc 3 câu và trả lời những câu hỏi đơn giản liên quan đến nội dung"],["1","có thể đọc 1 câu đơn giản và trả lời 1 câu đơn giản về nội dung"]]],["R1",4,16,"Thuộc lòng số đếm khi được nhắc","Học sinh sẽ có thể tiếp tục đếm đến 10 khi có người đếm đoạn đầu","",-1,[["2","có thể tiếp tục đếm đến 10 khi có người đếm trước 1, 2"],["1","có thể đếm theo giáo viên đến 10 (bắt chước)"]]],["R2",4,16,"Thuộc lòng số đếm","Học sinh thuộc lòng số đếm đến 100","",-1,[["4","có thể đếm đến bất cứ số nào trong phạm vi 30"],["3","đếm đến 30"],["2","đến 20"],["1","đến 10"]]],["R3",4,16,"Đếm vật khi được nhắc","Học sinh có thể đếm vật tiếp đến 10 khi có người đếm lúc đầu","",-1,[["2","có thể đếm vật tiếp đến 10 nếu ta nhắc phần đầu 1, 2"],["1","có thể đếm theo GV đến 10 (nói theo) kể cả khi GV thay đổi tốc độ đếm (vd 1,2…(dừng) 3,…,4, 5…,6,v.v…)"]]],["R4",4,16,"Đếm vật được đưa","Học sinh sẽ có thể đếm vật được đưa kể cả khi các vật đó không được xếp thành hàng thẳng","",-1,[["4","có thể đếm đến đến bất cứ số nào trong phạm vi 100"],["3","trong phạm vi 20"],["2","trong phạm vi 10"],["1","trong phạm vi 5 kể cả khi các vật không được xếp thành hàng thẳng"]]],["R5",4,16,"Đếm để lấy ra một số lượng vật nhất định","HS có thể đếm để lấy ra một số lượng nhất định từ một lượng nhiều hơn","Khi đưa HS 7 khối gỗ và yêu cầu \"lấy cho cô 5 khối\", HS sẽ đếm để lấy ra 5 khối",-1,[["4","có thể đếm bất kỳ số lượng nào trong phạm vi 30"],["3","trong phạm vi 20"],["2","trong phạm vi 10"],["1","trong phạm vi 5"]]],["R6",4,16,"Đọc chữ số theo thứ tự","Học sinh biết đọc chữ số trong một dãy số (từ bé đến lớn hoặc ngược lại)","",-1,[["2","biết đọc dãy số từ 1 đến 10"],["1","biết đọc dãy số từ 1 đến 10 khi được nhắc \"1, 2…\" và GV chỉ vào từng số"]]],["R7",4,16,"Gọi tên các mặt số","Học sinh biết tên các số trong phạm vi 100","",-1,[["4","biết mặt số trong phạm vi 100"],["3","trong phạm vi 30"],["2","trong phạm vi 20"],["1","trong phạm vi 10"]]],["R8",4,16,"Ghép số với lượng vật tương ứng","Học sinh biết ghép số với lượng vật tương ứng và ngược lại","",-1,[["4","có thể ghép lượng vật với số (và ngược lại) trong phạm vi 30"],["3","có thể ghép lượng vật với số trong phạm vi 20"],["2","có thể ghép lượng vật với số trong phạm vi 10"],["1","có thể ghép lượng vật với số trong phạm vi 5"]]],["R9",4,16,"\"hơn\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"hơn\"","",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R10",4,16,"\"kém\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"kém\"","",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R11",4,16,"\"một vài\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"một vài\"","",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R12",4,16,"\"tất cả\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"tất cả\"","",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R13",4,16,"\"số không/không\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"số không/không\"","Phân biệt - Khi đưa 2 cái bát, một đựng bỏng ngô, một không có gì, và hỏi \"cái nào không có gì?, HS chỉ sang cái bát không có gì. Chỉ ra trường hợp - khi cho HS xem một cái lọ bánh không có gì, và hỏi \"có mấy cái bánh trong lọ?\" HS trả lời \"không có gì\"",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R14",4,16,"Thêm vật để có một lượng nhất định","Khi đưa cho học sinh một số lượng vật, HS biết số lượng phải lấy thêm để được một lượng nhất định","Đưa HS 2 cái thìa và yêu cầu cần có 4 cái thìa, HS sẽ lấy thêm 2 cái thìa",-1,[["2","biết lấy thêm vật để có được số lượng trong phạm vi 10"],["1","biết lấy thêm vật để có được số lượng trong phạm vi 5"]]],["R15",4,16,"\"giống\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"giống\"","",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R16",4,16,"\"khác\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"khác\"","",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R17",4,16,"\"lớn/nhiều hơn\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"lớn/nhiều hơn\"","",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R18",4,16,"\"thêm\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"thêm\"","Phân biệt - khi đưa 5 khối hình để trong đĩa cùng một số khối để ngoài, và yêu cầu \"thêm 2 khối nữa\", HS sẽ đặt thêm khối vào đĩa. Chỉ ra trường hợp - khi cho HS thấy cô đang cho đậu vào lọ và hỏi \"cô đang làm gì nhỉ?\" HS nói \"cho thêm đậu vào\"",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R19",4,16,"Đi lấy ra một lượng nhất định từ một lượng nhiều hơn","HS biết đi cách đó ít nhất khoảng 3m và đếm để lấy về một lượng nhất định các vật giống nhau (trong phạm vi 10) từ một lượng nhiều hơn","Khi hỏi HS \"Đi lấy 5 cái thìa cho cô\", HS sẽ đi đến ngăn kéo tủ và lấy 5 cái thìa về",-1,[["4","lấy được lượng trong phạm vi 10"],["3","lấy được lượng trong phạm vi 6"],["2","lấy được lượng trong phạm vi 6"],["1","lấy được lượng trong phạm vi 2"]]],["R20",4,16,"Cộng các số với nhau","Học sinh có thể cộng các số với nhau có phải nhớ thêm một hàng đơn vị (vd: 7+6=13 viết 3 nhớ 1)","",-1,[["4","cộng 2 số trong phạm vi từ 1-99 có phải nhớ thêm một hàng đơn vị"],["3","cộng 2 số trong phạm vi từ 1-20 có phải nhớ thêm một hàng đơn vị"],["2","cộng 2 số trong phạm vi từ 1-20 không phải nhớ thêm một hàng đơn vị"],["1","cộng 2 số từ 1-10"]]],["R21",4,16,"Biết xem giờ","Học sinh biết xem giờ nói chính xác đến từng phút","",-1,[["4","chính xác đến từng phút"],["3","đến từng khoảng 15 phút"],["2","đến từng khoảng 1/2 giờ"],["1","đến từng giờ"]]],["R22",4,16,"Nói đúng tên tiền xu","HS biết tên tất cả các loại tiền xu","",-1,[["2","phân biệt được tên của 4 loại tiền xu"],["1","phân biệt được tên của 2 loại tiền xu"]]],["R23",4,16,"Phân biệt giá trị của tiền xu","HS biết phân biệt giá trị của tất cả các loại tiền xu","",-1,[["2","phân biệt được giá trị của 4 loại tiền xu"],["1","phân biệt được giá trị của 2 loại tiền xu"]]],["R24",4,16,"Trao đổi tiền xu để được giá trị tương đương","HS biết đổi tiền xu để được giá trị tương đương","",-1,[["4","biết cộng giá trị của các loại tiền xu trong phạm vi 1 nghìn đồng"],["3","trong phạm vi 5 trăm đồng"],["2","trong phạm vi 2 trăm 50 đồng"],["1","trong phạm vi 1 trăm đồng"]]],["R25",4,16,"\"bằng nhau\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"bằng nhau\"","",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R26",4,16,"\"không bằng nhau\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"không bằng nhau\"","",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R27",4,16,"\"trừ\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"trừ\"","",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R28",4,16,"\"cộng\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"cộng\"","",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["R29",4,16,"\"bớt đi/lấy đi\"","HS có thể phân biệt và chỉ ra những trường hợp ứng với từ \"bớt đi/lấy đi\"","Phân biệt - khi đưa 5 khối hình để trong đĩa cùng một số khối để ngoài, và yêu cầu \"bớt đi 2 khối\", HS sẽ lấy các khối ra khỏi đĩa. Chỉ ra trường hợp - khi cho HS thấy cô đang lấy khối ra khỏi đĩa và hỏi \"cô đang làm gì nhỉ?\" HS nói \"lấy đi\"",-1,[["2","biết phân biệt VÀ chỉ ra những trường hợp tương ứng"],["1","biết phân biệt HOẶC chỉ ra những trường hợp tương ứng"]]],["S1",4,17,"Vẽ trên giấy","Học sinh sẽ có thể vẽ trên giấy","",-1,[["2","có thể cầm bút chì hay bút sáp màu đúng cách và vẽ đường kẻ trên giấy"],["1","dùng bút chì hay bút sáp vẽ đường kẻ ngắn trên giấy"]]],["S2",4,17,"Tô màu giữa các đường kẻ","HS biết tô màu giữa các đường kẻ","",-1,[["2","biết tô màu gọn gàng trong các đường kẻ vẽ các hình khác nhau (tối đa khoảng 5 cm2)"],["1","biết tô màu gọn gàng trong đường kẻ của một hình vẽ to (tối đa khoảng 10cm2)"]]],["S3",4,17,"Đồ theo các đường thẳng và hình vẽ","HS biết đồ theo các đường thẳng và hình vẽ","",-1,[["4","đồ theo các đường kẻ, hình có đường cong và thẳng"],["3","đồ theo các hình có đường cong (hình tròn và ô van) HOẶC đường thẳng (hình vuông, hình tam giác, hình chữ nhật) chỉ trệch ra ngoài hình mẫu khoảng 3-6mm"],["2","đồ theo đường thẳng và đường cong"],["1","đồ theo đường thẳng"]]],["S4",4,17,"Đồ theo chữ và số","HS biết đồ theo chữ và số","",-1,[["2","đồ theo chữ và số chỉ trệch ra ngoài hình mẫu từ 3-6mm"],["1","đồ theo các chữ chỉ có đường thẳng (vd A, E, F, 1, 4, 7)"]]],["S5",4,17,"Bắt chước vẽ đường thẳng","HS biết vẽ lại đường thẳng đơn giản","",-1,[["4","vẽ lại các đường thẳng và các hình gọn gàng (đúng cả hình dáng và chiều hướng)"],["3","vẽ lại gần giống các đường thẳng và các hình"],["2","vẽ lại gần giống các đường thẳng có cần trợ giúp"],["1","vẽ lại các đường thẳng đơn giản có cần cầm tay trợ giúp và chỉ cho"]]],["S6",4,17,"Bắt chước vẽ đường cong","Học sinh biết bắt chước vẽ lại đường cong","",-1,[["4","vẽ lại các đường cong và các hình gọn gàng (đúng hình dáng, kích thước, và hướng)"],["3","vẽ lại gần giống các đường cong phức tạp"],["2","vẽ lại gần giống các đường cong đơn giản có cần trợ giúp"],["1","vẽ lại gần giống các đường cong đơn giản có cần trợ giúp cầm tay hoặc chỉ cho"]]],["S7",4,17,"Viết chữ theo mẫu","Học sinh có thể viết lại chữ","",-1,[["4","viết nắn nót tất cả các chữ hoa và thường gọn trong đường kẻ"],["3","viết nắn nót ít nhất 10 chữ hoa và thường"],["2","viết lại gần giống 10 chữ"],["1","viết lại gần giống 5 chữ"]]],["S8",4,17,"Viết số theo mẫu","Học sinh có thể viết lại số","",-1,[["4","viết lại nắn nót từ số 1 đến số 100"],["3","viết lại nắn nót từ số 1 đến số 20"],["2","viết lại gần giống từ số 1đến số 10"],["1","viết lại gần giống 5 số bất kỳ"]]],["S9",4,17,"Tự viết chữ","Học sinh sẽ có thể tự viết chữ mà không cần theo mẫu","",-1,[["4","có thể viết các chữ hoa và không hoa trong hàng"],["3","viết được ít nhất 10 chữ"],["2","có thể viết lại gần giống 10 chữ"],["1","có thể viết lại gần giống 5 chữ mà không cần mẫu"]]],["S10",4,17,"Tự viết số","Học sinh sẽ có thể tự viết số mà không cần theo mẫu","",-1,[["4","viết nắn nót từ số 1 đến số 100"],["3","viết nắn nót từ số 1 đến số 20"],["2","viết gần giống từ số 1đến số 10"],["1","viết gần giống 5 số bất kỳ không cần mẫu"]]],["T1",4,18,"Ghép từng thẻ chữ với các chữ trên thẻ từ","Học sinh biết ghép từng thẻ chữ rời với các chữ trên thẻ từ gồm 5 chữ","Khi đưa HS thẻ từ \"TÀU\", HS sẽ ghép từng thẻ chữ T, À, U với các chữ trên thẻ từ TÀU",-1,[["2","có thể ghép từng chữ ứng với các chữ trong từ có 5 chữ khi đưa cả những thẻ chữ không dùng đến (td: thẻ từ TÀU, đưa thẻ chữ T, À, U, và E, I)"],["1","có thể ghép từng chữ ứng với các chữ trong từ có 3 chữ khi không đưa thừa thẻ chữ nào cả (td: thẻ từ BÁT, đưa thẻ chữ B, À, T, và E, I)"]]],["T2",4,18,"Điền chữ còn thiếu để hoàn chỉnh từ","Khi được đưa tranh vẽ một vật và 2 trong số 3 chữ làm nên từ tả vật đó, học sinh sẽ thêm chữ còn thiếu vào để hoàn chỉnh từ 3 chữ đó","Khi được đưa tranh vẽ cái bàn cùng với thẻ chữ B, N, học sinh sẽ lấy thêm thẻ chữ À (trong số những thẻ chữ À, O, I, U) để xếp thành chữ BÀN",-1,[["2","có thể điền chữ thiếu ở bất cứ vị trí nào trong từ với ít nhất 10 từ"],["1","có thể điền chữ thiếu ở bất cứ vị trí nào trong từ với ít nhất 5 từ"]]],["T3",4,18,"Chép chữ","Học sinh sẽ có thể viết tay hoặc đánh máy lại chữ có 6 từ","",-1,[["2","có thể viết tay hoặc đánh máy lại chính các từ 6 chữ cả hoa và thường, đúng hàng và khoảng cách"],["1","có thể viết lại từ 3 chữ"]]],["T4",4,18,"Viết chữ còn thiếu để hoàn chỉnh từ","Khi được đưa tranh vẽ một vật và 2 trong số 3 chữ làm nên từ tả vật đó, học sinh sẽ viết thêm chữ còn thiếu vào để hoàn chỉnh từ 3 chữ đó","Khi đưa tranh con mèo và thẻ từ viết M O, học sinh sẽ viết thêm chữ È vào để thành từ MÈO",-1,[["2","có thể viết thêm chữ thiếu ở bất cứ vị trí nào trong từ với ít nhất 10 từ"],["1","có thể viết thêm chữ thiếu ở bất cứ vị trí nào trong từ với ít nhất 5 từ"]]],["T5",4,18,"Đánh vần bằng miệng","Học sinh sẽ có thể đánh vần bằng miệng","",-1,[["4","25 từ"],["3","10 từ"],["2","5 từ"],["1","2 từ"]]],["T6",4,18,"Đánh vần bằng cách viết","Học sinh sẽ có thể đánh vần bằng cách viết ra hoặc đánh máy","",-1,[["4","25 từ"],["3","10 từ"],["2","5 từ"],["1","2 từ"]]],["T7",4,18,"Đánh vần tên của chính mình","Học sinh có thể đánh vần tên của mình bằng miệng và bằng cách viết/đánh máy","",-1,[["2","đánh vần bằng miệng và cả viết/đánh máy"],["1","đánh vần bằng miệng, hoặc viết/đánh máy"]]],["U1",7,19,"Kéo quần lên và xuống","Học sinh sẽ có thể tự kéo quần lên và xuống khi đi vệ sinh","",-1,[["2","có thể kéo lên hoặc xuống"],["1","có thể kéo quần lên và xuống"]]],["U2",7,19,"Đi giày vào và cởi giầy ra","Học sinh có thể đi giày vào (không cần buộc dây) và tự cởi ra","",-1,[["2","có thể cởi ra và đi vào (không cần buộc dây)"],["1","có thể hoặc cởi ra hoặc đi vào"]]],["U3",7,19,"Mặc và cởi áo chui đầu","Học sinh có thể tự mặc và cởi áo chui đầu không cần giúp đỡ","",-1,[["2","có thể cởi và mặc áo chui đầu đúng cách"],["1","có thể mặc hoặc cởi áo chui đầu"]]],["U4",7,19,"Mặc và cởi áo sơ mi loại cài khuy","Học sinh có thể mặc và cởi áo sơ mi loại cài khuy (không cần cài khuy) mà không cần giúp đỡ","",-1,[["2","có thể tự mặc và cởi áo sơ mi loại cài khuy (không cần cài khuy)"],["1","có thể mặc hoặc cởi áo sơ mi loại cài khuy"]]],["U5",7,19,"Mặc và cởi quần","Học sinh có thể tự mặc và cởi quần (không cần cài khuy, khuy bấm và kéo phéc mơ tuya)","",-1,[["2","có thể tự mặc và cởi quần (không cần cài khuy, khuy bấm hay kéo phéc mơ tuya)"],["1","có thể tự mặc hoặc cởi quần"]]],["U6",7,19,"Đi vào và cởi tất ra","Học sinh có thể tự đi vào và cởi tất ra","",-1,[["2","có thể tự đi vào và cởi tất ra"],["1","có thể tự đi vào hoặc cởi tất ra"]]],["U7",7,19,"Mặc và cởi áo khoác","Học sinh có thể tự mặc (không cần cài khuy, khuy bấm và cởi phéc mơ tuya) và cởi áo khoác (có cởi khuy hoặc khuy bấm, cởi phéc mơ tuya)","",-1,[["2","có thể tự cởi (kể cả việc cởi khuy, khuya bấm và phéc mơ tuya) và mặc áo khoác vào (không cần cài khuy, khuy bấm và kéo phéc mơ tuya)"],["1","có thể cởi hoặc mặc áo khoác vào"]]],["U8",7,19,"Mở phéc mơ tuya","Học sinh sẽ có thể mở phéc mơ tuya ở quần áo, ba lô và một số thứ tương tự mà không cần giúp đỡ","",-1,[["2","có thể tự mở phéc mơ tuya ở quần áo, balô hoặc các vật tương tự"],["1","có thể tự mở và kéo phéc mơ tuya ở balô hay vật tương tự khi được nhắc bằng lời hoặc hành động"]]],["U9",7,19,"Kéo phéc mơ tuya","Học sinh sẽ có thể tự kéo phéc mơ tuya ở balô hoặc các vật tương tự","",-1,[["2","biết tự cài và cởi phéc mơ tuya ở balô hoặc các vật tương tự"],["1","biết cài phéc mơ tuya ở quần áo, balô hoặc các vật tương tự khi được nhắc bằng lời hoặc hành động"]]],["U10",7,19,"Sử dụng phéc mơ tuya ở quần áo","HS biết tự cài và kéo phéc mơ tuya ở quần áo","",-1,[["2","tự cài, kéo và mở phéc mơ tuya ở quần áo"],["1","kéo phéc mơ tuya ở quần áo"]]],["U11",7,19,"Cài khuy","Học sinh biết tự cài khuy ở quần áo","",-1,[["4","có thể cài khuy ở áo sơ-mi"],["3","có thể cài khuy to không phải ở quần áo"],["2","mở khuy nhỏ ở áo"],["1","mở khuy to không phải ở quần áo"]]],["U12",7,19,"Dùng khuy bấm","Học sinh sẽ cởi và cài khuy bấm ở quần áo","",-1,[["2","có thể cởi và cài khuy bấm ở quần áo"],["1","có thể cởi và cài khuy bấm không phải ở quần áo"]]],["U13",7,19,"Cài khóa dây thắt lưng","Học sinh có thể tự tháo và cài khóa dây thắt lưng","",-1,[["2","có thể tự tháo và cài khóa dây thắt lưng ở quần áo"],["1","có thể tự tháo và cài khóa dây thắt lưng không phải ở quần áo"]]],["U14",7,19,"Chỉnh sửa quần áo khi cần","Học sinh sẽ biết chỉnh sửa quần áo khi cần","",-1,[["2","có thể chỉnh sửa mà không cần nhắc"],["1","tự chỉnh sửa khi được nhắc"]]],["U15",7,19,"Buộc dây giày","Học sinh biết tự buộc dây giày","",-1,[["2","tự buộc không cần giúp"],["1","có thể làm ít nhất 1 khâu trong khi buộc dây giày"]]],["V1",7,20,"Ăn bằng ngón tay","Học sinh có thể dùng ngón tay để ăn","",-1,[["2","một cách độc lập"],["1","chỉ khi nào có nhắc bằng cử chỉ hay lời nói"]]],["V2",7,20,"Hút nước bằng ống","Học sinh có thể uống bằng ống hút","",-1,[["2","một cách độc lập"],["1","chỉ khi nào có nhắc bằng cử chỉ hay lời nói"]]],["V3",7,20,"Uống từ cốc","Học sinh sẽ có thể uống từ cốc mà không đổ ra ngoài","",-1,[["2","1 cách độc lập"],["1","chỉ khi nào có nhắc bằng cử chỉ hay lời nói"]]],["V4",7,20,"Dùng thìa và dĩa","Học sinh có thể dùng thìa và dĩa khi được đưa thức ăn đã cắt nhỏ","",-1,[["2","một cách độc lập"],["1","thực hiện với lời nhắc hoặc cử chỉ gợi ý"]]],["V5",7,20,"Dùng dao phết đồ ăn","Học sinh dùng dao phết đồ ăn","",-1,[["2","một cách độc lập"],["1","thực hiện với lời nhắc hoặc cử chỉ gợi ý"]]],["V6",7,20,"Rót nước vào cốc","Học sinh biết rót nước từ bình lớn vào cốc mà không đổ ra ngoài","",-1,[["2","một cách độc lập"],["1","thực hiện với lời nhắc hoặc cử chỉ gợi ý"]]],["V7",7,20,"Cắt thức ăn bằng dao","Học sinh sẽ có thể tự cắt thức ăn bằng dao","",-1,[["2","một cách độc lập"],["1","thực hiện với lời nhắc hoặc cử chỉ gợi ý"]]],["V8",7,20,"Dọn thức ăn đã chuẩn bị ra bàn","Học sinh sẽ có thể dọn thức ăn ra bàn mà không cần nhờ giúp hay nhắc nhở","",-1,[["2","một cách độc lập"],["1","thực hiện với lời nhắc hoặc cử chỉ gợi ý"]]],["V9",7,20,"Dọn bàn sau khi ăn","Học sinh sẽ dọn bàn sau khi ăn","",-1,[["2","một cách độc lập"],["1","thực hiện với lời nhắc hoặc cử chỉ gợi ý"]]],["V10",7,20,"Giữ khu vực ăn uống sạch sẽ","Học sinh sẽ giữ khu vực ăn uống sạch sẽ trong khi ăn","",-1,[["2","một cách độc lập"],["1","thực hiện với lời nhắc hoặc cử chỉ gợi ý"]]],["W1",7,21,"Rửa tay","Học sinh có thể rửa tay mà không cần giúp đỡ","",-1,[["2","một cách độc lập"],["1","chỉ khi nào có nhắc bằng cử chỉ hay lời nói"]]],["W2",7,21,"Lau khô tay","Học sinh có thể lau khô tay mà không cần giúp đỡ","",-1,[["2","một cách độc lập"],["1","chỉ khi nào có nhắc bằng cử chỉ hay lời nói"]]],["W3",7,21,"Rửa mặt","Học sinh có thể rửa mặt mà không cần giúp đỡ","",-1,[["2","một cách độc lập"],["1","chỉ khi nào có nhắc bằng cử chỉ hay lời nói"]]],["W4",7,21,"Lau khô mặt","Học sinh sẽ có thể tự lau khô mặt mà không cần giúp đỡ","",-1,[["2","một cách độc lập"],["1","chỉ khi nào có nhắc bằng cử chỉ hay lời nói"]]],["W5",7,21,"Chải đầu bằng lược hay bàn chải tóc","Học sinh sẽ có thể chải đầu bằng lược hay bàn chải tóc mà không cần giúp đỡ","",-1,[["2","một cách độc lập"],["1","chỉ khi nào có nhắc bằng cử chỉ hay lời nói"]]],["W6",7,21,"Đánh răng","Học sinh sẽ có thể tự đánh răng có thuốc","",-1,[["2","một cách độc lập"],["1","chỉ khi nào có nhắc bằng cử chỉ hay lời nói"]]],["W7",7,21,"Xì mũi khi cần","Học sinh sẽ có thể tự xì mũi khi cần","",-1,[["2","một cách độc lập"],["1","chỉ khi nào có nhắc bằng cử chỉ hay lời nói"]]],["Y1",6,22,"Đi đúng tư thế","Học sinh đi đúng tư thế","",-1,[["1","có"],["0","không"]]],["Y2",6,22,"Quỳ gối","Học sinh sẽ có thể quỳ gối và tự đứng lên","",-1,[["1","có"],["0","không"]]],["Y3",6,22,"Chạy bình thường","Học sinh có thể chạy bình thường","",-1,[["1","có"],["0","không"]]],["Y4",6,22,"Lăn qua 2 bên","Học sinh sẽ có thể lăn qua 2 bên","",-1,[["1","có"],["0","không"]]],["Y5",6,22,"Nhảy tới","Học sinh sẽ có thể nhảy tới bằng 2 chân","",-1,[["1","có"],["0","không"]]],["Y6",6,22,"Nhảy xuống","Học sinh sẽ có thể nhảy xuống từ một vật (cao khoảng 1m)","",-1,[["1","có"],["0","không"]]],["Y7",6,22,"Đi giật lùi","Học sinh có thể đi giật lùi","",-1,[["1","có"],["0","không"]]],["Y8",6,22,"Bật nhảy trên 2 chân","Học sinh sẽ có thể bật nhảy trên 2 chân","",-1,[["1","có"],["0","không"]]],["Y9",6,22,"Tung bóng từ ngực hay tay","Học sinh có thể tung một quả bóng đường kính khoảng 20cm từ ngực hay tay cho một người khác đứng cách 1,2m","",-1,[["1","có"],["0","không"]]],["Y10",6,22,"Lăn bóng","Học sinh sẽ có thể lăn bóng cho 1 người cách mình khoảng 2m","",-1,[["1","có"],["0","không"]]],["Y11",6,22,"Trèo thang phối hợp đều chân tay","Học sinh có thể trèo thang phối hợp đều chân tay","",-1,[["1","có"],["0","không"]]],["Y12",6,22,"Bò sấp","Học sinh sẽ có thể bò sấp được ít nhất 3m","",-1,[["1","có"],["0","không"]]],["Y13",6,22,"Ngồi xổm","Học sinh có thể ngồi xổm và đứng lên","Gập đầu gối để ngồi xổm và trở lại tư thế đứng",-1,[["1","có"],